---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = 'SPOT — Your Place on the Internet',
  description = 'A persistent 10,000-tile cyber canvas where everyone gets their own spot and retro 8-bit avatar. Free to join.',
  image = 'https://www.claimyourspot.lol/og-image.png',
  url = 'https://www.claimyourspot.lol/',
} = Astro.props;

const siteName = 'SPOT';
const author = 'Md. Fazley Rabbi';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#090b10" />
    <link rel="canonical" href={url} />

    <!-- Typography: High-performance preconnect & font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta property="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta property="twitter:image" content={image} />
    <meta name="twitter:creator" content="@fazleyrabby" />
    <meta name="twitter:site" content="@fazleyrabby" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R7ZVE6FQJ3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R7ZVE6FQJ3');
    </script>

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "SPOT",
          "url": "https://www.claimyourspot.lol/",
          "description": description,
          "inLanguage": "en"
        },
        {
          "@type": "WebApplication",
          "name": "SPOT",
          "url": "https://www.claimyourspot.lol/",
          "description": description,
          "applicationCategory": "InternetApplication",
          "operatingSystem": "All",
          "author": { "@type": "Person", "name": "Md. Fazley Rabbi", "url": "https://fazleyrabbi.xyz/" },
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
        },
        {
          "@type": "Organization",
          "name": "SPOT",
          "url": "https://www.claimyourspot.lol/",
          "logo": "https://www.claimyourspot.lol/logo.png"
        }
      ]
    })} />

    <!-- Canvas 2D roundRect polyfill (Safari < 16 / older WebKit lack it) -->
    <script is:inline>
      (function () {
        if (typeof CanvasRenderingContext2D === 'undefined') return;
        var proto = CanvasRenderingContext2D.prototype;
        if (typeof proto.roundRect === 'function') return;

        function radiusOf(v, max) {
          var r = Array.isArray(v) ? Number(v[0]) : Number(v);
          if (!isFinite(r) || r < 0) r = 0;
          return Math.min(r, max);
        }

        proto.roundRect = function (x, y, w, h, radii) {
          var max = Math.min(Math.abs(w), Math.abs(h)) / 2;
          var r = radiusOf(radii, max);
          if (w < 0 || h < 0) { x += w; w = -w; y += h; h = -h; }
          this.moveTo(x + r, y);
          this.lineTo(x + w - r, y);
          if (r > 0) this.arcTo(x + w, y, x + w, y + r, r);
          this.lineTo(x + w, y + h - r);
          if (r > 0) this.arcTo(x + w, y + h, x + w - r, y + h, r);
          this.lineTo(x + r, y + h);
          if (r > 0) this.arcTo(x, y + h, x, y + h - r, r);
          this.lineTo(x, y + r);
          if (r > 0) this.arcTo(x, y, x + r, y, r);
          this.closePath();
          return this;
        };
      })();
    </script>

    <!-- Auto-recovery from stale deployment asset hashes & bfcache drops -->
    <script is:inline>
      // 1. If any stylesheet fails to load (e.g. 404 during live deployment rollout)
      window.addEventListener('error', function (e) {
        var t = e && e.target;
        if (t && t.tagName === 'LINK' && t.rel === 'stylesheet') {
          var retryKey = 'spot_css_heal_' + location.pathname;
          var lastRetry = sessionStorage.getItem(retryKey);
          if (!lastRetry || Date.now() - parseInt(lastRetry, 10) > 10000) {
            sessionStorage.setItem(retryKey, Date.now().toString());
            window.location.reload();
          }
        }
      }, true);

      // 2. If restored from browser Back-Forward Cache (bfcache)
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) {
          var sheets = document.querySelectorAll('link[rel="stylesheet"]');
          var missing = false;
          sheets.forEach(function (sheet) {
            try {
              if (!sheet.sheet || sheet.sheet.cssRules.length === 0) {
                missing = true;
              }
            } catch (_) {}
          });
          if (missing) {
            window.location.reload();
          }
        }
      });

      // 3. Global Uncaught Error & Promise Rejection Monitor -> Relays to /api/logs/client-error -> Grafana Loki
      (function() {
        var reportedCount = 0;
        var MAX_REPORTS = 5;
        var reportedSignatures = new Set();

        function relayClientError(payload) {
          if (reportedCount >= MAX_REPORTS) return;
          var sig = (payload.message || '') + ':' + (payload.lineno || 0) + ':' + (payload.source || '');
          if (reportedSignatures.has(sig)) return;
          reportedSignatures.add(sig);
          reportedCount++;

          try {
            var endpoint = '/api/logs/client-error';
            var body = JSON.stringify({
              message: String(payload.message || 'Unknown error'),
              source: String(payload.source || window.location.pathname),
              lineno: payload.lineno,
              colno: payload.colno,
              stack: payload.stack ? String(payload.stack) : undefined,
              url: window.location.href,
              userAgent: navigator.userAgent,
            });

            if (navigator.sendBeacon) {
              var blob = new Blob([body], { type: 'application/json' });
              navigator.sendBeacon(endpoint, blob);
            } else {
              fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body,
                keepalive: true,
              }).catch(function() {});
            }
          } catch (_) {}
        }

        window.addEventListener('error', function(e) {
          if (!e) return;
          var msg = e.message || (e.error && e.error.message) || String(e);
          if (typeof msg === 'string' && (
            msg.indexOf('ResizeObserver') !== -1 ||
            msg.indexOf('chrome-extension://') !== -1 ||
            msg.indexOf('moz-extension://') !== -1 ||
            // In-app browser bridges (Facebook/Instagram/other WebViews) whose
            // native side is already gone — not our code, cannot be fixed by us.
            msg.indexOf('Java object is gone') !== -1 ||
            msg.indexOf('Error invoking postMessage') !== -1 ||
            msg.indexOf('iabjs://') !== -1
          )) return;

          relayClientError({
            message: msg,
            source: e.filename || window.location.pathname,
            lineno: e.lineno,
            colno: e.colno,
            stack: e.error ? e.error.stack : undefined,
          });
        });

        window.addEventListener('unhandledrejection', function(e) {
          if (!e) return;
          var reason = e.reason;
          var msg = reason ? (reason.message || String(reason)) : 'Unhandled Promise Rejection';
          var stack = reason && reason.stack ? reason.stack : undefined;
          if (typeof msg === 'string' && (
            msg.indexOf('ResizeObserver') !== -1 ||
            msg.indexOf('chrome-extension://') !== -1 ||
            msg.indexOf('moz-extension://') !== -1 ||
            msg.indexOf('Java object is gone') !== -1 ||
            msg.indexOf('Error invoking postMessage') !== -1 ||
            msg.indexOf('iabjs://') !== -1
          )) return;

          relayClientError({
            message: 'Unhandled Promise: ' + msg,
            source: window.location.pathname,
            stack: stack,
          });
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
