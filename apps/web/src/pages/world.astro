      subtext,
      brandName: sponsorName,
      targetUrl: destUrl,
      bannerImageUrl: bannerImage,
    });

    if (!policyCheck.isValid) {
      showToast(`🚫 Policy Violation: ${policyCheck.reason}`, 'error');
