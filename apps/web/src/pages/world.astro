  // ── NPC Dialogue Modal Wiring ─────────────────────────────────────────────
  const npcBackdrop = document.getElementById('npc-modal-backdrop');
  const npcCloseBtn = document.getElementById('npc-modal-close');
  const npcDismissBtn = document.getElementById('npc-dismiss-btn');
  const npcActionBtn = document.getElementById('npc-action-btn');
