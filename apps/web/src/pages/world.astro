    // Reset or initialize customizer values
    if (bannerInputHeadline) bannerInputHeadline.value = '';
    if (bannerInputSubtext) bannerInputSubtext.value = '';
    if (bannerInputUrl) bannerInputUrl.value = '';
    if (bannerInputImage) bannerInputImage.value = '';
    if (bannerInputName) bannerInputName.value = '';
