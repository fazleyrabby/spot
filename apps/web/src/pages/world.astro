  function formatTimeLeft(expiresAt: string | undefined): { text: string; isUrgent: boolean } | null {
    if (!expiresAt) return null;
    const diffMs = new Date(expiresAt).getTime() - Date.now();
    if (diffMs <= 0) return { text: 'Expired', isUrgent: true };

    const totalSeconds = Math.floor(diffMs / 1000);
    const seconds = totalSeconds % 60;
    const minutes = Math.floor(totalSeconds / 60) % 60;
    const hours = Math.floor(totalSeconds / 3600) % 24;
    const days = Math.floor(totalSeconds / 86400);

    let text = '';
    if (days > 0) {
      text = `${days}d ${hours}h ${minutes}m left`;
    } else if (hours > 0) {
      text = `${hours}h ${minutes}m ${seconds}s left`;
    } else {
      text = `${minutes}m ${seconds}s left`;
    }

    return { text, isUrgent: days < 3 };
  }

  function updateExpiryDisplay(): void {
    if (!currentBanner || !currentBanner.isSponsored || !currentBanner.expiresAt) {
      if (bannerExpiryWrap) bannerExpiryWrap.style.display = 'none';
      return;
    }

    const info = formatTimeLeft(currentBanner.expiresAt);
    if (!info) {
      if (bannerExpiryWrap) bannerExpiryWrap.style.display = 'none';
      return;
    }

    if (bannerExpiryWrap && bannerExpiryText) {
      bannerExpiryText.textContent = info.text;
      bannerExpiryWrap.style.display = 'inline-flex';
      if (info.isUrgent) {
        bannerExpiryWrap.classList.add('urgent');
      } else {
        bannerExpiryWrap.classList.remove('urgent');
      }
    }
  }

  function openBannerModal(banner: import('../world/banner-manager.js').WorldBanner): void {
