    // Attach citizen ID if user is a logged-in citizen
    try {
      const savedCitizenStr = localStorage.getItem('spot_my_citizen');
      if (savedCitizenStr) {
        const cData = JSON.parse(savedCitizenStr);
        if (cData?.id) {
          params.set('custom_fields[Citizen ID]', cData.id);
