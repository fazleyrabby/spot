      headline = headline || sponsorName.toUpperCase();
      subtext = subtext || 'Featured Project / Brand';
    }

    // Support test mode: automatically apply TESTDEV discount code on localhost or if ?test=true or ?promo=testdev is in URL
    const isTestMode =
      window.location.hostname === 'localhost' ||
      window.location.hostname === '127.0.0.1' ||
      new URLSearchParams(window.location.search).get('test') === 'true' ||
      new URLSearchParams(window.location.search).get('promo') === 'testdev';
    const discountPath = isTestMode ? '/TESTDEV' : '';

    // Route each tier to its dedicated Gumroad product
    let productSlug = 'spot-billboard-scenic';
    let tierName = 'Scenic & Transit Landmarks ($10)';

    if (currentBanner.district.includes('Grand Central') || currentBanner.id === 'banner_boardwalk_pier') {
      productSlug = 'spot-billboard-plaza';
      tierName = 'Grand Central Plaza Gateways ($35)';
    } else if (currentBanner.district.includes('Downtown')) {
      productSlug = 'spot-billboard-downtown';
      tierName = 'Downtown Cyber District ($20)';
    }

    const gumroadBase = `https://fazleyrabbiii.gumroad.com/l/${productSlug}${discountPath}`;

    const params = new URLSearchParams({
      billboard_id: currentBanner.id,
      billboard_name: currentBanner.name,
      tier: tierName,
      'custom_fields[Headline]': headline,
      'custom_fields[Subtext]': subtext,
      'custom_fields[Destination URL]': destUrl,
      'custom_fields[Brand / Sponsor Name]': sponsorName,
      'custom_fields[Logo / Brand Color Hex]': selectedAccentColor,
    });

    if (bannerImage) {
      params.set('custom_fields[Banner Image URL]', bannerImage);
