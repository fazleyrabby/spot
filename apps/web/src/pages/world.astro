  const npcIcon = document.getElementById('npc-icon');
  const npcDistrict = document.getElementById('npc-district');
  const npcName = document.getElementById('npc-name');
  const npcTitle = document.getElementById('npc-title');
  const npcDialogue = document.getElementById('npc-dialogue');
  const npcEffectBadge = document.getElementById('npc-effect-badge');
  const npcEffectText = document.getElementById('npc-effect-text');
