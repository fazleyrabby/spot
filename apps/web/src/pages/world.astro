  // ── Engine ────────────────────────────────────────────────────────────────
  let engine: InstanceType<typeof Engine> | null = null;

  async function boot() {
    loaderSub.textContent = 'Sprouting sector…';
    updateSecretsHUD();

    try {
      let avatarId = 'astronaut';
      let citizenId = '';
      let displayName = 'Visitor';
      let isVerified = false;

      // 1. Instant local storage cache check (<0.5ms)
      try {
        const cachedCitizen = localStorage.getItem('spot_my_citizen');
        if (cachedCitizen) {
          const parsed = JSON.parse(cachedCitizen);
          if (parsed?.id) citizenId = parsed.id;
          if (parsed?.displayName) displayName = parsed.displayName;
          if (parsed?.avatarId) avatarId = parsed.avatarId;
          if (parsed?.isVerified) isVerified = parsed.isVerified;
        }
      } catch (_) {}

      // 2. Synchronize active session so logged-in citizens never appear as Visitor
      try {
        let sessionCitizen: any = null;
        if (supabase) {
          const { data: { session: sbSession } } = await supabase.auth.getSession();
          if (sbSession?.user) {
            const metadata = sbSession.user.user_metadata || {};
            const syncRes = await syncGithubAuth({
              githubId: sbSession.user.id,
              username: metadata.user_name || metadata.preferred_username || metadata.name,
              email: sbSession.user.email,
              avatarUrl: metadata.avatar_url,
              displayName: metadata.full_name || metadata.name || metadata.user_name,
            });
            if (syncRes?.citizen) {
              sessionCitizen = syncRes.citizen;
            }
          }
        }

        if (!sessionCitizen) {
          const session = await fetchMySession();
          if (session?.citizen) {
            sessionCitizen = session.citizen;
          }
        }

        if (sessionCitizen) {
          citizenId = sessionCitizen.id || citizenId;
          displayName = sessionCitizen.displayName || displayName;
          avatarId = sessionCitizen.avatarId || avatarId;
          isVerified = sessionCitizen.isVerified ?? isVerified;

          // Cache for instant 0ms restoration on future page visits
          localStorage.setItem('spot_my_citizen', JSON.stringify({
            id: citizenId,
            displayName,
            avatarId,
            isVerified,
          }));
        }

        // Record visitor analytics hit
        recordVisit();
      } catch (_) {}

      // ── Start Engine with Authenticated Citizen Identity ─────────────────
      engine = new Engine({
        canvas,
        apiBase: API_BASE,
        citizenId,
        avatarId,
        displayName,
        isVerified,
        onCitizenClick: (spot) => openProfileModal(spot),
        onSecretClick: (secret) => openSecretModal(secret),
        onSecretDiscovered: (secret) => openSecretModal(secret),
        onBannerClick: (banner) => openBannerModal(banner),
        onNpcInteract: (npc) => openNpcModal(npc),
        onEmptyClick: (_gx, _gy) => {
          closeProfileModal();
          closeSecretModal();
          closeBannerModal();
          closeNpcModal();
          closeJournalModal();
        },
      });

      // ── Fetch Dynamic Billboard Sponsorships ──────────────────────────────
      async function syncActiveBanners() {
        try {
          const billboardRes = await fetch(`${API_BASE}/api/billboards/active`);
          if (billboardRes.ok) {
            const billboardData = await billboardRes.json();
            if (billboardData?.activeBanners) {
              applyActiveSponsorships(billboardData.activeBanners);
            }
          }
        } catch (_) {}
      }

      // Check any recent pending ads configured on this device (within 30 mins)
      for (const b of WORLD_BANNERS) {
        try {
          const stored = localStorage.getItem('spot_pending_ad_' + b.id);
          if (stored) {
            const item = JSON.parse(stored);
            if (Date.now() - (item.timestamp || 0) < 30 * 60 * 1000) {
              applyActiveSponsorships([item]);
            }
          }
        } catch (_) {}
      }

      // Initial server sync
      await syncActiveBanners();

      loaderSub.textContent = 'Rendering Island…';
      await engine.init();

      // Ensure webhook delivery is caught with quick follow-up polls
      setTimeout(syncActiveBanners, 1200);
      setTimeout(syncActiveBanners, 3000);

      // ── Returning Sponsor Handling (Gumroad Redirect) ─────────────────────
      const queryParams = new URLSearchParams(window.location.search);
      const targetBillboardId = queryParams.get('billboard_id') || queryParams.get('billboard');
      if (targetBillboardId) {
        const targetBanner = WORLD_BANNERS.find((b) => b.id === targetBillboardId);
        if (targetBanner) {
          setTimeout(() => {
            if (!engine) return;
            const targetWx = targetBanner.gx * 16 + 8;
            const targetWy = targetBanner.gy * 16 + 8;
            engine.camera.centerOn(targetWx, targetWy, 1.4);
            showToast('🎉 Congratulations! Your cyber billboard is LIVE in Spot World!', 'success');
            setTimeout(() => {
              openBannerModal(targetBanner);
            }, 600);
          }, 700);
        }
      }

      // Sync initial HUD audio icon
      if (worldAudioIcon) {
        worldAudioIcon.textContent = engine.audio.muted ? '🔇' : '🔊';
      }

      // ── Chat & Emote Dock Wiring ──────────────────────────────────────────
      const chatForm = document.getElementById('world-chat-form') as HTMLFormElement | null;
      const chatInput = document.getElementById('world-chat-input') as HTMLInputElement | null;
      const emoteBtns = document.querySelectorAll('.emote-btn');

      emoteBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const emote = (btn as HTMLElement).dataset.emote;
          if (emote && engine) {
            engine.player.say(emote, 240);
          }
        });
      });

      chatForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!chatInput || !engine) return;
        const msg = chatInput.value.trim();
        if (!msg) return;

        if (containsBlockedWord(msg)) {
          showToast('Please keep chat messages kind & friendly! 🌸', 'error');
          return;
        }

        engine.player.say(msg, 360);
        chatInput.value = '';
        chatInput.blur();
      });

      // Emote numeric hotkeys (1-6) and Enter to focus chat
      window.addEventListener('keydown', (e) => {
        if (['input', 'textarea'].includes((e.target as HTMLElement)?.tagName?.toLowerCase())) {
          return;
        }

        const key = e.key;
        const emoteMap: Record<string, string> = {
          '1': '👋',
          '2': '☕',
          '3': '✨',
          '4': '❤️',
          '5': '🚀',
          '6': '🎮',
        };

        if (emoteMap[key] && engine) {
          engine.player.say(emoteMap[key], 240);
        } else if (key === 't' || key === '/') {
          e.preventDefault();
          chatInput?.focus();
        }
      });

      // ── Search Modal Wiring (Uses identical SearchModal.astro component) ─
      const searchBackdrop = document.getElementById('search-modal-backdrop');
      const searchCloseBtn = document.querySelector('.search-kbd') || document.getElementById('search-modal-close');
      const searchInput = (document.getElementById('search-input') || document.getElementById('citizen-search-input')) as HTMLInputElement | null;
      const searchStatus = document.getElementById('search-status');
      const searchResultsList = document.getElementById('search-results-list');
      const btnWorldSearch = document.getElementById('world-search-btn');

      let searchDebounceTimer: number | undefined;

      function openSearchModal(): void {
        if (!searchBackdrop) return;
        closeSecretModal();
        closeProfileModal();
        searchBackdrop.classList.add('open');
        searchBackdrop.setAttribute('aria-hidden', 'false');
        searchInput?.focus();
        if (searchInput && searchInput.value) {
          triggerSearch(searchInput.value);
        } else {
          if (searchResultsList) searchResultsList.innerHTML = '';
          if (searchStatus) {
            searchStatus.style.display = 'block';
            searchStatus.textContent = 'Type to search across citizens and spots...';
          }
        }
      }

      function closeSearchModal(): void {
        if (!searchBackdrop) return;
        searchBackdrop.classList.remove('open');
        searchBackdrop.setAttribute('aria-hidden', 'true');
      }

      btnWorldSearch?.addEventListener('click', (e) => {
        e.stopPropagation();
        openSearchModal();
      });

      searchCloseBtn?.addEventListener('click', closeSearchModal);
      searchBackdrop?.addEventListener('click', (e) => {
        if (e.target === searchBackdrop) closeSearchModal();
      });

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (searchBackdrop?.classList.contains('open')) {
            closeSearchModal();
          } else {
            openSearchModal();
          }
        }
        if (e.key === 'Escape' && searchBackdrop?.classList.contains('open')) {
          closeSearchModal();
        }
      });

      async function triggerSearch(rawQuery: string): Promise<void> {
        const q = rawQuery.trim();
        if (!q) {
          if (searchResultsList) searchResultsList.innerHTML = '';
          if (searchStatus) {
            searchStatus.style.display = 'block';
            searchStatus.textContent = 'Type to search across citizens and spots...';
          }
          return;
        }

        if (searchStatus) {
          searchStatus.style.display = 'block';
          searchStatus.textContent = 'Searching...';
        }

        if (searchDebounceTimer) window.clearTimeout(searchDebounceTimer);
        searchDebounceTimer = window.setTimeout(async () => {
          if (!searchResultsList || !searchStatus || !engine) return;

          // 1. Fetch search results from database/API
          let results = await searchCitizens(q).catch(() => []);

          // 2. Also check local live entities in the engine
          if (results.length === 0) {
            const allPlots = engine.plots.getAllPlots();
            const lower = q.toLowerCase();
            const localMatches = allPlots
              .filter((p) => {
                const name = p.owner.displayName?.toLowerCase() || '';
                const tag = p.owner.tagline?.toLowerCase() || '';
                const coords = `${p.owner.x},${p.owner.y}`;
                return name.includes(lower) || tag.includes(lower) || coords.includes(lower);
              })
              .map((p) => ({
                id: p.owner.spotId,
                x: p.owner.x,
                y: p.owner.y,
                avatarId: p.owner.avatarId,
                displayName: p.owner.displayName,
                tagline: p.owner.tagline,
                isVerified: p.owner.isVerified,
                githubUrl: p.owner.githubUrl,
              }));
            results = localMatches as any;
          }

          searchResultsList.innerHTML = '';

          if (results.length === 0) {
            searchStatus.style.display = 'block';
            searchStatus.textContent = `No citizens or spots found matching "${q}"`;
          } else {
            searchStatus.style.display = 'none';

            results.forEach((item: any) => {
              const row = document.createElement('div');
              row.className = 'search-result-item';

              const avatarCanvas = document.createElement('canvas');
              avatarCanvas.width = 32;
              avatarCanvas.height = 32;
              avatarCanvas.className = 'search-result-avatar';
              const actx = avatarCanvas.getContext('2d');
              if (actx) {
                const def = AVATAR_CATALOG[item.avatarId] ?? AVATAR_CATALOG.astronaut;
                if (item.customAvatarData) {
                  drawCustomAvatarOnCanvas(actx, item.customAvatarData, 0, 0, 32);
                } else {
                  drawAvatarOnCanvas(actx, def, 0, 0, 32);
                }
              }

              const left = document.createElement('div');
              left.className = 'search-result-left';
              left.appendChild(avatarCanvas);

              const meta = document.createElement('div');
              meta.className = 'search-result-meta';

              const nameSpan = document.createElement('div');
              nameSpan.className = 'search-result-name';
              nameSpan.textContent = item.displayName;

              if (item.isVerified || item.githubUrl) {
                const badge = document.createElement('span');
                badge.style.color = '#38bdf8';
                badge.style.fontSize = '0.78rem';
                badge.textContent = ' ✓';
                nameSpan.appendChild(badge);
              }

              const taglineSpan = document.createElement('div');
              taglineSpan.className = 'search-result-tagline';
              taglineSpan.textContent = item.tagline || (item.githubUrl ? `@${item.githubUrl}` : 'Citizen of Spot World');

              meta.append(nameSpan, taglineSpan);
              left.appendChild(meta);

              const spotBadge = document.createElement('div');
              spotBadge.className = 'search-result-spot';
              spotBadge.textContent = `(${item.x}, ${item.y})`;

              row.append(left, spotBadge);

              // Click to Jump to Citizen & Inspect
              row.addEventListener('click', (e) => {
                e.stopPropagation();
                const gx = Number(item.x);
                const gy = Number(item.y);
                if (isNaN(gx) || isNaN(gy)) return;

                closeSearchModal();

                if (engine) {
                  engine.flyTo(gx, gy, 1.4);
                  engine.renderer.gpsTarget = {
                    name: item.displayName,
                    wx: gx * 48 + 24,
                    wy: gy * 32 + 16,
                  };
                }

                const targetSpot: OccupiedSpotSummary = (engine ? engine.plots.getSpotAt(gx, gy) : null) || {
                  spotId: item.spotId || item.id || `${gx},${gy}`,
                  x: gx,
                  y: gy,
                  citizenId: item.id || item.citizenId || '',
                  displayName: item.displayName,
                  tagline: item.tagline,
                  avatarId: item.avatarId || 'astronaut',
                  customAvatarData: item.customAvatarData,
                  websiteUrl: item.websiteUrl,
                  twitterUrl: item.twitterUrl || item.twitterHandle,
                  facebookUrl: item.facebookUrl || item.facebookHandle,
                  instagramUrl: item.instagramUrl || item.instagramHandle,
                  linkedinUrl: item.linkedinUrl || item.linkedinHandle,
                  youtubeUrl: item.youtubeUrl || item.youtubeHandle,
                  githubUrl: item.githubUrl,
                  isVerified: item.isVerified,
                  claimedAt: item.claimedAt || new Date().toISOString(),
                };

                if (engine) {
                  engine.renderer.selectedCitizen = targetSpot;
                }

                try {
                  openProfileModal(targetSpot);
                } catch (err) {
                  console.error('Failed to open profile modal:', err);
                }
              });

              searchResultsList.appendChild(row);
            });
          }
        }, 220);
      }

      searchInput?.addEventListener('input', (e) => {
        triggerSearch((e.target as HTMLInputElement).value);
      });

      // Update HUD coordinate & zoom display
      setInterval(() => {
        if (!engine) return;

        const pct = Math.round(engine.camera.zoom * 100);
        if (zoomLevel) zoomLevel.textContent = `${pct}%`;

        const hov = engine.renderer.hoveredGrid;
        if (coordText) {
          coordText.textContent = hov ? `(${hov.gx}, ${hov.gy})` : '—';
        }
      }, 100);

      // Hide loader
      loader.classList.add('hidden');
      setTimeout(() => { loader.style.display = 'none'; }, 500);

    } catch (err) {
      console.error('[SpotWorld] Boot failed:', err);
      loaderSub.textContent = 'Failed to load world. Please refresh.';
      showToast('Could not load Spot World. Check your connection.', 'error');
    }
  }

  // ── HUD button handlers ───────────────────────────────────────────────────
  btnZoomIn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;
    const newZ = Math.min(engine.camera.maxZoom, engine.camera.targetZoom * 1.3);
    engine.camera.centerOn(engine.camera.targetX, engine.camera.targetY, newZ);
  });

  btnZoomOut?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;
    const newZ = Math.max(engine.camera.minZoom, engine.camera.targetZoom / 1.3);
    engine.camera.centerOn(engine.camera.targetX, engine.camera.targetY, newZ);
  });

  btnRecenter?.addEventListener('click', (e) => {
    e.stopPropagation();
    engine?.flyTo(52, 60, 1.0);
  });

  // ── Audio Ambience Toggle ────────────────────────────────────────────────
  const btnWorldAudio = document.getElementById('world-audio-btn');
  const worldAudioIcon = document.getElementById('world-audio-icon');

  btnWorldAudio?.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (!engine) return;
    const isMuted = await engine.audio.toggleMute();
    if (worldAudioIcon) {
      worldAudioIcon.textContent = isMuted ? '🔇' : '🔊';
    }
    showToast(isMuted ? 'Environmental sound muted' : '🍃 Natural air, breeze & birds enabled', 'info');
  });

  // ── Time of Day Switcher ─────────────────────────────────────────────────
  const btnWorldTod = document.getElementById('world-tod-btn');
  const worldTodIcon = document.getElementById('world-tod-icon');

  const TOD_MODES: Array<'night' | 'day' | 'twilight'> = ['night', 'day', 'twilight'];
  const TOD_ICONS: Record<'night' | 'day' | 'twilight', string> = {
    night: '🌙',
    day: '☀️',
    twilight: '🌆',
  };
  const TOD_LABELS: Record<'night' | 'day' | 'twilight', string> = {
    night: '🌙 Cozy Neon Night',
    day: '☀️ Sunlit Daytime',
    twilight: '🌆 Golden Sunset Twilight',
  };

  btnWorldTod?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;

    const current = engine.renderer.timeOfDay;
    const nextIdx = (TOD_MODES.indexOf(current) + 1) % TOD_MODES.length;
    const next = TOD_MODES[nextIdx];

    engine.renderer.timeOfDay = next;
    if (worldTodIcon) {
      worldTodIcon.textContent = TOD_ICONS[next];
    }
    showToast(TOD_LABELS[next], 'info');
  });

  // ── Boot ─────────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => { void boot(); });

  document.addEventListener('astro:before-swap', () => {
    engine?.destroy();
    engine = null;
  });
</script>
