    let subtext = bannerInputSubtext?.value.trim();
    let bannerImage = bannerInputImage?.value.trim() || fetchedOgImage || '';

    if (currentBanner.isSponsored) {
      // When extending existing sponsorship, seamlessly inherit already stored business data!
      sponsorName = sponsorName || currentBanner.buyerName || 'Verified Sponsor';
