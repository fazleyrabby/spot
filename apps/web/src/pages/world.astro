---
import Layout from '../layouts/Layout.astro';
import WorldHUD from '../components/WorldHUD.astro';
import ProfileModal from '../components/ProfileModal.astro';
import SecretModal from '../components/SecretModal.astro';
import NpcModal from '../components/NpcModal.astro';
import JournalModal from '../components/JournalModal.astro';
import WorldChatBar from '../components/WorldChatBar.astro';
import SearchModal from '../components/SearchModal.astro';
import BannerModal from '../components/BannerModal.astro';
import LibraryModal from '../components/LibraryModal.astro';
import ArcadeModal from '../components/ArcadeModal.astro';
import ShareModal from '../components/ShareModal.astro';
---

<Layout
  title="Spot World — Explore the Living City"
  description="Walk through the top-down Spot World in cozy Stardew style. Discover citizens, explore their plots, and see who lives next door."
  url="https://www.claimyourspot.lol/world"
>
  <main class="world-app" id="world-app">
    <h1 class="sr-only">SPOT World — Interactive 2.5D Cyberpunk Multiplayer Pixel World</h1>
    <WorldHUD />

    <!-- Full-screen top-down canvas -->
    <canvas id="world-canvas" class="world-canvas"></canvas>

    <!-- Non-blocking floating status pill -->
    <div class="world-loader" id="world-loader" role="status" aria-live="polite">
      <div class="loader-inner">
        <div class="loader-spinner"></div>
        <span class="loader-text">Building Spot Island…</span>
        <span class="loader-sub" id="loader-sub">Hydrating sector</span>
      </div>
    </div>

    <!-- Reuse the existing profile modal for click-to-inspect -->
    <ProfileModal />

    <!-- Secret discovery modal -->
    <SecretModal />

    <!-- The Grand Codex Curated Developer Library Modal -->
    <LibraryModal />

    <!-- 1984 Retro Cyber Arcade Cabinet Modal -->
    <ArcadeModal />

    <!-- Street NPC interaction dialogue modal -->
    <NpcModal />

    <!-- Explorer Journal modal -->
    <JournalModal />

    <!-- Sponsor Billboard Banner Modal -->
    <BannerModal />

    <!-- Quick Emote & Chat Dock -->
    <WorldChatBar />

    <!-- Citizen Search & GPS Modal -->
    <SearchModal />

    <!-- 1-Click Viral Share & Embed Modal -->
    <ShareModal />

    <!-- Toast container -->
    <div id="world-toast-container" class="toast-container"></div>
  </main>
</Layout>

<style>
  .world-app {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #0f1710;
  }

  .world-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: default;
  }

  /* ── Non-blocking Incremental Loading Pill ──────────────────────────── */
  .world-loader {
    position: fixed;
    top: max(72px, calc(env(safe-area-inset-top, 0px) + 72px));
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: var(--radius-full, 9999px);
    background: rgba(15, 23, 42, 0.90);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(56, 189, 248, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    z-index: 30;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .world-loader.hidden {
    opacity: 0;
    transform: translate(-50%, -12px);
  }

  .loader-inner {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .loader-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(56, 189, 248, 0.25);
    border-top-color: #38bdf8;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loader-text {
    color: #f8fafc;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .loader-sub {
    color: #38bdf8;
    font-size: 0.78rem;
    font-weight: 500;
  }

  /* ── Toast ───────────────────────────────────────────────────────────── */
  .toast-container {
    position: fixed;
    top: 72px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 300;
    pointer-events: none;
  }

  .toast {
    padding: 9px 20px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #f8fafc;
    background: rgba(15, 23, 42, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55), 0 0 12px rgba(56, 189, 248, 0.12);
    animation: toastSlideDown 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: auto;
    white-space: nowrap;
  }

  .toast-error {
    border-color: rgba(239, 68, 68, 0.45);
    color: #fca5a5;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55), 0 0 12px rgba(239, 68, 68, 0.2);
  }

  .toast-success {
    border-color: rgba(34, 197, 94, 0.45);
    color: #86efac;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55), 0 0 12px rgba(34, 197, 94, 0.2);
  }

  .toast.fade-out {
    opacity: 0;
    transform: translateY(-6px) scale(0.96);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  @keyframes toastSlideDown {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  import { Engine } from '../world/engine.js';
  import { WORLD_SECRETS, BADGE_DEFINITIONS, getUnlockedBadges } from '../world/secrets.js';
  import { applyActiveSponsorships, WORLD_BANNERS } from '../world/banner-manager.js';
  import { AVATAR_CATALOG, drawAvatarOnCanvas, drawCustomAvatarOnCanvas } from '../canvas/avatars.js';
  import { containsBlockedWord, formatSocialUrl, validateAdPolicy, type OccupiedSpotSummary } from '@spot/shared';
  import { fetchMySession, syncGithubAuth, searchCitizens, fetchSpotComments, postSpotComment, recordVisit } from '../api/client.js';
  import { supabase } from '../api/supabase.js';

  // ── Resolve API base ──────────────────────────────────────────────────────
  function resolveApiOrigin(): string {
    const configured = (import.meta.env.PUBLIC_API_BASE as string | undefined)?.replace(/\/$/, '');
    if (typeof window !== 'undefined') {
      const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      // When accessed from non-localhost (e.g. claimyourspot.lol or remote homelab), never target localhost
      if (!isLocal && configured && (configured.includes('localhost') || configured.includes('127.0.0.1'))) {
        return window.location.origin;
      }
      if (configured) {
        return configured.endsWith('/api') ? configured.replace(/\/api$/, '') : configured;
      }
      return window.location.origin;
    }
    if (configured) {
      return configured.endsWith('/api') ? configured.replace(/\/api$/, '') : configured;
    }
    return '';
  }
  const API_BASE: string = resolveApiOrigin();

  // ── DOM refs ─────────────────────────────────────────────────────────────
  const canvas       = document.getElementById('world-canvas') as HTMLCanvasElement;
  const loader       = document.getElementById('world-loader') as HTMLDivElement;
  const loaderSub    = document.getElementById('loader-sub') as HTMLParagraphElement;
  const coordText    = document.getElementById('world-coord-text') as HTMLSpanElement;
  const zoomLevel    = document.getElementById('world-zoom-level') as HTMLSpanElement;
  const btnZoomIn    = document.getElementById('world-zoom-in') as HTMLButtonElement;
  const btnZoomOut   = document.getElementById('world-zoom-out') as HTMLButtonElement;
  const btnRecenter  = document.getElementById('world-recenter') as HTMLButtonElement;

  // Profile modal elements (reused from ProfileModal.astro)
  const profileBackdrop = document.getElementById('profile-modal-backdrop') as HTMLElement;
  const profileModalClose = document.getElementById('profile-modal-close') as HTMLButtonElement;
  const profileAvatarCanvas = document.getElementById('profile-avatar-canvas') as HTMLCanvasElement;
  const profileSpotId   = document.getElementById('profile-spot-id') as HTMLElement;
  const profileName     = document.getElementById('profile-name') as HTMLElement;
  const profileTagline  = document.getElementById('profile-tagline') as HTMLElement;
  const profileVerifiedBadge = document.getElementById('profile-verified-badge') as HTMLElement;
  const linkWebsite     = document.getElementById('link-website') as HTMLAnchorElement;
  const linkWebsiteText = document.getElementById('link-website-text') as HTMLElement;
  const linkTwitter     = document.getElementById('link-twitter') as HTMLAnchorElement;
  const linkFacebook    = document.getElementById('link-facebook') as HTMLAnchorElement;
  const linkInstagram   = document.getElementById('link-instagram') as HTMLAnchorElement;
  const linkLinkedin    = document.getElementById('link-linkedin') as HTMLAnchorElement;
  const linkYoutube     = document.getElementById('link-youtube') as HTMLAnchorElement;
  const linkGithub      = document.getElementById('link-github') as HTMLAnchorElement;

  // ── Toast helper ─────────────────────────────────────────────────────────
  function showToast(message: string, type: 'error' | 'info' | 'success' = 'info') {
    const container = document.getElementById('world-toast-container');
    if (!container) return;

    while (container.children.length >= 2) {
      container.firstChild?.remove();
    }

    const el = document.createElement('div');
    el.className = `toast toast-${type}`;
    el.textContent = message;
    container.appendChild(el);
    setTimeout(() => {
      el.classList.add('fade-out');
      setTimeout(() => el.remove(), 250);
    }, 2800);
  }

  // ── Profile modal population ──────────────────────────────────────────────
  function openProfileModal(spot: OccupiedSpotSummary) {
    if (!profileBackdrop) return;

    const def = AVATAR_CATALOG[spot.avatarId] ?? AVATAR_CATALOG.astronaut;
    const avatarCtx = profileAvatarCanvas?.getContext('2d');
    if (avatarCtx && profileAvatarCanvas) {
      avatarCtx.clearRect(0, 0, 64, 64);
      if (spot.customAvatarData) {
        drawCustomAvatarOnCanvas(avatarCtx, spot.customAvatarData, 0, 0, 64);
      } else {
        drawAvatarOnCanvas(avatarCtx, def, 0, 0, 64);
      }
    }

    const isGuest = !spot.citizenId || spot.citizenId.startsWith('guest_') || spot.displayName === 'Visitor';
    const profilePresenceText = document.getElementById('profile-presence-text');
    const profilePresence = document.getElementById('profile-presence');
    const spotWallSection = document.getElementById('spot-wall-section');

    const setLink = (
      el: HTMLAnchorElement | null,
      url?: string | null,
      platform?: 'twitter' | 'facebook' | 'instagram' | 'youtube' | 'github' | 'linkedin' | 'website'
    ) => {
      if (!el) return;
      const href = formatSocialUrl(url, platform);
      if (href) { el.href = href; el.style.display = ''; }
      else      { el.style.display = 'none'; }
    };

    if (isGuest) {
      if (profileSpotId)  profileSpotId.textContent  = 'Temporary Visitor';
      if (profileName)    profileName.textContent     = spot.displayName || 'Visitor';
      if (profileTagline) profileTagline.textContent  = 'A roaming guest exploring the Spot World island ✨';
      if (profilePresenceText) profilePresenceText.textContent = 'Roaming Explorer';
      if (profilePresence) {
        profilePresence.style.background = 'rgba(56, 189, 248, 0.12)';
        profilePresence.style.borderColor = 'rgba(56, 189, 248, 0.3)';
        profilePresence.style.color = '#38bdf8';
      }
      if (profileVerifiedBadge) profileVerifiedBadge.style.display = 'none';

      setLink(linkWebsite, null);
      setLink(linkTwitter, null);
      setLink(linkFacebook, null);
      setLink(linkInstagram, null);
      setLink(linkLinkedin, null);
      setLink(linkYoutube, null);
      setLink(linkGithub, null);

      if (spotWallSection) spotWallSection.style.display = 'none';
    } else {
      if (profileSpotId)  profileSpotId.textContent  = `Spot (${spot.x}, ${spot.y})`;
      if (profileName)    profileName.textContent     = spot.displayName;
      if (profileTagline) profileTagline.textContent  = spot.tagline || '';
      if (profilePresenceText) profilePresenceText.textContent = 'Permanent Citizen';
      if (profilePresence) {
        profilePresence.style.background = '';
        profilePresence.style.borderColor = '';
        profilePresence.style.color = '';
      }
      if (profileVerifiedBadge) {
        profileVerifiedBadge.style.display = spot.isVerified ? '' : 'none';
      }

      if (linkWebsite) {
        setLink(linkWebsite, spot.websiteUrl, 'website');
        if (linkWebsiteText && spot.websiteUrl) {
          const href = formatSocialUrl(spot.websiteUrl, 'website');
          if (href) {
            try {
              linkWebsiteText.textContent = new URL(href).hostname;
            } catch { linkWebsiteText.textContent = 'Website'; }
          }
        }
      }
      setLink(linkTwitter,   spot.twitterUrl,   'twitter');
      setLink(linkFacebook,  spot.facebookUrl,  'facebook');
      setLink(linkInstagram, spot.instagramUrl, 'instagram');
      setLink(linkLinkedin,  spot.linkedinUrl,  'linkedin');
      setLink(linkYoutube,   spot.youtubeUrl,   'youtube');
      setLink(linkGithub,    spot.githubUrl,    'github');

      if (spotWallSection) spotWallSection.style.display = '';

    // Citizen Achievement Badges (Meaningful, Verified, & Contextual)
    const profileBadgesRow = document.getElementById('profile-badges-row');
    const profileBadgesList = document.getElementById('profile-badges-list');
    if (profileBadgesRow && profileBadgesList) {
      interface DisplayBadge {
        icon: string;
        name: string;
        color: string;
        description: string;
      }
      const badges: DisplayBadge[] = [];

      // 1. Genesis Founder (Central origin sector or flagged founder)
      if (spot.isFounder || (spot.x >= 48 && spot.x <= 52 && spot.y >= 48 && spot.y <= 52)) {
        badges.push({
          icon: '👑',
          name: 'Genesis Founder',
          color: '#f59e0b',
          description: 'Founding citizen of the Spot Metropolis',
        });
      }

      // 2. GitHub Verified Developer
      if (spot.isVerified || spot.githubUrl) {
        badges.push({
          icon: '✦',
          name: 'GitHub Verified',
          color: '#38bdf8',
          description: 'Authenticated GitHub developer',
        });
      }

      // 3. Permanent Citizen (Registered plot deed)
      if (!isGuest && spot.citizenId) {
        badges.push({
          icon: '🏛️',
          name: 'Permanent Citizen',
          color: '#10b981',
          description: `Registered owner of plot (${spot.x}, ${spot.y})`,
        });
      }

      // 4. Featured Showcase / Sponsor tier
      if ((spot as any).tier === 'featured' || (spot as any).tier === 'premium') {
        badges.push({
          icon: '⚡',
          name: 'Featured Showcase',
          color: '#c084fc',
          description: 'Official sponsor & featured showcase project',
        });
      }

      // 5. Only include personal explorer badges if viewing your own citizen profile
      let myCitizenId = '';
      try {
        const cached = localStorage.getItem('spot_my_citizen');
        if (cached) myCitizenId = JSON.parse(cached).id;
      } catch (_) {}
      const isSelf = Boolean(myCitizenId && spot.citizenId && myCitizenId === spot.citizenId);

      if (isSelf) {
        const discovered = getDiscoveredSecrets();
        const arcadeScore = Number(localStorage.getItem('spot_arcade_highscore') || '0');
        const unlocked = getUnlockedBadges(Array.from(discovered), arcadeScore);
        for (const u of unlocked) {
          badges.push({
            icon: u.icon,
            name: u.name,
            color: u.color,
            description: u.description,
          });
        }
      }

      if (badges.length > 0) {
        profileBadgesRow.style.display = 'flex';
        profileBadgesList.innerHTML = badges
          .map(
            (b) => `
          <div class="profile-badge-chip" title="${b.description}" style="border-color: ${b.color}40; background: ${b.color}15;">
            <span>${b.icon}</span>
            <span style="color: ${b.color}; font-weight: 700;">${b.name}</span>
          </div>
        `
          )
          .join('');
      } else {
        profileBadgesRow.style.display = 'none';
      }
    }

    // Reset Spot Wall to closed/clean state by default
    if (spotWallForm) {
        spotWallForm.hidden = true;
        spotWallForm.style.display = 'none';
      }
      if (spotWallSelfNote) {
        spotWallSelfNote.style.display = 'block';
        spotWallSelfNote.textContent = 'This wall is read-only until the owner opens it.';
      }
      if (spotWallComments) {
        spotWallComments.textContent = 'Loading messages…';
      }

      const spotId = `${spot.x},${spot.y}`;
      void loadSpotComments(spotId, spot);
    }

    const viewSec = document.getElementById('profile-view-section');
    const editSec = document.getElementById('profile-edit-section');
    if (viewSec) viewSec.style.display = '';
    if (editSec) editSec.style.display = 'none';

    const editBtn = document.getElementById('profile-edit-btn');
    const deleteBtn = document.getElementById('profile-delete-btn');
    if (editBtn)   editBtn.style.display = 'none';
    if (deleteBtn) deleteBtn.style.display = 'none';

    profileBackdrop.classList.add('open');
    profileBackdrop.setAttribute('aria-hidden', 'false');
    currentViewingSpotSummary = spot;
  }

  // ── Spot Wall / Guestbook Comments ─────────────────────────────────────────
  const spotWallComments = document.getElementById('spot-wall-comments');
  const spotWallForm = document.getElementById('spot-wall-form') as HTMLFormElement | null;
  const spotWallAuthor = document.getElementById('spot-wall-author') as HTMLInputElement | null;
  const spotWallBody = document.getElementById('spot-wall-body') as HTMLInputElement | null;
  const spotWallSubmit = document.getElementById('spot-wall-submit') as HTMLButtonElement | null;
  const spotWallSelfNote = document.getElementById('spot-wall-self-note');
  let currentViewingSpotId = '';
  let currentViewingSpotSummary: OccupiedSpotSummary | null = null;

  function renderSpotComments(comments: Array<{ authorName: string; body: string; createdAt: string }>): void {
    if (!spotWallComments) return;
    spotWallComments.replaceChildren();
    if (comments.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'spot-wall-empty';
      empty.textContent = 'Be the first to leave a note.';
      spotWallComments.appendChild(empty);
      return;
    }
    comments.forEach((comment) => {
      const item = document.createElement('article');
      item.className = 'spot-wall-comment';
      const meta = document.createElement('div');
      meta.className = 'spot-wall-comment-meta';
      const author = document.createElement('span');
      author.className = 'spot-wall-comment-author';
      author.textContent = `@${comment.authorName}`;
      const time = document.createElement('time');
      time.textContent = ` • ${new Date(comment.createdAt).toLocaleDateString()}`;
      meta.append(author, time);
      const body = document.createElement('p');
      body.className = 'spot-wall-comment-body';
      body.textContent = comment.body;
      item.append(meta, body);
      spotWallComments.appendChild(item);
    });
  }

  async function loadSpotComments(spotId: string, _spot: OccupiedSpotSummary): Promise<void> {
    currentViewingSpotId = spotId;

    try {
      const data = await fetchSpotComments(spotId);
      renderSpotComments(data.comments || []);

      const canPost = Boolean(data.canPost && data.visibility === 'open' && !data.isOwner);
      if (spotWallForm) {
        spotWallForm.hidden = !canPost;
        spotWallForm.style.display = canPost ? 'grid' : 'none';
      }
      if (spotWallSelfNote) {
        spotWallSelfNote.style.display = canPost ? 'none' : 'block';
        spotWallSelfNote.textContent = data.isOwner
          ? 'This is your spot. Visitors can leave notes here.'
          : (data.visibility === 'open' ? 'Leave a note on this spot wall.' : 'This wall is read-only until the owner opens it.');
      }
    } catch (_) {
      if (spotWallComments) spotWallComments.textContent = 'No messages yet.';
      if (spotWallForm) {
        spotWallForm.hidden = true;
        spotWallForm.style.display = 'none';
      }
      if (spotWallSelfNote) {
        spotWallSelfNote.style.display = 'block';
        spotWallSelfNote.textContent = 'This wall is read-only until the owner opens it.';
      }
    }
  }

  spotWallForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentViewingSpotId || !spotWallBody) return;
    const body = spotWallBody.value.trim();
    if (!body) return;

    if (spotWallSubmit) spotWallSubmit.disabled = true;

    try {
      const authorName = spotWallAuthor?.value.trim() || 'Visitor';

      if (containsBlockedWord(body) || containsBlockedWord(authorName)) {
        showToast('Please keep spot wall messages kind & welcoming! 🌸', 'error');
        if (spotWallSubmit) spotWallSubmit.disabled = false;
        return;
      }

      const res = await fetch(`${API_BASE}/api/spots/${currentViewingSpotId}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ body, authorName }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        showToast(err.message || 'Could not post message.', 'error');
        return;
      }

      const data = await res.json();
      spotWallBody.value = '';
      showToast('Note posted to spot wall!', 'success');

      // Refresh comments
      const refreshRes = await fetch(`${API_BASE}/api/spots/${currentViewingSpotId}/comments`, { credentials: 'include' });
      if (refreshRes.ok) {
        const wall = await refreshRes.json();
        renderSpotComments(wall.comments || []);
      }
    } catch (err) {
      showToast('Failed to post message. Please try again.', 'error');
    } finally {
      if (spotWallSubmit) spotWallSubmit.disabled = false;
    }
  });

  function closeProfileModal() {
    if (!profileBackdrop) return;
    profileBackdrop.classList.remove('open');
    profileBackdrop.setAttribute('aria-hidden', 'true');
  }

  profileModalClose?.addEventListener('click', closeProfileModal);
  profileBackdrop?.addEventListener('click', (e) => {
    if (e.target === profileBackdrop) closeProfileModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProfileModal();
  });

  // ── Share & Flex Modal Triggers ──────────────────────────────────────────
  const profileShareChip = document.getElementById('profile-share-chip');
  const btnCopySpotLink = document.getElementById('btn-copy-spot-link');
  const btnWorldShare = document.getElementById('world-share-btn');

  function triggerShareModalForCurrent() {
    (window as any).openShareModal?.({
      citizenName: currentViewingSpotSummary?.displayName || 'Citizen',
      x: currentViewingSpotSummary?.x,
      y: currentViewingSpotSummary?.y,
      spotId: currentViewingSpotSummary ? `${currentViewingSpotSummary.x},${currentViewingSpotSummary.y}` : undefined,
    });
  }

  profileShareChip?.addEventListener('click', (e) => {
    e.stopPropagation();
    triggerShareModalForCurrent();
  });

  btnCopySpotLink?.addEventListener('click', (e) => {
    e.stopPropagation();
    triggerShareModalForCurrent();
  });

  btnWorldShare?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeProfileModal();
    closeSecretModal();
    closeBannerModal();
    (window as any).openShareModal?.({
      citizenName: currentViewingSpotSummary?.displayName || 'Citizen',
      x: currentViewingSpotSummary?.x ?? 50,
      y: currentViewingSpotSummary?.y ?? 50,
    });
  });

  // ── Secret Discovery Modal Wiring ─────────────────────────────────────────
  const secretBackdrop = document.getElementById('secret-modal-backdrop');
  const secretCloseBtn = document.getElementById('secret-modal-close');
  const secretDismissBtn = document.getElementById('secret-dismiss-btn');
  const secretIcon = document.getElementById('secret-icon');
  const secretDistrict = document.getElementById('secret-district');
  const secretTitle = document.getElementById('secret-title');
  const secretSubtitle = document.getElementById('secret-subtitle');
  const secretQuoteBox = document.getElementById('secret-quote-box');
  const secretQuote = document.getElementById('secret-quote');
  const secretDesc = document.getElementById('secret-desc');
  const secretRewardBadge = document.getElementById('secret-reward-badge');
  const secretRewardText = document.getElementById('secret-reward-text');
  const secretActionBtn = document.getElementById('secret-action-btn') as HTMLAnchorElement | null;
  const hudSecretsCount = document.getElementById('hud-secrets-count');

  const TOTAL_SECRETS = WORLD_SECRETS.length;

  function getDiscoveredSecrets(): Set<string> {
    try {
      const raw = localStorage.getItem('spot_world_secrets') || '[]';
      return new Set(JSON.parse(raw));
    } catch {
      return new Set();
    }
  }

  function updateSecretsHUD(): void {
    const discovered = getDiscoveredSecrets();
    if (hudSecretsCount) {
      hudSecretsCount.textContent = `${discovered.size}/${TOTAL_SECRETS}`;
    }
