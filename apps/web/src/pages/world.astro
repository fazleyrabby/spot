        if (cData?.id) {
          params.set('custom_fields[Citizen ID]', cData.id);
          if (cData.displayName) {
            params.set('custom_fields[Citizen Handle]', cData.displayName);
          }
        }
      }
    } catch (_) {}

    if (isLocal) {
      params.set('discount_code', 'TESTDEV');
    }

    // Persist configured ad locally for instant preview upon return
    try {
      localStorage.setItem(
        'spot_pending_ad_' + currentBanner.id,
        JSON.stringify({
          billboard_id: currentBanner.id,
          billboard_name: currentBanner.name,
          headline,
          subtext,
          target_url: destUrl,
          buyer_name: sponsorName,
          brand_color: selectedAccentColor,
          timestamp: Date.now(),
        })
      );
    } catch (_) {}

    window.open(`${gumroadBase}?${params.toString()}`, '_blank');
    closeBannerModal();
  });
  bannerBackdrop?.addEventListener('click', (e) => {
    if (e.target === bannerBackdrop) closeBannerModal();
