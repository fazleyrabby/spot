  let selectedAccentColor: string = '#00f0ff';

  function updatePreviewMedia(): void {
    // Priority: Custom Image URL > Auto-fetched OG image
    const customImage = bannerInputImage?.value.trim();
    const effectiveImage = customImage || fetchedOgImage;

    if (effectiveImage && bannerPreviewLogoImg && bannerPreviewLogoWrap) {
      bannerPreviewLogoImg.src = effectiveImage;
      bannerPreviewLogoWrap.style.display = 'flex';
    } else if (bannerPreviewLogoWrap) {
      bannerPreviewLogoWrap.style.display = 'none';
    }
  }

  // Live input synchronization
  bannerInputHeadline?.addEventListener('input', () => {
    if (bannerHeadline) {
      bannerHeadline.textContent = bannerInputHeadline.value.toUpperCase() || (currentBanner?.headline ?? 'COMING SOON...');
    }
  });

  bannerInputSubtext?.addEventListener('input', () => {
    if (bannerSubtext) {
      bannerSubtext.textContent = bannerInputSubtext.value || (currentBanner?.subtext ?? 'Featured Project / Brand Space');
    }
  });

  bannerInputName?.addEventListener('input', () => {
    if (bannerStatus) {
      bannerStatus.textContent = bannerInputName.value ? `Reserved for ${bannerInputName.value}` : (currentBanner?.statusText ?? 'Reservation Available');
    }
  });

  bannerInputImage?.addEventListener('input', () => {
    updatePreviewMedia();
  });

  // Auto-fetch OpenGraph image and metadata when URL is entered
  bannerInputUrl?.addEventListener('blur', async () => {
    const rawUrl = bannerInputUrl.value.trim();
    if (!rawUrl) return;

    try {
      const res = await fetch(`${API_BASE}/api/billboards/fetch-og?url=${encodeURIComponent(rawUrl)}`);
      if (res.ok) {
        const data = await res.json();
        if (data.ogImage) {
          fetchedOgImage = data.ogImage;
          updatePreviewMedia();
        }
        // Auto-fill headline if empty
        if (data.title && !bannerInputHeadline?.value) {
          const cleanTitle = data.title.split(/[-|·]/)[0].trim().toUpperCase().slice(0, 24);
          if (bannerInputHeadline) bannerInputHeadline.value = cleanTitle;
          if (bannerHeadline) bannerHeadline.textContent = cleanTitle;
        }
        // Auto-fill subtext if empty
        if (data.description && !bannerInputSubtext?.value) {
          const cleanDesc = data.description.slice(0, 45);
          if (bannerInputSubtext) bannerInputSubtext.value = cleanDesc;
          if (bannerSubtext) bannerSubtext.textContent = cleanDesc;
