  function formatTimeLeft(expiresAt: string | undefined): { text: string; isUrgent: boolean } | null {
    if (!expiresAt) return null;
    const diffMs = new Date(expiresAt).getTime() - Date.now();
    if (diffMs <= 0) return { text: 'Expired', isUrgent: true };

    const totalSeconds = Math.floor(diffMs / 1000);
    const seconds = totalSeconds % 60;
    const minutes = Math.floor(totalSeconds / 60) % 60;
    const hours = Math.floor(totalSeconds / 3600) % 24;
    const days = Math.floor(totalSeconds / 86400);

    let text = '';
    if (days > 0) {
      text = `${days}d ${hours}h ${minutes}m left`;
    } else if (hours > 0) {
      text = `${hours}h ${minutes}m ${seconds}s left`;
    } else {
      text = `${minutes}m ${seconds}s left`;
    }

    return { text, isUrgent: days < 3 };
  }

