    journalList.innerHTML = '';
    for (const secret of WORLD_SECRETS) {
      const isFound = discovered.has(secret.id);
      const card = document.createElement('div');
      card.className = `journal-item ${isFound ? 'discovered' : ''}`;

      if (isFound) {
        card.innerHTML = `
