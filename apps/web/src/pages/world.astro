  // ── Explorer Journal Modal Wiring ──────────────────────────────────────────
  const journalBackdrop = document.getElementById('journal-modal-backdrop');
  const journalCloseBtn = document.getElementById('journal-modal-close');
  const journalList = document.getElementById('journal-list');
  const journalBadgesGrid = document.getElementById('journal-badges-grid');
  const journalTabLandmarks = document.getElementById('journal-tab-landmarks');
  const journalTabBadges = document.getElementById('journal-tab-badges');
  const tabLandmarksCount = document.getElementById('tab-landmarks-count');
  const tabBadgesCount = document.getElementById('tab-badges-count');
  const journalProgressTitle = document.getElementById('journal-progress-title');
  const journalProgressText = document.getElementById('journal-progress-text');
  const journalProgressFill = document.getElementById('journal-progress-fill');
  const hudSecretsBtn = document.getElementById('hud-secrets-btn');

  let activeJournalTab: 'landmarks' | 'badges' = 'landmarks';

  function updateJournalView(): void {
    if (!journalBackdrop || !journalList || !journalBadgesGrid) return;
    const discovered = getDiscoveredSecrets();
    const totalLandmarks = WORLD_SECRETS.length;
    const arcadeScore = Number(localStorage.getItem('spot_arcade_highscore') || '0');
    const unlockedBadges = getUnlockedBadges(Array.from(discovered), arcadeScore);
    const totalBadges = BADGE_DEFINITIONS.length;

    if (tabLandmarksCount) tabLandmarksCount.textContent = `${discovered.size}/${totalLandmarks}`;
    if (tabBadgesCount) tabBadgesCount.textContent = `${unlockedBadges.length}/${totalBadges}`;

    if (activeJournalTab === 'landmarks') {
      journalList.style.display = 'flex';
      journalBadgesGrid.style.display = 'none';
      journalTabLandmarks?.classList.add('active');
      journalTabBadges?.classList.remove('active');

      const pct = Math.round((discovered.size / totalLandmarks) * 100);
      if (journalProgressTitle) journalProgressTitle.textContent = 'Metropolis Mapped';
      if (journalProgressText) journalProgressText.textContent = `${discovered.size} / ${totalLandmarks} Discovered (${pct}%)`;
      if (journalProgressFill) journalProgressFill.style.width = `${pct}%`;

      journalList.innerHTML = '';
      for (const secret of WORLD_SECRETS) {
        const isFound = discovered.has(secret.id);
        const card = document.createElement('div');
        card.className = `journal-item ${isFound ? 'discovered' : ''}`;

        if (isFound) {
          card.innerHTML = `
            <div class="journal-item-icon">${secret.icon}</div>
            <div class="journal-item-content">
              <div class="journal-item-top">
                <h4 class="journal-item-name">${secret.name}</h4>
                <span class="journal-item-coords">(${secret.gx}, ${secret.gy})</span>
              </div>
              <div class="journal-item-district">${secret.district} • <span style="color:#00f0ff;">✓ Discovered</span></div>
              <p class="journal-item-clue">“${secret.quote || secret.description}”</p>
            </div>
          `;
        } else {
          card.innerHTML = `
            <div class="journal-item-icon">❓</div>
            <div class="journal-item-content">
              <div class="journal-item-top">
                <h4 class="journal-item-name">Undiscovered Landmark</h4>
                <span class="journal-item-coords">[???, ???]</span>
              </div>
              <div class="journal-item-district">${secret.district} • <span style="color:#f59e0b;">Undiscovered</span></div>
              <p class="journal-item-clue">🔍 Riddle: “${secret.clue}”</p>
            </div>
          `;
        }
        journalList.appendChild(card);
      }
    } else {
      journalList.style.display = 'none';
      journalBadgesGrid.style.display = 'grid';
      journalTabLandmarks?.classList.remove('active');
      journalTabBadges?.classList.add('active');

      const pct = Math.round((unlockedBadges.length / totalBadges) * 100);
      if (journalProgressTitle) journalProgressTitle.textContent = 'Badges Earned';
      if (journalProgressText) journalProgressText.textContent = `${unlockedBadges.length} / ${totalBadges} Badges (${pct}%)`;
      if (journalProgressFill) journalProgressFill.style.width = `${pct}%`;

      journalBadgesGrid.innerHTML = '';
      for (const badge of BADGE_DEFINITIONS) {
        const isUnlocked = badge.checkUnlocked(Array.from(discovered), { arcadeHighScore: arcadeScore });
        const card = document.createElement('div');
        card.className = `journal-badge-card ${isUnlocked ? 'unlocked' : 'locked'}`;

        card.innerHTML = `
          <div class="badge-card-icon" style="background: ${isUnlocked ? badge.color + '15' : 'rgba(255,255,255,0.03)'}; border: 1px solid ${isUnlocked ? badge.color + '40' : 'rgba(255,255,255,0.08)'};">
            ${badge.icon}
          </div>
          <div class="badge-card-content">
            <div class="badge-card-top">
              <h4 class="badge-card-name">${badge.name}</h4>
              <span class="badge-card-status" style="color: ${isUnlocked ? badge.color : '#64748b'};">
                ${isUnlocked ? '✓ Unlocked' : '🔒 Locked'}
              </span>
            </div>
            <p class="badge-card-desc">${badge.description}</p>
          </div>
        `;
        journalBadgesGrid.appendChild(card);
      }
    }
  }

  function openJournalModal(): void {
    if (!journalBackdrop) return;
    updateJournalView();
    journalBackdrop.classList.add('open');
    journalBackdrop.setAttribute('aria-hidden', 'false');
  }

  journalTabLandmarks?.addEventListener('click', () => {
    activeJournalTab = 'landmarks';
    updateJournalView();
  });

  journalTabBadges?.addEventListener('click', () => {
    activeJournalTab = 'badges';
    updateJournalView();
  });

  function closeJournalModal(): void {
    if (!journalBackdrop) return;
    journalBackdrop.classList.remove('open');
    journalBackdrop.setAttribute('aria-hidden', 'true');
  }

  hudSecretsBtn?.addEventListener('click', openJournalModal);
