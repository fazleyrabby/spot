  // ── Turbo Boost HUD Timer Loop ─────────────────────────────────────────────
  const hudTurboPill = document.getElementById('hud-turbo-pill');
  const hudTurboTimer = document.getElementById('hud-turbo-timer');

  setInterval(() => {
    if (!engine) return;
    const remainingFrames = engine.renderer.npcs.speedBoostRemainingFrames;
    if (remainingFrames > 0 && hudTurboPill && hudTurboTimer) {
      hudTurboPill.style.display = 'inline-flex';
      const seconds = Math.ceil(remainingFrames / 60);
      hudTurboTimer.textContent = `${seconds}s`;
    } else if (hudTurboPill) {
      hudTurboPill.style.display = 'none';
    }
  }, 200);

  // ── Engine ────────────────────────────────────────────────────────────────
  let engine: InstanceType<typeof Engine> | null = null;

  async function boot() {
    loaderSub.textContent = 'Sprouting sector…';
    updateSecretsHUD();

    try {
      let avatarId = 'astronaut';
      let citizenId = '';
      let displayName = 'Visitor';
      let isVerified = false;

      // 1. Instant local storage cache check (<0.5ms)
      try {
        const cachedCitizen = localStorage.getItem('spot_my_citizen');
        if (cachedCitizen) {
          const parsed = JSON.parse(cachedCitizen);
          if (parsed?.id) citizenId = parsed.id;
          if (parsed?.displayName) displayName = parsed.displayName;
          if (parsed?.avatarId) avatarId = parsed.avatarId;
          if (parsed?.isVerified) isVerified = parsed.isVerified;
          updateHUDCitizen(parsed);
        }
      } catch (_) {}

      // 2. Synchronize active session so logged-in citizens never appear as Visitor
      try {
        let sessionCitizen: any = null;
        if (supabase) {
          const { data: { session: sbSession } } = await supabase.auth.getSession();
          if (sbSession?.user) {
            const metadata = sbSession.user.user_metadata || {};
            const syncRes = await syncGithubAuth({
              githubId: sbSession.user.id,
              username: metadata.user_name || metadata.preferred_username || metadata.name,
              email: sbSession.user.email,
              avatarUrl: metadata.avatar_url,
              displayName: metadata.full_name || metadata.name || metadata.user_name,
            });
            if (syncRes?.citizen) {
              sessionCitizen = syncRes.citizen;
              if (syncRes.sessionToken) {
                localStorage.setItem('spot_session_token', syncRes.sessionToken);
              }
              if (syncRes.ownedSpot) {
                localStorage.setItem('spot_my_owned', JSON.stringify(syncRes.ownedSpot));
              }
            }
          }
        }

        if (!sessionCitizen) {
          const session = await fetchMySession();
          if (session?.citizen) {
            sessionCitizen = session.citizen;
            if (session.ownedSpot) {
              localStorage.setItem('spot_my_owned', JSON.stringify(session.ownedSpot));
            }
          }
        }

        if (sessionCitizen) {
          citizenId = sessionCitizen.id || citizenId;
          displayName = sessionCitizen.displayName || displayName;
          avatarId = sessionCitizen.avatarId || avatarId;
          isVerified = Boolean(sessionCitizen.isVerified || sessionCitizen.githubUrl || sessionCitizen.githubId);

          // Cache for instant 0ms restoration on future page visits
          localStorage.setItem('spot_my_citizen', JSON.stringify({
            id: citizenId,
            displayName,
            avatarId,
            isVerified,
          }));

          updateHUDCitizen({ displayName, isVerified, avatarId });
        }

        // Record visitor analytics hit
        recordVisit();
      } catch (_) {}

      // ── Start Engine with Authenticated Citizen Identity ─────────────────
      engine = new Engine({
        canvas,
        apiBase: API_BASE,
        citizenId,
        avatarId,
        displayName,
        isVerified,
        onCitizenClick: (spot) => openProfileModal(spot),
        onSecretClick: (secret) => {
          if (secret.id === 'dev_library') {
            (window as any).openLibraryModal?.();
          } else if (secret.id === 'retro_arcade') {
            (window as any).openArcadeModal?.();
          } else {
            openSecretModal(secret);
          }
        },
        onSecretDiscovered: (secret) => {
          if (secret.id === 'dev_library') {
            (window as any).openLibraryModal?.();
          } else if (secret.id === 'retro_arcade') {
            (window as any).openArcadeModal?.();
          } else {
            openSecretModal(secret);
          }
        },
        onBannerClick: (banner) => openBannerModal(banner),
        onNpcInteract: (npc) => openNpcModal(npc),
        onEmptyClick: (_gx, _gy) => {
          closeProfileModal();
          closeSecretModal();
          closeBannerModal();
          closeNpcModal();
          closeJournalModal();
          (window as any).closeLibraryModal?.();
          (window as any).closeArcadeModal?.();
        },
        onSnapshotLoaded: (snapshot) => {
          const claimedCountEl = document.getElementById('hud-claimed-count');
          if (claimedCountEl && typeof snapshot.claimedCount === 'number') {
            claimedCountEl.textContent = String(snapshot.claimedCount);
          }
          const onlineCountEl = document.getElementById('hud-online-count');
          if (onlineCountEl && typeof snapshot.onlineCount === 'number') {
            onlineCountEl.textContent = String(Math.max(1, snapshot.onlineCount));
          }
        },
        onPresenceChange: (onlineCount) => {
          const onlineCountEl = document.getElementById('hud-online-count');
          if (onlineCountEl) {
            onlineCountEl.textContent = String(Math.max(1, onlineCount));
          }
        },
      });

      // If session citizen was resolved, ensure engine has full identity & plot camera
      if (citizenId && displayName !== 'Visitor') {
        engine.updateCitizenIdentity({
          citizenId,
          displayName,
          avatarId,
          isVerified,
          teleportToSpot: true,
        });
      }

      // Sync initial weather HUD icon
      if (worldWeatherIcon && engine) {
        worldWeatherIcon.textContent = WEATHER_ICONS[engine.renderer.weather.getWeather()] || '✨';
      }

      function updateBillboardStatsHUD() {
        const total = WORLD_BANNERS.length;
        const sponsored = WORLD_BANNERS.filter(b => b.isSponsored).length;
        const ratioEl = document.getElementById('hud-sponsor-ratio');
        if (ratioEl) {
          ratioEl.textContent = `${sponsored}/${total}`;
        }
      }

      // ── Fetch Dynamic Billboard Sponsorships ──────────────────────────────
      async function syncActiveBanners() {
        try {
          const billboardRes = await fetch(`${API_BASE}/api/billboards/active`);
          if (billboardRes.ok) {
            const billboardData = await billboardRes.json();
            if (billboardData?.activeBanners) {
              applyActiveSponsorships(billboardData.activeBanners);
            }
          }
        } catch (_) {}
        updateBillboardStatsHUD();
      }

      // Check any recent pending ads configured on this device (within 30 mins)
      for (const b of WORLD_BANNERS) {
        try {
          const stored = localStorage.getItem('spot_pending_ad_' + b.id);
          if (stored) {
            const item = JSON.parse(stored);
            if (Date.now() - (item.timestamp || 0) < 30 * 60 * 1000) {
              applyActiveSponsorships([item]);
            }
          }
        } catch (_) {}
      }

      // Initial server sync
      await syncActiveBanners();

      loaderSub.textContent = 'Rendering Island…';
      await engine.init();

      // Ensure webhook delivery is caught with quick follow-up polls
      setTimeout(syncActiveBanners, 1200);
      setTimeout(syncActiveBanners, 3000);

      // ── Returning Sponsor Handling (Gumroad Redirect) ─────────────────────
      const queryParams = new URLSearchParams(window.location.search);
      const targetBillboardId = queryParams.get('billboard_id') || queryParams.get('billboard');
      if (targetBillboardId) {
        const targetBanner = WORLD_BANNERS.find((b) => b.id === targetBillboardId);
        if (targetBanner) {
          setTimeout(() => {
            if (!engine) return;
            const targetWx = targetBanner.gx * 16 + 8;
            const targetWy = targetBanner.gy * 16 + 8;
            engine.camera.centerOn(targetWx, targetWy, 1.4);
            showToast('🎉 Congratulations! Your cyber billboard is LIVE in Spot World!', 'success');
            setTimeout(() => {
              openBannerModal(targetBanner);
            }, 600);
          }, 700);
        }
      }

      // Sync initial HUD audio icon
      if (worldAudioIcon) {
        worldAudioIcon.textContent = engine.audio.muted ? '🔇' : '🔊';
      }

      // ── Chat & Emote Dock Wiring ──────────────────────────────────────────
      const chatForm = document.getElementById('world-chat-form') as HTMLFormElement | null;
      const chatInput = document.getElementById('world-chat-input') as HTMLInputElement | null;
      const emoteBtns = document.querySelectorAll('.emote-btn');

      emoteBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const emote = (btn as HTMLElement).dataset.emote;
          if (emote && engine) {
            engine.player.say(emote, 240);
          }
        });
      });

      chatForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!chatInput || !engine) return;
        const msg = chatInput.value.trim();
        if (!msg) return;

        if (containsBlockedWord(msg)) {
          showToast('Please keep chat messages kind & friendly! 🌸', 'error');
          return;
        }

        engine.player.say(msg, 360);
        chatInput.value = '';
        chatInput.blur();
      });

      // Emote numeric hotkeys (1-6) and Enter to focus chat
      window.addEventListener('keydown', (e) => {
        if (['input', 'textarea', 'select'].includes((e.target as HTMLElement)?.tagName?.toLowerCase())) {
          return;
        }

        // Don't trigger emotes or chat focus if any modal is open
        if (document.querySelector('.modal-backdrop.open, .modal-backdrop.is-open, .library-modal-backdrop.is-open, .search-backdrop.open')) {
          return;
        }

        const key = e.key;
        const emoteMap: Record<string, string> = {
          '1': '👋',
          '2': '☕',
          '3': '✨',
          '4': '❤️',
          '5': '🚀',
          '6': '🎮',
        };

        if (emoteMap[key] && engine) {
          engine.player.say(emoteMap[key], 240);
        } else if (key === 't' || key === '/') {
          e.preventDefault();
          chatInput?.focus();
        }
      });

      // ── Search Modal Wiring (Uses identical SearchModal.astro component) ─
      const searchBackdrop = document.getElementById('search-modal-backdrop');
      const searchCloseBtn = document.querySelector('.search-kbd') || document.getElementById('search-modal-close');
      const searchInput = (document.getElementById('search-input') || document.getElementById('citizen-search-input')) as HTMLInputElement | null;
      const searchStatus = document.getElementById('search-status');
      const searchResultsList = document.getElementById('search-results-list');
      const btnWorldSearch = document.getElementById('world-search-btn');

      let searchDebounceTimer: number | undefined;

      function openSearchModal(): void {
        if (!searchBackdrop) return;
        closeSecretModal();
        closeProfileModal();
        searchBackdrop.classList.add('open');
        searchBackdrop.setAttribute('aria-hidden', 'false');
        searchInput?.focus();
        if (searchInput && searchInput.value) {
          triggerSearch(searchInput.value);
        } else {
          if (searchResultsList) searchResultsList.innerHTML = '';
          if (searchStatus) {
            searchStatus.style.display = 'block';
            searchStatus.textContent = 'Type to search across citizens and spots...';
          }
        }
      }

      function closeSearchModal(): void {
        if (!searchBackdrop) return;
        searchBackdrop.classList.remove('open');
        searchBackdrop.setAttribute('aria-hidden', 'true');
      }

      btnWorldSearch?.addEventListener('click', (e) => {
        e.stopPropagation();
        openSearchModal();
      });

      // ── Grand Codex Library HUD Wiring & Deep-linking ─────────────────────
      const btnWorldLibrary = document.getElementById('world-library-btn');
      btnWorldLibrary?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeSearchModal();
        closeProfileModal();
        closeSecretModal();
        closeBannerModal();
        (window as any).openLibraryModal?.();
      });

      // Auto-open modal or glide camera if deep-linked via URL parameters
      function flyCameraToSpot(x: number, y: number): void {
        if (!engine) return;
        const targetWx = x * 16 + 8;
        const targetWy = y * 16 + 8;
        engine.camera.centerOn(targetWx, targetWy, 1.4);
        const plot = engine.plots.getPlotAt(x, y);
        if (plot) {
          engine.renderer.selectedCitizen = plot;
          setTimeout(() => {
            openProfileModal(plot);
          }, 350);
        }
      }

      async function flyCameraToCitizen(username: string): Promise<void> {
        if (!engine) return;
        try {
          const res = await fetch(`/api/citizens/search?q=${encodeURIComponent(username)}`);
          if (!res.ok) return;
          const data = await res.json();
          const match = data.results?.find((r: any) =>
            r.displayName?.toLowerCase() === username.toLowerCase() ||
            r.githubUrl?.toLowerCase().includes(username.toLowerCase())
          ) || data.results?.[0];

          if (match && typeof match.x === 'number' && typeof match.y === 'number') {
            flyCameraToSpot(match.x, match.y);
          }
        } catch (_) {}
      }

      const worldUrlParams = new URLSearchParams(window.location.search);
      if (worldUrlParams.get('modal') === 'library' || worldUrlParams.get('zone') === 'library') {
        setTimeout(() => {
          (window as any).openLibraryModal?.();
        }, 350);
      } else if (worldUrlParams.get('modal') === 'arcade' || worldUrlParams.get('game') === 'snake') {
        setTimeout(() => {
          (window as any).openArcadeModal?.();
        }, 350);
      } else if (worldUrlParams.get('modal') === 'share') {
        setTimeout(() => {
          (window as any).openShareModal?.();
        }, 350);
      } else if (worldUrlParams.has('spot')) {
        const parts = (worldUrlParams.get('spot') || '').split(',').map(Number);
        if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
          setTimeout(() => flyCameraToSpot(parts[0], parts[1]), 400);
        }
      } else if (worldUrlParams.has('citizen')) {
        const targetCitizen = (worldUrlParams.get('citizen') || '').trim();
        if (targetCitizen) {
          setTimeout(() => flyCameraToCitizen(targetCitizen), 400);
        }
      }

      searchCloseBtn?.addEventListener('click', closeSearchModal);
      searchBackdrop?.addEventListener('click', (e) => {
        if (e.target === searchBackdrop) closeSearchModal();
      });

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (searchBackdrop?.classList.contains('open')) {
            closeSearchModal();
          } else {
            openSearchModal();
          }
        }
        if (e.key === 'Escape' && searchBackdrop?.classList.contains('open')) {
          closeSearchModal();
        }
      });

      async function triggerSearch(rawQuery: string): Promise<void> {
        const q = rawQuery.trim();
        if (!q) {
          if (searchResultsList) searchResultsList.innerHTML = '';
          if (searchStatus) {
            searchStatus.style.display = 'block';
            searchStatus.textContent = 'Type to search across citizens and spots...';
          }
          return;
        }

        if (searchStatus) {
          searchStatus.style.display = 'block';
          searchStatus.textContent = 'Searching...';
        }

        if (searchDebounceTimer) window.clearTimeout(searchDebounceTimer);
        searchDebounceTimer = window.setTimeout(async () => {
          if (!searchResultsList || !searchStatus || !engine) return;

          // 1. Fetch search results from database/API
          let results = await searchCitizens(q).catch(() => []);

          // 2. Also check local live entities in the engine
          if (results.length === 0) {
            const allPlots = engine.plots.getAllPlots();
            const lower = q.toLowerCase();
            const localMatches = allPlots
              .filter((p) => {
                const name = p.owner.displayName?.toLowerCase() || '';
                const tag = p.owner.tagline?.toLowerCase() || '';
                const coords = `${p.owner.x},${p.owner.y}`;
                return name.includes(lower) || tag.includes(lower) || coords.includes(lower);
              })
              .map((p) => ({
                id: p.owner.spotId,
                x: p.owner.x,
                y: p.owner.y,
                avatarId: p.owner.avatarId,
                displayName: p.owner.displayName,
                tagline: p.owner.tagline,
                isVerified: p.owner.isVerified,
                githubUrl: p.owner.githubUrl,
              }));
            results = localMatches as any;
          }

          searchResultsList.innerHTML = '';

          if (results.length === 0) {
            searchStatus.style.display = 'block';
            searchStatus.textContent = `No citizens or spots found matching "${q}"`;
          } else {
            searchStatus.style.display = 'none';

            results.forEach((item: any) => {
              const row = document.createElement('div');
              row.className = 'search-result-item';

              const avatarCanvas = document.createElement('canvas');
              avatarCanvas.width = 32;
              avatarCanvas.height = 32;
              avatarCanvas.className = 'search-result-avatar';
              const actx = avatarCanvas.getContext('2d');
              if (actx) {
                const def = AVATAR_CATALOG[item.avatarId] ?? AVATAR_CATALOG.astronaut;
                if (item.customAvatarData) {
                  drawCustomAvatarOnCanvas(actx, item.customAvatarData, 0, 0, 32);
                } else {
                  drawAvatarOnCanvas(actx, def, 0, 0, 32);
                }
              }

              const left = document.createElement('div');
              left.className = 'search-result-left';
              left.appendChild(avatarCanvas);

              const meta = document.createElement('div');
              meta.className = 'search-result-meta';

              const nameSpan = document.createElement('div');
              nameSpan.className = 'search-result-name';
              nameSpan.textContent = item.displayName;

              if (item.isVerified || item.githubUrl) {
                const badge = document.createElement('span');
                badge.style.color = '#38bdf8';
                badge.style.fontSize = '0.78rem';
                badge.textContent = ' ✓';
                nameSpan.appendChild(badge);
              }

              const taglineSpan = document.createElement('div');
              taglineSpan.className = 'search-result-tagline';
              taglineSpan.textContent = item.tagline || (item.githubUrl ? `@${item.githubUrl}` : 'Citizen of Spot World');

              meta.append(nameSpan, taglineSpan);
              left.appendChild(meta);

              const spotBadge = document.createElement('div');
              spotBadge.className = 'search-result-spot';
              spotBadge.textContent = `(${item.x}, ${item.y})`;

              row.append(left, spotBadge);

              // Click to Jump to Citizen & Inspect
              row.addEventListener('click', (e) => {
                e.stopPropagation();
                const gx = Number(item.x);
                const gy = Number(item.y);
                if (isNaN(gx) || isNaN(gy)) return;

                closeSearchModal();

                if (engine) {
                  engine.flyTo(gx, gy, 1.4);
                  engine.renderer.gpsTarget = {
                    name: item.displayName,
                    wx: gx * 48 + 24,
                    wy: gy * 32 + 16,
                  };
                }

                const targetSpot: OccupiedSpotSummary = (engine ? engine.plots.getSpotAt(gx, gy) : null) || {
                  spotId: item.spotId || item.id || `${gx},${gy}`,
                  x: gx,
                  y: gy,
                  citizenId: item.id || item.citizenId || '',
                  displayName: item.displayName,
                  tagline: item.tagline,
                  avatarId: item.avatarId || 'astronaut',
                  customAvatarData: item.customAvatarData,
                  websiteUrl: item.websiteUrl,
                  twitterUrl: item.twitterUrl || item.twitterHandle,
                  facebookUrl: item.facebookUrl || item.facebookHandle,
                  instagramUrl: item.instagramUrl || item.instagramHandle,
                  linkedinUrl: item.linkedinUrl || item.linkedinHandle,
                  youtubeUrl: item.youtubeUrl || item.youtubeHandle,
                  githubUrl: item.githubUrl,
                  isVerified: item.isVerified,
                  claimedAt: item.claimedAt || new Date().toISOString(),
                };

                if (engine) {
                  engine.renderer.selectedCitizen = targetSpot;
                }

                try {
                  openProfileModal(targetSpot);
                } catch (err) {
                  console.error('Failed to open profile modal:', err);
                }
              });

              searchResultsList.appendChild(row);
            });
          }
        }, 220);
      }

      searchInput?.addEventListener('input', (e) => {
        triggerSearch((e.target as HTMLInputElement).value);
      });

      // Update HUD coordinate & zoom display
      setInterval(() => {
        if (!engine) return;

        const pct = Math.round(engine.camera.zoom * 100);
        if (zoomLevel) zoomLevel.textContent = `${pct}%`;

        const hov = engine.renderer.hoveredGrid;
        if (coordText) {
          coordText.textContent = hov ? `(${hov.gx}, ${hov.gy})` : '—';
        }
      }, 100);

      // Hide loader
      loader.classList.add('hidden');
      setTimeout(() => { loader.style.display = 'none'; }, 500);

    } catch (err) {
      console.error('[SpotWorld] Boot failed:', err);
      loaderSub.textContent = 'Failed to load world. Please refresh.';
      showToast('Could not load Spot World. Check your connection.', 'error');
    }
  }

  // ── HUD button handlers ───────────────────────────────────────────────────
  btnZoomIn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;
    const newZ = Math.min(engine.camera.maxZoom, engine.camera.targetZoom * 1.3);
    engine.camera.centerOn(engine.camera.targetX, engine.camera.targetY, newZ);
  });

  btnZoomOut?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;
    const newZ = Math.max(engine.camera.minZoom, engine.camera.targetZoom / 1.3);
    engine.camera.centerOn(engine.camera.targetX, engine.camera.targetY, newZ);
  });

  btnRecenter?.addEventListener('click', (e) => {
    e.stopPropagation();
    engine?.flyTo(52, 60, 1.0);
  });

  // ── Audio Ambience Toggle ────────────────────────────────────────────────
  const btnWorldAudio = document.getElementById('world-audio-btn');
  const worldAudioIcon = document.getElementById('world-audio-icon');

  btnWorldAudio?.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (!engine) return;
    const isMuted = await engine.audio.toggleMute();
    if (worldAudioIcon) {
      worldAudioIcon.textContent = isMuted ? '🔇' : '🔊';
    }
    showToast(isMuted ? 'Environmental sound muted' : '🍃 Natural air, breeze & birds enabled', 'info');
  });

  // ── Time of Day Switcher ─────────────────────────────────────────────────
  const btnWorldTod = document.getElementById('world-tod-btn');
  const worldTodIcon = document.getElementById('world-tod-icon');

  const TOD_MODES: Array<'night' | 'day' | 'twilight'> = ['night', 'day', 'twilight'];
  const TOD_ICONS: Record<'night' | 'day' | 'twilight', string> = {
    night: '🌙',
    day: '☀️',
    twilight: '🌆',
  };
  const TOD_LABELS: Record<'night' | 'day' | 'twilight', string> = {
    night: '🌙 Cozy Neon Night',
    day: '☀️ Sunlit Daytime',
    twilight: '🌆 Golden Sunset Twilight',
  };

  btnWorldTod?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;

    const current = engine.renderer.timeOfDay;
    const nextIdx = (TOD_MODES.indexOf(current) + 1) % TOD_MODES.length;
    const next = TOD_MODES[nextIdx];

    engine.renderer.timeOfDay = next;
    if (worldTodIcon) {
      worldTodIcon.textContent = TOD_ICONS[next];
    }
    showToast(TOD_LABELS[next], 'info');
  });

  // ── Dynamic Weather Switcher (Clear / Neon Rain / Cyber Motes) ──────────────
  const btnWorldWeather = document.getElementById('world-weather-btn');
  const worldWeatherIcon = document.getElementById('world-weather-icon');

  const WEATHER_MODES: Array<'clear' | 'rain' | 'motes'> = ['clear', 'rain', 'motes'];
  const WEATHER_ICONS: Record<'clear' | 'rain' | 'motes', string> = {
    clear: '☀️',
    rain: '🌧️',
    motes: '✨',
  };
  const WEATHER_LABELS: Record<'clear' | 'rain' | 'motes', string> = {
    clear: '☀️ Clear Cyber Skies',
    rain: '🌧️ Neon Rainstorm with Ground Ripples',
    motes: '✨ Floating Cyber Fireflies & Motes',
  };

  btnWorldWeather?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!engine) return;

    const current = engine.renderer.weather.getWeather();
    const nextIdx = (WEATHER_MODES.indexOf(current) + 1) % WEATHER_MODES.length;
    const next = WEATHER_MODES[nextIdx];

    engine.renderer.weather.setWeather(next);
    if (worldWeatherIcon) {
      worldWeatherIcon.textContent = WEATHER_ICONS[next];
    }
    showToast(WEATHER_LABELS[next], 'info');
  });

  // ── HUD Citizen Identity & 1-Click Sign-In ─────────────────────────────────
  function updateHUDCitizen(c: { displayName?: string; isVerified?: boolean; avatarId?: string } | null) {
    const btn = document.getElementById('world-citizen-btn');
    const nameEl = document.getElementById('world-citizen-name');
    const badgeEl = document.getElementById('world-citizen-badge');
    const iconEl = document.getElementById('world-citizen-icon');
    if (!btn || !nameEl) return;

    if (c && c.displayName && c.displayName !== 'Visitor') {
      nameEl.textContent = c.displayName;
      if (iconEl) iconEl.textContent = '👤';
      if (badgeEl) {
        badgeEl.style.display = c.isVerified ? 'inline-block' : 'none';
      }
      btn.classList.add('is-authenticated');
      btn.title = `Signed in as ${c.displayName} (Click to view profile)`;
    } else {
      nameEl.textContent = 'Sign In';
      if (iconEl) iconEl.textContent = '⚡';
      if (badgeEl) badgeEl.style.display = 'none';
      btn.classList.remove('is-authenticated');
      btn.title = 'Sign In with GitHub';
    }
  }

  const btnWorldCitizen = document.getElementById('world-citizen-btn');
  btnWorldCitizen?.addEventListener('click', async () => {
    const saved = localStorage.getItem('spot_my_citizen');
    let currentCitizen = saved ? JSON.parse(saved) : null;
    if (currentCitizen?.displayName && currentCitizen.displayName !== 'Visitor') {
      // Find citizen's spot from world snapshot or API to open full profile modal
      let spotSummary: any = null;
      if (engine?.lastSnapshot?.occupied) {
        spotSummary = engine.lastSnapshot.occupied.find((s) => s.citizenId === currentCitizen.id);
      }
      if (!spotSummary) {
        try {
          const res = await fetch(`${API_BASE}/api/citizens/me`, { credentials: 'include' });
          if (res.ok) {
            const data = await res.json();
            if (data.citizen) {
              spotSummary = {
                ...data.citizen,
                spotId: data.ownedSpot ? `${data.ownedSpot.x},${data.ownedSpot.y}` : undefined,
                x: data.ownedSpot?.x ?? 52,
                y: data.ownedSpot?.y ?? 60,
                citizenId: data.citizen.id,
              };
            }
          }
        } catch (_) {}
      }

      if (spotSummary) {
        openProfileModal(spotSummary);
      } else {
        openProfileModal({
          spotId: '52,60',
          x: 52,
          y: 60,
          citizenId: currentCitizen.id,
          displayName: currentCitizen.displayName,
          avatarId: currentCitizen.avatarId || 'astronaut',
          isVerified: currentCitizen.isVerified,
        } as any);
      }
    } else {
      // 1-Click GitHub Sign In
      if (supabase) {
        showToast('Connecting to GitHub…', 'info');
        await supabase.auth.signInWithOAuth({
          provider: 'github',
          options: {
            redirectTo: `${window.location.origin}/world`,
          },
        });
      }
    }
  });

  const btnHudSponsor = document.getElementById('hud-sponsor-pill');
  btnHudSponsor?.addEventListener('click', (e) => {
    e.stopPropagation();
    const openBanner = WORLD_BANNERS.find((b) => !b.isSponsored && b.id !== 'banner_founder_showcase');
    if (openBanner && engine) {
      engine.camera.centerOn(openBanner.gx * 16 + 8, openBanner.gy * 16 + 8, 1.4, true);
      showToast(`📍 Showing available billboard: ${openBanner.name}`, 'info');
      setTimeout(() => openBannerModal(openBanner), 600);
    } else {
      showToast('All billboards currently occupied! Check back soon.', 'info');
    }
  });

  // Listen to Supabase GitHub auth events live
  if (supabase) {
    supabase.auth.onAuthStateChange(async (event, session) => {
      if ((event === 'SIGNED_IN' || event === 'INITIAL_SESSION') && session?.user) {
        const user = session.user;
        const metadata = user.user_metadata || {};
        try {
          const syncRes = await syncGithubAuth({
            githubId: user.id,
            username: metadata.user_name || metadata.preferred_username || metadata.name,
            email: user.email,
            avatarUrl: metadata.avatar_url,
            displayName: metadata.full_name || metadata.name || metadata.user_name,
          });

          if (syncRes?.citizen) {
            const cit = syncRes.citizen;
            cit.isVerified = Boolean(cit.isVerified || cit.githubUrl || (cit as any).githubId);
            if (syncRes.sessionToken) {
              localStorage.setItem('spot_session_token', syncRes.sessionToken);
            }
            localStorage.setItem('spot_my_citizen', JSON.stringify({
              id: cit.id,
              displayName: cit.displayName,
              avatarId: cit.avatarId,
              isVerified: cit.isVerified,
            }));
            if (syncRes.ownedSpot) {
              localStorage.setItem('spot_my_owned', JSON.stringify(syncRes.ownedSpot));
            }
            engine?.updateCitizenIdentity({
              citizenId: cit.id,
              displayName: cit.displayName,
              avatarId: cit.avatarId,
              isVerified: cit.isVerified,
              teleportToSpot: true,
            });
            updateHUDCitizen(cit);
            showToast(`👋 Welcome back, ${cit.displayName}!`, 'success');
          }
        } catch (err) {
          console.error('Failed to sync auth in world:', err);
        }
      }
    });
  }

  // ── Boot ─────────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => { void boot(); });

  document.addEventListener('astro:before-swap', () => {
    engine?.destroy();
    engine = null;
  });
</script>
