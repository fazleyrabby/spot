---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Lost in Cyberspace — SPOT" description="You have drifted beyond the 100x100 grid. Coordinates not found.">
  <main class="error-page">
    <!-- Starry cyber background particles -->
    <div class="stars-backdrop" aria-hidden="true">
      <div class="grid-overlay"></div>
      <div class="scanline"></div>
    </div>

    <div class="error-container glass-panel">
      <!-- Top Telemetry Header -->
      <div class="telemetry-bar mono-num">
        <span class="status-indicator">
          <span class="pulse-dot"></span>
          <span>SYS_ALERT: OUT_OF_BOUNDS</span>
        </span>
        <span class="telemetry-coords">GRID: [???, ???]</span>
      </div>

      <!-- Animated Pixel Astronaut Graphic -->
      <div class="astronaut-scene" aria-hidden="true">
        <div class="floating-astronaut">
          <!-- Procedural 8-bit Astronaut Vector -->
          <svg width="84" height="84" viewBox="0 0 24 24" fill="none" class="pixel-astronaut">
            <!-- Helmet & Visor -->
            <rect x="7" y="3" width="10" height="9" rx="3" fill="#e2e8f0" stroke="#090b10" stroke-width="1.2" />
            <rect x="9" y="5" width="6" height="4" rx="1.5" fill="#00f0ff" />
            <rect x="10" y="6" width="2" height="1" fill="#ffffff" opacity="0.8" />
            <!-- Suit Body -->
            <rect x="6" y="12" width="12" height="8" rx="2" fill="#cbd5e1" stroke="#090b10" stroke-width="1.2" />
            <!-- Chest Pack -->
            <rect x="9" y="14" width="6" height="4" rx="1" fill="#334155" />
            <circle cx="11" cy="16" r="0.8" fill="#ef4444" />
            <circle cx="13" cy="16" r="0.8" fill="#22c55e" />
            <!-- Limbs -->
            <rect x="3" y="13" width="3" height="5" rx="1.5" fill="#94a3b8" />
            <rect x="18" y="13" width="3" height="5" rx="1.5" fill="#94a3b8" />
            <rect x="7" y="20" width="3" height="3" rx="1" fill="#64748b" />
            <rect x="14" y="20" width="3" height="3" rx="1" fill="#64748b" />
          </svg>
          <!-- Floating cosmic dust / tether -->
          <div class="tether-spark"></div>
        </div>
      </div>

      <!-- Error Content -->
      <div class="error-badge mono-num">ERROR: 404</div>
      <h1 class="error-title">Lost in Cyberspace</h1>
      <p class="error-desc">
        You've drifted past the outer boundary of the <strong>100×100 grid</strong>.
        There are no plots, monuments, or citizens registered at these coordinates.
      </p>

      <!-- Action Buttons -->
      <div class="error-actions">
        <a href="/" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Return to Grid</span>
        </a>
        <a href="/world/" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="12 8 8 12 12 16 12 8"></polygon>
            <polygon points="12 8 16 12 12 16 12 8"></polygon>
          </svg>
          <span>Explore World</span>
        </a>
      </div>

      <!-- Footnote -->
      <div class="error-footer mono-num">
        <span>SECTOR: VOID_UNKNOWN</span>
        <span class="dot-separator">•</span>
        <span>STATUS: 0 CITIZENS ONLINE HERE</span>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
    background: #090b10;
    overflow: hidden;
    color: #e2e8f0;
  }

  /* Starry Backdrop & Cyber Grid */
  .stars-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: 
      radial-gradient(2px 2px at 20px 30px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 40px 70px, rgba(255,255,255,0.7), rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 90px 40px, #00f0ff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 160px 120px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 230px 190px, rgba(255,255,255,0.5), rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 300px 90px, #f59e0b, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 350px 350px;
    opacity: 0.6;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
  }

  .scanline {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%, 
      rgba(0, 0, 0, 0.25) 50%
    );
    background-size: 100% 4px;
    opacity: 0.4;
  }

  /* Glass Card */
  .error-container {
    position: relative;
    z-index: 10;
    max-width: 480px;
    width: 100%;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2.25rem 2rem;
    text-align: center;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 35px rgba(0, 240, 255, 0.08);
    animation: fadeInScale 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Telemetry Top Bar */
  .telemetry-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    letter-spacing: 0.05em;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #f59e0b;
    font-weight: 600;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Drifting Astronaut Animation */
  .astronaut-scene {
    position: relative;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .floating-astronaut {
    animation: floatDrift 4.5s ease-in-out infinite;
    filter: drop-shadow(0 10px 15px rgba(0, 240, 255, 0.2));
  }

  @keyframes floatDrift {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(6deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  /* Error Content */
  .error-badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #f87171;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .error-title {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem 0;
    background: linear-gradient(135deg, #ffffff 40%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #94a3b8;
    margin: 0 0 1.75rem 0;
  }

  .error-desc strong {
    color: #e2e8f0;
  }

  /* Buttons */
  .error-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-primary {
    background: #00f0ff;
    color: #090b10;
    box-shadow: 0 4px 14px rgba(0, 240, 255, 0.3);
  }

  .btn-primary:hover {
    background: #5df6ff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 240, 255, 0.45);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  /* Footnote */
  .error-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: #64748b;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
    letter-spacing: 0.06em;
  }

  .dot-separator {
    color: #475569;
  }

  @media (max-width: 480px) {
    .error-container {
      padding: 1.75rem 1.25rem;
    }
    .error-actions {
      flex-direction: column;
    }
    .btn-primary, .btn-secondary {
      justify-content: center;
    }
  }
</style>
