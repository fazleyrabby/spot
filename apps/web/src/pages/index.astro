        spot_id: spotId,
        spot_x: currentTargetSpot.x,
        spot_y: currentTargetSpot.y,
        method: 'manual',
      });

      const worldPos = renderer.grid.gridToWorld(currentTargetSpot.x, currentTargetSpot.y);
      renderer.camera.centerOn(worldPos.x + 18, worldPos.y + 18, 2.2);
      renderer.selectSpot(currentTargetSpot.x, currentTargetSpot.y);
    } catch (err: any) {
      if (isServerOfflineError(err)) {
        showModalOfflineState();
        showToast('⚡ Server is recharging. Your spot and form are safely held. Auto-retrying...', 'info');
      } else {
        hideModalOfflineState();
        showToast(err.message || 'Failed to claim spot', 'error');
      }
    } finally {
      submitClaimBtn.disabled = false;
      submitClaimBtn.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Claim This Spot</span>
      `;
    }
  });

  // 10d. Device Sync / QR Code Transfer Modal Controller
  const btnOpenTransfer = document.getElementById('btn-open-transfer');
  const transferModalBackdrop = document.getElementById('transfer-modal-backdrop');
  const transferModalClose = document.getElementById('transfer-modal-close');
  const transferQrCanvas = document.getElementById('transfer-qr-canvas') as HTMLCanvasElement;
  const transferLinkInput = document.getElementById('transfer-link-input') as HTMLInputElement;
  const btnCopyTransfer = document.getElementById('btn-copy-transfer');
  const txtCopyTransfer = document.getElementById('txt-copy-transfer');

  btnOpenTransfer?.addEventListener('click', async () => {
    let token: string | null = localStorage.getItem('spot_session_token');
    const citizenId: string | undefined = myCitizen?.id || localStorage.getItem('spot_citizen_id') || currentViewingOccupied?.citizenId;
    if (!token && citizenId) token = citizenId;

    if (!token && !citizenId) {
      showToast('Please claim a spot first to sync devices', 'error');
      return;
    }

    const currentSpot = myOwnedSpot || (currentViewingOccupied ? { id: currentViewingOccupied.spotId, x: currentViewingOccupied.x, y: currentViewingOccupied.y } : null);
    if (!currentSpot) {
      showToast('No spot owned to sync', 'error');
      return;
    }

    const transferUrl = `${window.location.origin}/?auth_key=${encodeURIComponent(token || '')}&cit_id=${encodeURIComponent(citizenId || '')}&spot=${currentSpot.x},${currentSpot.y}&spot_id=${encodeURIComponent(currentSpot.id || '')}`;

    if (transferLinkInput) {
      transferLinkInput.value = transferUrl;
    }

    if (transferQrCanvas) {
      try {
        await QRCode.toCanvas(transferQrCanvas, transferUrl, {
          width: 180,
          margin: 1,
          color: {
            dark: '#0c0e14',
            light: '#ffffff',
          },
        });
      } catch (err) {
        console.error('QR code generation error:', err);
      }
    }

    if (transferModalBackdrop) {
      transferModalBackdrop.classList.add('open');
      transferModalBackdrop.setAttribute('aria-hidden', 'false');
    }
  });

  transferModalClose?.addEventListener('click', () => {
    transferModalBackdrop?.classList.remove('open');
    transferModalBackdrop?.setAttribute('aria-hidden', 'true');
  });

  transferModalBackdrop?.addEventListener('click', (e) => {
    if (e.target === transferModalBackdrop) {
      transferModalBackdrop.classList.remove('open');
      transferModalBackdrop.setAttribute('aria-hidden', 'true');
    }
  });

  btnCopyTransfer?.addEventListener('click', () => {
    if (transferLinkInput && transferLinkInput.value) {
      navigator.clipboard.writeText(transferLinkInput.value).then(() => {
        if (txtCopyTransfer) txtCopyTransfer.textContent = 'Copied!';
        showToast('🔗 Sync link copied to clipboard!', 'success');
        setTimeout(() => {
          if (txtCopyTransfer) txtCopyTransfer.textContent = 'Copy Link';
        }, 2000);
      });
    }
  });

  // 11. Live Realtime Stream (Instant Sync across all tabs & devices)
  let supabaseChannel: any = null;
  let apiEventSource: EventSource | null = null;

  function connectApiActivityStream(tabId: string): boolean {
    const apiSseEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_SSE === 'true' || !import.meta.env.SSR;
    if (!API_BASE || !apiSseEnabled || apiEventSource) return Boolean(apiEventSource);
    const token = localStorage.getItem('spot_session_token');
    const params = new URLSearchParams({ tabId });
    if (token) params.set('token', token);
    apiEventSource = new EventSource(`${API_BASE}/realtime/stream?${params.toString()}`, { withCredentials: true });
    apiEventSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        if (data.type === 'presence') {
          if (hudOnlineCount) hudOnlineCount.textContent = String(data.onlineCount ?? 0);
          const onlineIds = new Set<string>(data.onlineCitizenIds || []);
          worldSnapshot.occupied.forEach((spot) => {
            spot.isOnline = onlineIds.has(spot.citizenId);
          });
          renderer.setSnapshot(worldSnapshot);
        } else if (data.type === 'spot_claimed' && data.citizen && data.spot) {
          showActivity(activityFromSpot({
            displayName: data.citizen.displayName,
            x: data.spot.x,
            y: data.spot.y,
          }));
          const myId = myCitizen?.id || localStorage.getItem('spot_citizen_id');
          if (myId && data.neighborCitizenIds?.includes(myId)) {
            showToast(`👋 Your new neighbor @${data.citizen.displayName} claimed (${data.spot.x}, ${data.spot.y})`, 'success');
          }
          void refreshWorldFromApi();
        } else if (data.type === 'profile_updated' && data.citizen) {
          showActivity(`✏️ @${data.citizen.displayName} updated their profile`);
          void refreshWorldFromApi();
        } else if (data.type === 'spot_released' && data.spotId) {
          showActivity(`↩ Spot ${data.spotId} is available again`);
          void refreshWorldFromApi();
        } else if (data.type === 'comment_posted' && data.comment && data.spotId) {
          showActivity(`💬 @${data.comment.authorName} posted on Spot ${data.spotId}`);
          if (currentViewingOccupied?.spotId === data.spotId) void loadSpotComments(data.spotId);
        }
      } catch {}
    };
    apiEventSource.onerror = () => {
      apiEventSource?.close();
      apiEventSource = null;
    };
    return true;
  }
  function connectRealtimeStream() {
    let tabId = localStorage.getItem('spot_presence_id');
    if (!tabId) {
      tabId = Math.random().toString(36).substring(2, 9);
      localStorage.setItem('spot_presence_id', tabId);
    }

    connectApiActivityStream(tabId);
  }

  function disconnectRealtime() {
    if (apiEventSource) {
      apiEventSource.close();
      apiEventSource = null;
    }
    if (supabaseChannel) {
      try { supabase.removeChannel(supabaseChannel); } catch {}
      supabaseChannel = null;
    }
    try { renderer.destroy(); } catch {}
  }

  window.addEventListener('beforeunload', disconnectRealtime);
  // Astro HMR / Vite dev: clean up on hot reload to avoid leaked channels
  if (import.meta.hot) {
    import.meta.hot.dispose(disconnectRealtime);
  }

  connectRealtimeStream();
</script>

