  function renderSpotComments(comments: SpotComment[]): void {
    if (!spotWallComments) return;
    spotWallComments.replaceChildren();
    if (comments.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'spot-wall-empty';
      empty.textContent = 'Be the first to leave a note.';
      spotWallComments.appendChild(empty);
      return;
    }
    comments.forEach((comment) => {
      const item = document.createElement('article');
      item.className = 'spot-wall-comment';
      const meta = document.createElement('div');
      meta.className = 'spot-wall-comment-meta';
      const author = document.createElement('span');
      author.className = 'spot-wall-comment-author';
      author.textContent = `@${comment.authorName}`;
      const time = document.createElement('time');
      time.textContent = `• ${new Date(comment.createdAt).toLocaleDateString()}`;
      meta.append(author, time);
      const body = document.createElement('p');
      body.className = 'spot-wall-comment-body';
      body.textContent = comment.body;
      item.append(meta, body);
      spotWallComments.appendChild(item);
    });
  }

  async function loadSpotComments(spotId: string): Promise<void> {
    if (!spotWallComments) return;
    spotWallComments.textContent = 'Loading wall...';
    try {
      const wall = await fetchSpotComments(spotId);
      renderSpotComments(wall.comments);
      const localOwner = Boolean(
        currentViewingOccupied && (
          myCitizen?.id === currentViewingOccupied.citizenId ||
          myOwnedSpot?.id === spotId ||
          localStorage.getItem('spot_citizen_id') === currentViewingOccupied.citizenId
        )
      );
      updateSpotWallComposer(currentViewingOccupied!, wall.isOwner || localOwner, wall.canPost, wall.visibility);
    } catch {
      spotWallComments.textContent = 'The wall is unavailable right now.';
    }
  }

  function updateSpotWallComposer(occupied: OccupiedSpotSummary, isOwner: boolean, canPost = false, visibility: 'open' | 'readonly' = 'readonly'): void {
    const hasSession = Boolean(myCitizen || localStorage.getItem('spot_session_token'));
    const ownSpot = isOwner || Boolean(myCitizen?.id === occupied.citizenId);
    if (spotWallForm) {
      const showComposer = canPost && !ownSpot;
      spotWallForm.hidden = !showComposer;
      spotWallForm.style.display = showComposer ? 'grid' : 'none';
    }
    if (spotWallSelfNote) {
      spotWallSelfNote.hidden = canPost && !ownSpot;
      spotWallSelfNote.style.display = canPost && !ownSpot ? 'none' : 'block';
      spotWallSelfNote.textContent = ownSpot
        ? 'This is your spot. Visitors can leave notes here.'
        : 'This wall is read-only until the owner opens it.';
    }
    if (btnToggleWall) {
      btnToggleWall.style.display = isOwner ? 'inline-flex' : 'none';
      btnToggleWall.textContent = visibility === 'open' ? 'Close Visitor Messages' : 'Open Visitor Messages';
      btnToggleWall.dataset.visibility = visibility;
    }
    if (btnInviteNeighbor) btnInviteNeighbor.style.display = isOwner ? 'inline-flex' : 'none';
    if (spotWallAuthor) {
      spotWallAuthor.hidden = hasSession;
      spotWallAuthor.value = hasSession ? (myCitizen?.displayName || '') : '';
      spotWallAuthor.placeholder = hasSession ? 'Posting from your profile' : 'Your name';
    }
  }

