---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SpotCanvas from '../components/SpotCanvas.astro';
import ProfileModal from '../components/ProfileModal.astro';
import ClaimModal from '../components/ClaimModal.astro';
import SearchModal from '../components/SearchModal.astro';
import SupportModal from '../components/SupportModal.astro';
import AboutModal from '../components/AboutModal.astro';
import TransferModal from '../components/TransferModal.astro';
import ShareModal from '../components/ShareModal.astro';
---

<Layout>
  <main class="spot-app">
    <Header />
    <SpotCanvas />
    <ProfileModal />
    <ClaimModal />
    <SearchModal />
    <SupportModal />
    <AboutModal />
    <TransferModal />
    <ShareModal />
    <div id="toast-container" class="toast-container"></div>
  </main>
</Layout>

<script>
  import QRCode from 'qrcode';
  import { API_BASE, fetchWorldSnapshot, fetchMySession, claimSpot, searchCitizens, updateMyProfile, deleteMyAccount, syncGithubAuth, fetchSpotComments, postSpotComment, updateSpotWall, registerPasskey, authenticateWithPasskey, isServerOfflineError, checkServerHealth, recordVisit, type CitizenSearchResult, type SpotComment } from '../api/client.js';
  import { containsBlockedWord, formatSocialUrl } from '@spot/shared';
  import { supabase, signInWithGitHub, getSupabaseUser } from '../api/supabase.js';
  import { getDeviceFingerprint } from '../api/fingerprint.js';
  import { WorldCanvasRenderer } from '../canvas/renderer.js';
  import { CanvasInputHandler } from '../canvas/input.js';
  import { AVATAR_CATALOG, getAvatar, drawAvatarOnCanvas, drawCustomAvatarOnCanvas } from '../canvas/avatars.js';
  import { pixelizeImage } from '../canvas/pixelizer.js';
  import type { OccupiedSpotSummary, WorldSnapshot, Citizen } from '@spot/shared';

  // 1. Toast Notification Helper
  function showToast(message: string, type: 'error' | 'success' | 'info' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `toast toast-${type} glass-panel`;
    toast.textContent = message;
    container.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  function trackEvent(eventName: string, params: Record<string, unknown> = {}) {
    const fn = (window as any).gtag;
    if (typeof fn === 'function') fn('event', eventName, params);
  }

  // 2. DOM Selectors
  const canvas = document.getElementById('spot-canvas') as HTMLCanvasElement;
  const coordPill = document.getElementById('coord-pill');
  const coordText = document.getElementById('coord-text');
  const coordStatus = document.getElementById('coord-status');
  const coordDistrict = document.getElementById('coord-district');
  const coordPrime = document.getElementById('coord-prime');
  const coordVerifiedBadge = document.getElementById('coord-verified-badge');
  const hudClaimedCount = document.getElementById('hud-claimed-count');
  const hudOnlineCount = document.getElementById('hud-online-count');
  const hudVisitorsCount = document.getElementById('hud-visitors-count');
  const activityText = document.getElementById('activity-text');
  const worldLoader = document.getElementById('world-loader');
  const headerClaimBtn = document.getElementById('header-claim-btn') as HTMLButtonElement;
  function setHeaderClaimBtnState(fullText: string, shortText?: string) {
    if (!headerClaimBtn) return;
    headerClaimBtn.innerHTML = `
      <svg class="claim-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span class="claim-full-label">${fullText}</span>
      <span class="claim-short-label">${shortText || fullText}</span>
    `;
  }
  const btnAddPasskey = document.getElementById('btn-add-passkey') as HTMLButtonElement;
  const btnUsePasskey = document.getElementById('btn-use-passkey') as HTMLButtonElement;
  const headerSearchBtn = document.getElementById('header-search-btn') as HTMLButtonElement;

  // Nav Buttons
  const btnZoomIn = document.getElementById('btn-zoom-in');
  const btnZoomOut = document.getElementById('btn-zoom-out');
  const btnRecenter = document.getElementById('btn-recenter');

  // Profile Modal Elements
  const profileBackdrop = document.getElementById('profile-modal-backdrop');
  const profileCloseBtn = document.getElementById('profile-modal-close');
  const profileViewSection = document.getElementById('profile-view-section');
  const profileEditSection = document.getElementById('profile-edit-section');
  const profileAvatarCanvas = document.getElementById('profile-avatar-canvas') as HTMLCanvasElement;
  const profileSpotId = document.getElementById('profile-spot-id');
  const profileName = document.getElementById('profile-name');
  const profileVerifiedBadge = document.getElementById('profile-verified-badge');
  const profilePresence = document.getElementById('profile-presence');
  const profileTagline = document.getElementById('profile-tagline');
  const spotWallComments = document.getElementById('spot-wall-comments');
  const spotWallForm = document.getElementById('spot-wall-form') as HTMLFormElement;
  const spotWallAuthor = document.getElementById('spot-wall-author') as HTMLInputElement;
  const spotWallBody = document.getElementById('spot-wall-body') as HTMLInputElement;
  const spotWallSubmit = document.getElementById('spot-wall-submit') as HTMLButtonElement;
  const spotWallSelfNote = document.getElementById('spot-wall-self-note');
  const btnToggleWall = document.getElementById('btn-toggle-wall') as HTMLButtonElement;
  const btnInviteNeighbor = document.getElementById('btn-invite-neighbor') as HTMLButtonElement;
  const linkWebsite = document.getElementById('link-website') as HTMLAnchorElement;
  const linkWebsiteText = document.getElementById('link-website-text');
  const linkTwitter = document.getElementById('link-twitter') as HTMLAnchorElement;
  const linkFacebook = document.getElementById('link-facebook') as HTMLAnchorElement;
  const linkInstagram = document.getElementById('link-instagram') as HTMLAnchorElement;
  const linkLinkedin = document.getElementById('link-linkedin') as HTMLAnchorElement;
  const linkYoutube = document.getElementById('link-youtube') as HTMLAnchorElement;
  const linkGithub = document.getElementById('link-github') as HTMLAnchorElement;
  const linkSupport = document.getElementById('link-support') as HTMLAnchorElement;
  const profileOwnerActions = document.getElementById('profile-owner-actions');
  const btnOpenEditProfile = document.getElementById('btn-open-edit-profile');

  // Edit Profile Elements
  const editProfileForm = document.getElementById('edit-profile-form') as HTMLFormElement;
  const editAvatarGrid = document.getElementById('edit-avatar-grid');
  const editDisplayName = document.getElementById('edit-display-name') as HTMLInputElement;
  const editTagline = document.getElementById('edit-tagline') as HTMLInputElement;
  const editWebsite = document.getElementById('edit-website') as HTMLInputElement;
  const editTwitter = document.getElementById('edit-twitter') as HTMLInputElement;
  const editFacebook = document.getElementById('edit-facebook') as HTMLInputElement;
  const editInstagram = document.getElementById('edit-instagram') as HTMLInputElement;
  const editLinkedin = document.getElementById('edit-linkedin') as HTMLInputElement;
  const editYoutube = document.getElementById('edit-youtube') as HTMLInputElement;
  const editGithub = document.getElementById('edit-github') as HTMLInputElement;
  const btnCancelEdit = document.getElementById('btn-cancel-edit');
  const btnSaveEdit = document.getElementById('btn-save-edit') as HTMLButtonElement;

  // Claim Modal Elements
  const claimBackdrop = document.getElementById('claim-modal-backdrop');
  const claimCloseBtn = document.getElementById('claim-modal-close');
  const claimSpotBadge = document.getElementById('claim-spot-badge');
  const claimAvatarGrid = document.getElementById('claim-avatar-grid');
  const claimForm = document.getElementById('claim-form') as HTMLFormElement;
  const submitClaimBtn = document.getElementById('submit-claim-btn') as HTMLButtonElement;
  const inputDisplayName = document.getElementById('input-display-name') as HTMLInputElement;
  const inputTagline = document.getElementById('input-tagline') as HTMLInputElement;
  const inputWebsite = document.getElementById('input-website') as HTMLInputElement;
  const inputTwitter = document.getElementById('input-twitter') as HTMLInputElement;
  const inputFacebook = document.getElementById('input-facebook') as HTMLInputElement;
  const inputInstagram = document.getElementById('input-instagram') as HTMLInputElement;
  const inputLinkedin = document.getElementById('input-linkedin') as HTMLInputElement;
  const inputYoutube = document.getElementById('input-youtube') as HTMLInputElement;
  const inputGithub = document.getElementById('input-github') as HTMLInputElement;

  // Custom Avatar Elements (Claim Modal)
  const inputCustomAvatarFile = document.getElementById('input-custom-avatar-file') as HTMLInputElement;
  const claimCustomPreviewBox = document.getElementById('claim-custom-preview-box');
  const claimCustomPreviewCanvas = document.getElementById('claim-custom-preview-canvas') as HTMLCanvasElement;
  const btnClaimRes32 = document.getElementById('btn-claim-res-32') as HTMLButtonElement;
  const btnClaimRes16 = document.getElementById('btn-claim-res-16') as HTMLButtonElement;
  const btnClaimRes8 = document.getElementById('btn-claim-res-8') as HTMLButtonElement;
  const btnClaimRemoveCustom = document.getElementById('btn-claim-remove-custom') as HTMLButtonElement;
  const spinnerClaimUpload = document.getElementById('spinner-claim-upload');
  const txtClaimUploadLabel = document.getElementById('txt-claim-upload-label');
  const iconClaimUpload = document.getElementById('icon-claim-upload');

  // Custom Avatar Elements (Edit Modal)
  const inputEditCustomAvatarFile = document.getElementById('edit-custom-avatar-file') as HTMLInputElement;
  const editCustomPreviewBox = document.getElementById('edit-custom-preview-box');
  const editCustomPreviewCanvas = document.getElementById('edit-custom-preview-canvas') as HTMLCanvasElement;
  const btnEditRes32 = document.getElementById('btn-edit-res-32') as HTMLButtonElement;
  const btnEditRes16 = document.getElementById('btn-edit-res-16') as HTMLButtonElement;
  const btnEditRes8 = document.getElementById('btn-edit-res-8') as HTMLButtonElement;
  const btnEditRemoveCustom = document.getElementById('btn-edit-remove-custom') as HTMLButtonElement;
  const spinnerEditUpload = document.getElementById('spinner-edit-upload');
  const txtEditUploadLabel = document.getElementById('txt-edit-upload-label');
  const iconEditUpload = document.getElementById('icon-edit-upload');

  let claimCustomAvatarData: string | null = null;
  let claimCustomAvatarFile: File | null = null;
  let claimCustomRes: 8 | 16 | 24 | 32 = 32;

  let editCustomAvatarData: string | null = null;
  let editCustomAvatarFile: File | null = null;
  let editCustomRes: 8 | 16 | 24 | 32 = 32;

  // Search Modal Elements
  const searchBackdrop = document.getElementById('search-modal-backdrop');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchStatus = document.getElementById('search-status');
  const searchResultsList = document.getElementById('search-results-list');

  let currentTargetSpot: { x: number; y: number } = { x: 50, y: 50 };
  let referralSpotId: string | null = null;
  let selectedAvatarId = 'astronaut';
  let editSelectedAvatarId = 'astronaut';
  let myCitizen: Citizen | null = null;
  let myOwnedSpot: { id: string; x: number; y: number; claimedAt?: string } | null = null;
  let currentViewingOccupied: OccupiedSpotSummary | null = null;
  let activityTimer: number | undefined;
  let activityResetTimer: number | undefined;

  function showActivity(message: string): void {
    if (!activityText) return;
    if (activityResetTimer) window.clearTimeout(activityResetTimer);
    activityText.classList.remove('activity-enter');
    void activityText.offsetWidth;
    activityText.textContent = message;
    activityText.classList.add('activity-enter');
    if (activityTimer) window.clearTimeout(activityTimer);
    activityTimer = window.setTimeout(() => activityText.classList.remove('activity-enter'), 450);
    activityResetTimer = window.setTimeout(() => {
      activityText.textContent = 'Watching the city...';
    }, 10_000);
  }

  function activityFromSpot(spot: { displayName: string; x: number; y: number }): string {
    return `@${spot.displayName} claimed (${spot.x}, ${spot.y})`;
  }

  const districtNames = [
    'Pixel Quarter', 'Neon Harbor', 'Code Alley', 'Orbit Heights',
    'Signal Gardens', 'The Gridworks', 'Byte Bazaar', 'Lumen Row',
    'Cloud Commons', 'Circuit Park', 'Vector Vale', 'Arcade Ward',
    'Moon Market', 'Syntax Square', 'Data Docks', 'Retro Heights',
    'Canvas Crossing', 'Starboard', 'Glitch Gardens', 'The Foundry',
  ];

  function getDistrictName(x: number, y: number): string {
    const column = Math.floor(x / 10);
    const row = Math.floor(y / 10);
    const districtNumber = row * 10 + column + 1;
    return `${districtNames[(districtNumber - 1) % districtNames.length]} ${String(districtNumber).padStart(2, '0')}`;
  }

  function isPrimeSpot(x: number, y: number): boolean {
    return (x === 0 && y === 0) || (x === 50 && y === 50) || (x === 99 && y === 99);
  }

  async function refreshWorldFromApi(): Promise<void> {
    if (!API_BASE) return;
    try {
      const snapshot = await fetchWorldSnapshot();
      worldSnapshot = snapshot;
      renderer.setSnapshot(snapshot);
      if (hudClaimedCount) hudClaimedCount.textContent = snapshot.claimedCount.toLocaleString();
    } catch {}
  }
  let worldSnapshot: WorldSnapshot = {
    width: 100,
    height: 100,
    totalSpots: 10000,
    claimedCount: 0,
    onlineCount: 0,
    occupied: [],
  };

  // 3. Initialize Canvas Renderer
  const renderer = new WorldCanvasRenderer(canvas, worldSnapshot, {
    onSpotClick: (spot) => {
      if (spot.occupied) {
        openProfileModal(spot.occupied);
      } else {
        openClaimModal(spot.x, spot.y);
      }
    },
    onSpotHover: (spot) => {
      if (!spot) {
        if (coordPill) coordPill.style.opacity = '0.6';
        if (coordVerifiedBadge) coordVerifiedBadge.style.display = 'none';
        if (coordPrime) coordPrime.style.display = 'none';
        return;
      }
      if (coordPill) coordPill.style.opacity = '1';
      if (coordText) coordText.textContent = `Spot: (${spot.x}, ${spot.y})`;
      if (coordDistrict) coordDistrict.textContent = getDistrictName(spot.x, spot.y);
      if (coordPrime) coordPrime.style.display = isPrimeSpot(spot.x, spot.y) ? 'inline-flex' : 'none';
      if (coordStatus) {
        if (spot.occupied) {
          coordStatus.textContent = spot.occupied.displayName;
          coordStatus.className = 'coord-badge occupied';
          if (coordVerifiedBadge) coordVerifiedBadge.style.display = spot.occupied.isVerified ? 'inline-flex' : 'none';
        } else {
          coordStatus.textContent = 'Available';
          coordStatus.className = 'coord-badge empty';
          if (coordVerifiedBadge) coordVerifiedBadge.style.display = 'none';
        }
      }
    },
  });

  const inputHandler = new CanvasInputHandler(renderer);
  (window as any).__spotInputHandler = inputHandler;
  renderer.start();

  // 4. Render Avatar Selection Grids
  function renderAvatarSelector(
    container: HTMLElement | null,
    currentSelected: string,
    onSelect: (id: string) => void,
    hasCustom: boolean = false
  ) {
    if (!container) return;
    container.innerHTML = '';
    Object.values(AVATAR_CATALOG).forEach((avatar) => {
      const option = document.createElement('div');
      option.className = `avatar-option ${(!hasCustom && avatar.id === currentSelected) ? 'selected' : ''}`;
      option.dataset.avatarId = avatar.id;

      const optCanvas = document.createElement('canvas');
      optCanvas.width = 36;
      optCanvas.height = 36;
      const optCtx = optCanvas.getContext('2d');
      if (optCtx) drawAvatarOnCanvas(optCtx, avatar, 0, 0, 36);

      const label = document.createElement('span');
      label.textContent = avatar.name;

      option.appendChild(optCanvas);
      option.appendChild(label);

      option.addEventListener('click', () => {
        container.querySelectorAll('.avatar-option').forEach((el) => el.classList.remove('selected'));
        option.classList.add('selected');
        if (container === claimAvatarGrid && claimCustomPreviewBox) {
          claimCustomPreviewBox.classList.remove('selected-custom');
          claimCustomAvatarData = null;
        }
        if (container === editAvatarGrid && editCustomPreviewBox) {
          editCustomPreviewBox.classList.remove('selected-custom');
          editCustomAvatarData = null;
        }
        onSelect(avatar.id);
      });

      container.appendChild(option);
    });
  }

  // Synchronous zero-latency restoration on page load
  try {
    const saved = localStorage.getItem('spot_my_owned');
    if (saved) {
      myOwnedSpot = JSON.parse(saved);
      if (myOwnedSpot) {
        setHeaderClaimBtnState(`My Spot (${myOwnedSpot.x}, ${myOwnedSpot.y})`, 'My Spot');
        if (!window.location.search.includes('spot=')) {
          renderer.focusSpot(myOwnedSpot.x, myOwnedSpot.y, 2.2);
        }
      }
    }
  } catch {}

  // 5. Load Data & Hydrate Session
  async function loadData() {
    try {
      const snapshot = await fetchWorldSnapshot();
      worldSnapshot = snapshot;
      renderer.setSnapshot(snapshot);
      worldLoader?.classList.add('is-hidden');
      const latest = snapshot.occupied
        .filter((spot) => spot.claimedAt && Date.now() - new Date(spot.claimedAt).getTime() <= 24 * 60 * 60 * 1000)
        .sort((a, b) => new Date(b.claimedAt || 0).getTime() - new Date(a.claimedAt || 0).getTime())[0];
      if (latest) showActivity(activityFromSpot(latest));
      if (hudClaimedCount) {
        hudClaimedCount.textContent = snapshot.claimedCount.toLocaleString();
      }
      if (hudVisitorsCount && snapshot.totalVisitors) {
        hudVisitorsCount.textContent = snapshot.totalVisitors.toLocaleString();
      }
      if (hudOnlineCount && snapshot.onlineCount) {
        hudOnlineCount.textContent = String(snapshot.onlineCount);
      }

      // Record unique visitor analytics hit
      recordVisit().then((updatedCount) => {
        if (updatedCount && hudVisitorsCount) {
          hudVisitorsCount.textContent = updatedCount.toLocaleString();
        }
      });
    } catch (err) {
      console.warn('Backend API snapshot load fallback:', err);
      worldLoader?.classList.add('is-hidden');
    }

    try {
      // Check GitHub OAuth session
      let sessionCitizen: Citizen | null = null;
      let sessionOwnedSpot: { id: string; x: number; y: number; claimedAt?: string } | null = null;

      const user = await getSupabaseUser();
      if (user) {
        const metadata = user.user_metadata || {};
        const syncRes = await syncGithubAuth({
          githubId: user.id,
          username: metadata.user_name || metadata.preferred_username,
          email: user.email,
          avatarUrl: metadata.avatar_url,
          displayName: metadata.full_name || metadata.name || metadata.user_name,
        });
        if (syncRes.authenticated || syncRes.success) {
          sessionCitizen = syncRes.citizen;
          sessionOwnedSpot = syncRes.ownedSpot;
          myCitizen = sessionCitizen;

          // If the user does not own a spot yet and has a pending target, claim it automatically!
          if (!sessionOwnedSpot && sessionCitizen) {
            checkAndExecutePendingClaim(sessionCitizen);
          }
        }
      } else {
        const session = await fetchMySession();
        if (session.authenticated || (session as any).success) {
          sessionCitizen = session.citizen;
          sessionOwnedSpot = session.ownedSpot;
        }
      }

      // Only update local state if a valid authenticated citizen was retrieved.
      // This prevents network glitches, container restarts, or Cloudflare challenges
      // from erasing the user's logged-in identity!
      if (sessionCitizen) {
        myCitizen = sessionCitizen;
        myCitizen.isVerified = Boolean(myCitizen.isVerified || myCitizen.githubUrl || (myCitizen as any).githubId);
        localStorage.setItem('spot_my_citizen', JSON.stringify({
          id: myCitizen.id,
          displayName: myCitizen.displayName,
          avatarId: myCitizen.avatarId,
          isVerified: myCitizen.isVerified,
        }));
      }

      if (sessionOwnedSpot) {
        myOwnedSpot = sessionOwnedSpot;
        localStorage.setItem('spot_my_owned', JSON.stringify(myOwnedSpot));
        setHeaderClaimBtnState(`My Spot (${myOwnedSpot.x}, ${myOwnedSpot.y})`, 'My Spot');
        if (!window.location.search.includes('spot=')) {
          renderer.focusSpot(myOwnedSpot.x, myOwnedSpot.y, 2.2);
          if (coordText) coordText.textContent = `Spot: (${myOwnedSpot.x}, ${myOwnedSpot.y})`;
          if (coordStatus) {
            coordStatus.textContent = myCitizen?.displayName || 'Citizen';
            coordStatus.className = 'coord-badge occupied';
          }
        }
      } else if (!myOwnedSpot && headerClaimBtn) {
        setHeaderClaimBtnState('Choose a Spot', 'Claim');
      }
    } catch (err) {
      console.warn('Session check fallback:', err);
    }
  }

  // 5b. Durable Auto-Claim Queue with Server Downtime Recovery
  let isExecutingPendingClaim = false;
  let autoClaimRetryTimer: any = null;

  async function checkAndExecutePendingClaim(citizen: Citizen) {
    if (isExecutingPendingClaim) return;
    const pending = localStorage.getItem('spot_claim_pending_target');
    if (!pending) return;

    try {
      isExecutingPendingClaim = true;
      const coords = JSON.parse(pending);
      if (coords && renderer.grid.isValidCoordinate(coords.x, coords.y)) {
        await autoClaimWithGithub(coords.x, coords.y, citizen);
      }
    } catch (e) {
      console.warn('Pending claim target parse error:', e);
    } finally {
      isExecutingPendingClaim = false;
    }
  }

  function scheduleAutoClaimRetry(gx: number, gy: number, citizen: Citizen) {
    if (autoClaimRetryTimer) return;
    let attempts = 0;
    autoClaimRetryTimer = setInterval(async () => {
      attempts++;
      const isHealthy = await checkServerHealth();
      if (isHealthy) {
        clearInterval(autoClaimRetryTimer);
        autoClaimRetryTimer = null;
        showToast('⚡ Server reconnected! Completing your spot claim...', 'info');
        await autoClaimWithGithub(gx, gy, citizen);
      } else if (attempts >= 60) {
        // Stop polling after 4 minutes, but keep spot_claim_pending_target in localStorage for reload
        clearInterval(autoClaimRetryTimer);
        autoClaimRetryTimer = null;
      }
    }, 4000);
  }

  // Automatic Claim on return from GitHub OAuth
  async function autoClaimWithGithub(gx: number, gy: number, citizen: Citizen) {
    const spotId = renderer.grid.getSpotId(gx, gy);
    try {
      showToast('Securing spot with your GitHub profile...', 'info');
      const res = await claimSpot(spotId, {
        displayName: citizen.displayName,
        avatarId: citizen.avatarId || selectedAvatarId,
        tagline: citizen.tagline || 'Proud citizen of Spot.',
        websiteUrl: citizen.websiteUrl || undefined,
        githubUrl: citizen.githubUrl || undefined,
      });

      myCitizen = res.citizen;
      myOwnedSpot = { id: spotId, x: gx, y: gy, claimedAt: new Date().toISOString() };

      // SUCCESS: Only remove pending target after confirmed database claim!
      localStorage.removeItem('spot_claim_pending_target');
      if (autoClaimRetryTimer) {
        clearInterval(autoClaimRetryTimer);
        autoClaimRetryTimer = null;
      }

      const newOccupied: OccupiedSpotSummary = {
        spotId,
        x: gx,
        y: gy,
        citizenId: res.citizen.id,
        displayName: res.citizen.displayName,
        avatarId: res.citizen.avatarId,
        tagline: res.citizen.tagline,
        websiteUrl: res.citizen.websiteUrl,
        githubUrl: res.citizen.githubUrl,
        isOnline: true,
      };

      worldSnapshot.occupied.push(newOccupied);
      worldSnapshot.claimedCount++;
      renderer.setSnapshot(worldSnapshot);

      if (hudClaimedCount) hudClaimedCount.textContent = worldSnapshot.claimedCount.toLocaleString();
      setHeaderClaimBtnState(`My Spot (${gx}, ${gy})`, 'My Spot');

      // Clean hash from URL bar
      if (window.location.hash) {
        window.history.replaceState(null, '', window.location.pathname);
      }

      showToast(`🎉 Spot (${gx}, ${gy}) is now yours forever!`, 'success');
      trackEvent('spot_claim', {
        spot_id: spotId,
        spot_x: gx,
        spot_y: gy,
        method: 'github',
      });

      // Center camera on newly claimed spot
      const worldPos = renderer.grid.gridToWorld(gx, gy);
      renderer.camera.centerOn(worldPos.x + 18, worldPos.y + 18, 2.2);
      renderer.selectSpot(gx, gy);
    } catch (err: any) {
      if (isServerOfflineError(err)) {
        showToast(`⚡ Server is recharging. Spot (${gx}, ${gy}) is held for you and will auto-claim when connection restores.`, 'info');
        scheduleAutoClaimRetry(gx, gy, citizen);
        return;
      }
      // If the spot was taken by someone else while away, clear target and notify
      if (err.status === 409 || err.message?.includes('already claimed') || err.message?.includes('occupied')) {
        localStorage.removeItem('spot_claim_pending_target');
        showToast(`Spot (${gx}, ${gy}) was just claimed by another citizen. Please choose another vacant spot.`, 'error');
        openClaimModal(gx, gy);
        return;
      }
      showToast(err.message || 'Failed to claim spot with GitHub', 'error');
    }
  }

  // Deep link parsing: ?spot=x,y and ?auth_key=token
  function checkUrlDeepLink() {
    const params = new URLSearchParams(window.location.search);

    // 1. Cross-Device Magic Transfer Key (?auth_key=...&cit_id=...&spot=x,y)
    const authKey = params.get('auth_key');
    const citId = params.get('cit_id');
    const spotParam = params.get('spot');
    const spotIdParam = params.get('spot_id');
    const refParam = params.get('ref');

    if (authKey || citId) {
      if (authKey) localStorage.setItem('spot_session_token', authKey);
      if (citId) localStorage.setItem('spot_citizen_id', citId);

      if (spotParam && /^\d{1,3},\d{1,3}$/.test(spotParam)) {
        const [gx, gy] = spotParam.split(',').map(Number);
        const spotId = spotIdParam || renderer.grid.getSpotId(gx, gy);
        myOwnedSpot = { id: spotId, x: gx, y: gy };
        localStorage.setItem('spot_my_owned', JSON.stringify(myOwnedSpot));
        
      setHeaderClaimBtnState(`My Spot (${gx}, ${gy})`, 'My Spot');

        setTimeout(() => {
          const worldPos = renderer.grid.gridToWorld(gx, gy);
          renderer.camera.centerOn(worldPos.x + 18, worldPos.y + 18, 2.2);
          renderer.selectSpot(gx, gy);
        }, 150);
      }

      showToast('📱 Device Synced! Owner permissions activated.', 'success');

      // Fetch freshly synced session from database
      fetchMySession().then((session) => {
        if (session.authenticated && session.citizen) {
          myCitizen = session.citizen;
          if (session.ownedSpot) myOwnedSpot = session.ownedSpot;
          if (myOwnedSpot) {
            setHeaderClaimBtnState(`My Spot (${myOwnedSpot.x}, ${myOwnedSpot.y})`, 'My Spot');
          }
          if (myOwnedSpot) {
            const worldPos = renderer.grid.gridToWorld(myOwnedSpot.x, myOwnedSpot.y);
            renderer.camera.centerOn(worldPos.x + 18, worldPos.y + 18, 2.2);
            renderer.selectSpot(myOwnedSpot.x, myOwnedSpot.y);
          }
        }
      });

      // Clean auth parameters from address bar
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('auth_key');
      cleanUrl.searchParams.delete('cit_id');
      cleanUrl.searchParams.delete('spot_id');
      window.history.replaceState({}, document.title, cleanUrl.pathname + (cleanUrl.searchParams.toString() ? '?' + cleanUrl.searchParams.toString() : ''));
      return;
    }

    // 2. Referral invite: find an available tile beside the referrer.
    if (refParam && /^\d{1,2},\d{1,2}$/.test(refParam)) {
      const [refX, refY] = refParam.split(',').map(Number);
      if (renderer.grid.isValidCoordinate(refX, refY)) {
        const occupiedIds = new Set(worldSnapshot.occupied.map((spot) => spot.spotId));
        const neighbors = [
          [refX + 1, refY], [refX - 1, refY], [refX, refY + 1], [refX, refY - 1],
          [refX + 1, refY + 1], [refX - 1, refY - 1], [refX + 1, refY - 1], [refX - 1, refY + 1],
        ];
        const target = neighbors.find(([x, y]) => renderer.grid.isValidCoordinate(x, y) && !occupiedIds.has(`${x},${y}`));
        if (target) {
          referralSpotId = refParam;
          const [targetX, targetY] = target;
          setTimeout(() => {
            renderer.camera.centerOn(renderer.grid.gridToWorld(targetX, targetY).x + 18, renderer.grid.gridToWorld(targetX, targetY).y + 18, 2.2);
            renderer.selectSpot(targetX, targetY);
            openClaimModal(targetX, targetY);
            showToast(`Claim a spot beside (${refX}, ${refY})`, 'info');
          }, 200);
        } else {
          showToast('That neighborhood is full. Choose another spot.', 'info');
        }
      }
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('ref');
      window.history.replaceState({}, document.title, cleanUrl.pathname + (cleanUrl.searchParams.toString() ? '?' + cleanUrl.searchParams.toString() : ''));
      return;
    }

    // 3. Regular spot coordinate deep link (?spot=x,y)
    if (spotParam && /^\d{1,3},\d{1,3}$/.test(spotParam)) {
      const [gx, gy] = spotParam.split(',').map(Number);
      if (renderer.grid.isValidCoordinate(gx, gy)) {
        setTimeout(() => {
          const worldPos = renderer.grid.gridToWorld(gx, gy);
          renderer.camera.centerOn(worldPos.x + 18, worldPos.y + 18, 2.2);
          renderer.selectSpot(gx, gy);
        }, 200);
      }
    }

    // Clean tracking garbage (fbclid, gclid, utm_*) from address bar
    if (params.has('fbclid') || params.has('gclid') || params.has('utm_source') || params.has('utm_medium')) {
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('fbclid');
      cleanUrl.searchParams.delete('gclid');
      cleanUrl.searchParams.delete('utm_source');
      cleanUrl.searchParams.delete('utm_medium');
      cleanUrl.searchParams.delete('utm_campaign');
      window.history.replaceState({}, document.title, cleanUrl.pathname + (cleanUrl.searchParams.toString() ? '?' + cleanUrl.searchParams.toString() : ''));
    }
  }

