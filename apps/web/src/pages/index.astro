    if (profileSpotId) profileSpotId.textContent = `Spot (${occupied.x}, ${occupied.y})`;
    if (profileName) profileName.textContent = occupied.displayName;
    if (profileVerifiedBadge) profileVerifiedBadge.style.display = occupied.isVerified ? 'inline-flex' : 'none';
