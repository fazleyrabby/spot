    let target = { x: 50, y: 50 };
    for (let radius = 0; radius < 50; radius++) {
      let found = false;
      for (let dx = -radius; dx <= radius; dx++) {
        for (let dy = -radius; dy <= radius; dy++) {
          const gx = 50 + dx;
          const gy = 50 + dy;
          const spotId = renderer.grid.getSpotId(gx, gy);
          // @ts-ignore
