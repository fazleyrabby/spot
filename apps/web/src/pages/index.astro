  function hideModalOfflineState() {
    if (claimOfflineBanner) claimOfflineBanner.style.display = 'none';
    if (modalOfflinePollTimer) {
      clearInterval(modalOfflinePollTimer);
      modalOfflinePollTimer = null;
    }
  }

  function startModalOfflinePolling() {
    if (modalOfflinePollTimer) return;
    let countdown = 4;
    modalOfflinePollTimer = setInterval(async () => {
      countdown--;
      if (countdown > 0) {
        if (txtOfflineCountdown) txtOfflineCountdown.textContent = `Holding your spot. Auto-retrying in ${countdown}s...`;
      } else {
        countdown = 4;
        if (txtOfflineCountdown) txtOfflineCountdown.textContent = 'Checking server status...';
        const isHealthy = await checkServerHealth();
        if (isHealthy) {
          hideModalOfflineState();
          showToast('⚡ Server reconnected! Submitting claim...', 'info');
          claimForm?.dispatchEvent(new Event('submit'));
        } else {
          if (txtOfflineCountdown) txtOfflineCountdown.textContent = 'Holding your spot. Auto-retrying in 4s...';
        }
      }
    }, 1000);
  }

