---
/**
 * ArtMuseumModal — Simple grid modal for 2D math arts from art.fazleyrabbi.xyz
 * No walkable interior for now — just click door → modal with live iframes.
 */
---

<div class="museum-modal-backdrop modal-backdrop" id="museum-modal-backdrop" aria-hidden="true">
  <div class="museum-modal" role="dialog" aria-modal="true" aria-labelledby="museum-title">
    <div class="museum-header">
      <div>
        <h2 id="museum-title" class="museum-title">ƒ(x) — MATH ART MUSEUM</h2>
        <p class="museum-sub">12 curated 2D canvas studies • live from art.fazleyrabbi.xyz • click to expand</p>
      </div>
      <button type="button" class="museum-close" id="museum-modal-close" aria-label="Close">✕</button>
    </div>
    <div class="museum-grid" id="museum-grid"></div>
  </div>
</div>

<style>
  .museum-modal-backdrop { position: fixed; inset:0; background: radial-gradient(1200px 600px at 50% -10%, rgba(251,191,36,0.10), transparent 60%), rgba(4,10,18,0.88); backdrop-filter: blur(14px); display:none; align-items:center; justify-content:center; z-index:360; padding: 16px; }
  .museum-modal-backdrop.open { display:flex; }
  .museum-modal { width:100%; max-width: 1020px; max-height: 88vh; background:
      linear-gradient(180deg, #0f172a 0%, #0b1222 100%);
    border:2px solid #eab308; border-radius: 18px; padding: 14px; display:flex; flex-direction:column; gap:14px; overflow:hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.75), 0 0 0 1px rgba(251,191,36,0.18), 0 0 32px rgba(251,191,36,0.12); }
  .museum-header { display:flex; align-items:center; justify-content:space-between; gap:12px; border-bottom:1px solid rgba(251,191,36,0.18); padding-bottom:10px; }
  .museum-title { font:900 14px monospace; color:#facc15; letter-spacing:0.10em; margin:0; text-shadow: 0 0 12px rgba(251,191,36,0.35); }
  .museum-sub { font:500 11px monospace; color:#94a3b8; margin:2px 0 0; }
  .museum-close { width:32px; height:32px; border-radius:8px; background:#1e293b; border:1px solid #334155; color:#f8fafc; cursor:pointer; }
  .museum-close:hover { background:#eab308; color:#0f172a; }
  /* walnut wall with subtle vertical panels + parquet floor hint */
  .museum-grid {
    display:grid; grid-template-columns: repeat(3, 1fr); gap:18px; overflow:auto; padding:18px 14px 14px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.03) 0 1px, transparent 1px),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 88px),
      linear-gradient(180deg, #0a1020 0%, #0f1b2e 48%, #0d1320 100%);
    border-radius:12px; border:1px solid rgba(255,255,255,0.06);
    box-shadow: inset 0 0 40px rgba(0,0,0,0.45);
  }
  @media (max-width: 640px) { .museum-grid { grid-template-columns: repeat(2, 1fr); gap:14px; } }
  /* ornate brass frame with mat + spotlight cone */
  .museum-card {
    position:relative; background:#020617; border-radius:6px; overflow:hidden; display:flex; flex-direction:column;
    border: 6px solid #a16207;
    outline: 1.5px solid #facc15;
    outline-offset: -7px;
    box-shadow:
      0 10px 28px rgba(0,0,0,0.65),
      0 0 0 6px #451a03,
      0 0 18px rgba(251,191,36,0.22),
      inset 0 0 0 8px #fffbeb, /* mat */
      inset 0 0 18px rgba(0,0,0,0.35);
  }
  .museum-card::before {
    content:""; position:absolute; top:-14px; left:50%; transform:translateX(-50%);
    width: 72%; height: 28px;
    background: radial-gradient(ellipse at 50% 100%, rgba(255,255,255,0.22) 0%, transparent 70%);
    filter: blur(6px); pointer-events:none;
  }
  .museum-card iframe { width:100%; aspect-ratio: 1.45; border:0; background:#050608; display:block; margin:8px; width: calc(100% - 16px); border-radius:2px; }
  .museum-card-foot {
    margin: 0 8px 8px; padding:7px 8px;
    background: linear-gradient(180deg, #1c1917 0%, #0f0a08 100%);
    border:1px solid rgba(251,191,36,0.28); border-radius:4px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    text-align:center;
  }
  .museum-card-title { font:800 10px monospace; color:#fde68a; letter-spacing:0.06em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .museum-card-formula { font:500 8.5px monospace; color:#a8a29e; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:3px; font-style:italic; }
</style>

<script>
  import { MUSEUM_FRAMES } from '../world/museum-manager.js';
  const backdrop = document.getElementById('museum-modal-backdrop') as HTMLDivElement | null;
  const grid = document.getElementById('museum-grid') as HTMLDivElement | null;
  const closeBtn = document.getElementById('museum-modal-close') as HTMLButtonElement | null;

  // full 2D pool — shuffle to 12 random each open
  const POOL_2D = [
    ...MUSEUM_FRAMES,
    { id:'p13', gx:0, gy:0, slug:'sacred-lotus', title:'Sacred Lotus', formula:'petal = cubicBezier(base, ctrl1, tip)' },
    { id:'p14', gx:0, gy:0, slug:'chrysanthemum-bloom', title:'Chrysanthemum', formula:'r=5*(1+sin(11θ/5))' },
    { id:'p15', gx:0, gy:0, slug:'rhodonea-rose', title:'Rhodonea Rose', formula:'r=R*sin(kθ+φ)' },
    { id:'p16', gx:0, gy:0, slug:'penrose-subdivision', title:'Penrose Tiling', formula:'p4=p1+(p2-p1)/φ' },
    { id:'p17', gx:0, gy:0, slug:'standing-wave-grid', title:'Standing Wave Grid', formula:'w=sin(nπx)sin(mπy)' },
    { id:'p18', gx:0, gy:0, slug:'circular-ripples', title:'Circular Ripples', formula:'w=Σ sin(dist*freq-2t)/sqrt(dist)' },
    { id:'p19', gx:0, gy:0, slug:'viscous-gyre', title:'Viscous Gyre', formula:'u=2π sin(πx)cos(2πy)' },
    { id:'p20', gx:0, gy:0, slug:'curl-vector-field', title:'Curl Field', formula:'vx=(N(x,y+ε)-N(x,y-ε))/2ε' },
    { id:'p21', gx:0, gy:0, slug:'smoke-lattice', title:'Smoke Lattice', formula:'ρ^{t+1}=ρ^t*0.94+...' },
    { id:'p22', gx:0, gy:0, slug:'gerstner-ocean-waves', title:'Gerstner Waves', formula:'x=x0-(dx/k)Q sin(phase)' },
  ];

  function shuffled12() {
    const a = [...POOL_2D];
    for (let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
    return a.slice(0,12);
  }

  function buildGrid() {
    if (!grid) return;
    grid.innerHTML = '';
    const picks = shuffled12();
    for (const f of picks) {
      const card = document.createElement('div');
      card.className = 'museum-card';
      const iframe = document.createElement('iframe');
      iframe.loading = 'lazy';
      iframe.src = `https://art.fazleyrabbi.xyz/embed/${f.slug}`;
      iframe.title = f.title;
      const foot = document.createElement('div');
      foot.className = 'museum-card-foot';
      const t = document.createElement('div');
      t.className = 'museum-card-title';
      t.textContent = f.title;
      const fm = document.createElement('div');
      fm.className = 'museum-card-formula';
      fm.textContent = f.formula;
      foot.appendChild(t); foot.appendChild(fm);
      card.appendChild(iframe); card.appendChild(foot);
      card.addEventListener('click', () => window.open(`https://art.fazleyrabbi.xyz/art/${f.slug}`, '_blank'));
      card.style.cursor = 'pointer';
      grid.appendChild(card);
    }
  }

  function openMuseumModal() {
    buildGrid();
    backdrop?.classList.add('open');
    backdrop?.setAttribute('aria-hidden','false');
  }
  function closeMuseumModal() {
    backdrop?.classList.remove('open');
    backdrop?.setAttribute('aria-hidden','true');
  }

  closeBtn?.addEventListener('click', closeMuseumModal);
  backdrop?.addEventListener('click', (e) => { if (e.target === backdrop) closeMuseumModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMuseumModal(); });

  (window as any).openMuseumModal = openMuseumModal;
  (window as any).closeMuseumModal = closeMuseumModal;
</script>
