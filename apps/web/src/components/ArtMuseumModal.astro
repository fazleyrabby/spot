---
/**
 * ArtMuseumModal — Simple grid modal for 2D math arts from art.fazleyrabbi.xyz
 * No walkable interior for now — just click door → modal with live iframes.
 */
---

<div class="museum-modal-backdrop modal-backdrop" id="museum-modal-backdrop" aria-hidden="true">
    <div class="museum-modal" role="dialog" aria-modal="true" aria-labelledby="museum-title">
      <div class="museum-arch">
        <span class="arch-tile t1"></span><span class="arch-tile t2"></span><span class="arch-tile t3"></span>
        <div class="arch-roof"><span class="arch-dentil"></span></div>
      </div>
      <div class="museum-header">
        <div class="museum-brandlock">
          <span class="museum-seal">ƒ(x)</span>
          <div class="museum-wordmark">
            <span class="museum-eyebrow">GALLERY 01 · WING B · 2D CANVAS COLLECTION</span>
            <h2 id="museum-title" class="museum-title">MATH ART MUSEUM</h2>
          </div>
        </div>
        <div class="museum-header-right">
          <span class="museum-hours">OPEN DAILY · LIVE 60FPS</span>
          <button type="button" class="museum-close" id="museum-modal-close" aria-label="Exit gallery">✕</button>
        </div>
      </div>
      <div class="museum-marquee">
        <span class="marquee-label">NOW EXHIBITING</span>
        <span class="marquee-text">12 curated generative studies — pure Canvas 2D, no GPU · from <b>art.fazleyrabbi.xyz</b> · click any work to open in the artist's studio</span>
      </div>
      <div class="museum-room">
        <div class="room-caption">
          <span class="room-label">SOUTH WALL</span>
          <span class="room-lamp"></span>
        </div>
        <div class="museum-grid" id="museum-grid"></div>
        <div class="room-caption room-caption-bottom">
          <span class="room-lamp"></span>
          <span class="room-label">NORTH WALL</span>
        </div>
      </div>
    </div>
  </div>


<style is:global>
  .museum-modal-backdrop { position: fixed; inset:0; background:
      radial-gradient(1400px 700px at 50% -10%, rgba(251,191,36,0.10), transparent 60%),
      linear-gradient(180deg, rgba(12,10,8,0.92), rgba(4,7,14,0.96));
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); display:none; align-items:center; justify-content:center; z-index:360; padding: 14px; }
  .museum-modal-backdrop.open { display:flex; }

  /* ── Architectural museum frame ─────────────────────────────── */
  .museum-modal {
    width:100%; max-width: 1060px; max-height: 90vh;
    background: linear-gradient(180deg, #0d1626 0%, #0a101d 100%);
    border-radius: 6px 6px 14px 14px;
    padding: 0; display:flex; flex-direction:column;
    overflow:hidden;
    border: 1px solid rgba(251,191,36,0.55);
    box-shadow:
      0 40px 90px rgba(0,0,0,0.8),
      0 0 0 1px #3a2a12,
      0 0 0 5px rgba(20,14,6,0.9),
      0 0 0 6px rgba(251,191,36,0.28),
      inset 0 0 60px rgba(0,0,0,0.5);
  }

  /* ── Roofline pediment with dentil cornice ───────────────────── */
  .museum-arch { position:relative; background: #f5efdf; height: 26px; display:flex; }
  .arch-roof {
    position:absolute; top:-16px; left:50%; transform:translateX(-50%);
    width: 58%; height: 18px;
    background: linear-gradient(180deg, #d8c9a3, #b9a477);
    clip-path: polygon(0 100%, 12% 0, 88% 0, 100% 100%);
    filter: drop-shadow(0 2px 2px rgba(0,0,0,0.35));
  }
  .arch-dentil {
    position:absolute; top:-1px; left:8%; right:8%; height:5px;
    background: repeating-linear-gradient(90deg, #8a7443 0 7px, #efe3c2 7px 11px);
  }
  .arch-tile { flex:1; background:
    repeating-linear-gradient(90deg, rgba(0,0,0,0.02) 0 2px, transparent 2px 26px),
    linear-gradient(180deg, #e7dcc0, #cfbe94); }
  .arch-tile + .arch-tile { border-left:1px solid rgba(90,72,40,0.25); }

  .museum-header {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding: 8px 16px;
    background: linear-gradient(180deg, #f8f2e3 0%, #ece0c4 100%);
    border-bottom: 2px solid #6b5626;
    box-shadow: inset 0 -1px 0 rgba(255,255,255,0.6);
    color:#1c1508;
  }
  .museum-brandlock { display:flex; align-items:center; gap:12px; min-width:0; }
  .museum-seal {
    width:44px; height:44px; flex-shrink:0;
    background: radial-gradient(circle at 35% 30%, #fff8e6, #d4b45c 60%, #a07c28);
    border:2px solid #6b5626; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font: 900 15px 'Times New Roman', serif; color:#2b1f08;
    box-shadow: inset 0 0 8px rgba(0,0,0,0.25), 0 1px 3px rgba(0,0,0,0.3);
  }
  .museum-wordmark { min-width:0; }
  .museum-eyebrow {
    display:block; font: 700 8px 'Outfit', sans-serif; letter-spacing:0.22em;
    color:#8a6a2a; margin-bottom:2px; white-space:nowrap;
  }
  .museum-title {
    font: 900 clamp(15px, 2.4vw, 22px) 'Times New Roman', Georgia, serif;
    color:#241a06; letter-spacing:0.06em; margin:0; line-height:1;
    text-shadow: 0 1px 0 rgba(255,255,255,0.5);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .museum-header-right { display:flex; align-items:center; gap:12px; flex-shrink:0; }
  .museum-hours { font: 700 8px 'Outfit', sans-serif; letter-spacing:0.18em; color:#7a6226; white-space:nowrap; }
  .museum-close {
    width:30px; height:30px; border-radius:6px;
    background: linear-gradient(180deg, #6b5626, #4a3a18);
    border:1px solid #2f240c; color:#f3e6c4; cursor:pointer;
    font: 700 13px sans-serif; line-height:1;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .museum-close:hover { background:#8a6a2a; color:#fff; }

  /* ── Marquee / curatorial plaque ─────────────────────────────── */
  .museum-marquee {
    display:flex; align-items:center; gap:10px;
    padding: 6px 16px;
    background: #0b0f1a;
    border-bottom: 1px solid rgba(251,191,36,0.2);
  }
  .marquee-label {
    flex-shrink:0; padding: 2px 8px; border-radius:3px;
    background: rgba(251,191,36,0.14); border:1px solid rgba(251,191,36,0.4);
    font: 800 9px 'Outfit', sans-serif; letter-spacing:0.16em; color:#fde68a;
  }
  .marquee-text { font: 500 11px 'Outfit', sans-serif; color:#9aa7bd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .marquee-text b { color:#e5c96a; font-weight:600; }

  /* ── Gallery room — marble wainscot + gallery wall ───────────── */
  .museum-room { display:flex; flex-direction:column; flex:1; min-height:0; padding: 0 14px 12px; }
  .room-caption { display:flex; align-items:center; gap:10px; padding: 7px 2px 4px; }
  .room-caption-bottom { justify-content:flex-end; padding-top:4px; padding-bottom:0; }
  .room-label {
    font: 700 8px 'Outfit', sans-serif; letter-spacing:0.24em; color:#6a7c97; text-transform:uppercase;
  }
  .room-lamp {
    width:1px; height:10px; flex:1;
    background: linear-gradient(90deg, transparent, rgba(251,191,36,0.35), transparent);
  }

  .museum-grid {
    display:grid; grid-template-columns: repeat(3, 1fr); gap:20px 16px;
    grid-auto-rows: max-content;
    align-items: start;
    align-content: start;
    overflow-y:auto; padding: 14px 12px 16px;
    background:
      /* wainscot panels */
      repeating-linear-gradient(90deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 120px),
      /* lower wall sheen */
      linear-gradient(180deg, #131a28 0%, #1c2330 34%, #232733 34.5%, #10161f 100%);
    border:1px solid rgba(255,255,255,0.07);
    box-shadow: inset 0 0 60px rgba(0,0,0,0.6);
  }
  /* gallery rail along the floor of the wall */
  .museum-grid { border-bottom: 3px solid #31281a; }
  .museum-grid::-webkit-scrollbar { width:8px; }
  .museum-grid::-webkit-scrollbar-track { background:rgba(0,0,0,0.4); }
  .museum-grid::-webkit-scrollbar-thumb { background:#6b5626; border-radius:4px; }

  @media (max-width: 640px) {
    .museum-modal-backdrop { padding: 0; }
    .museum-modal { max-width: 100%; max-height: 100dvh; width: 100vw; height: 100dvh; border-radius: 0; border-left:0; border-right:0; }
    .museum-grid { grid-template-columns: 1fr; gap:18px; padding:12px 10px 14px; flex:1; }
    .museum-modal .museum-room { flex:1; min-height:0; }
    .museum-header { padding: 7px 10px; }
    .museum-marquee { padding: 5px 10px; }
    .museum-room { padding: 0 8px 8px; }
    .museum-seal { width:38px; height:38px; }
    .museum-hours { display:none; }
    .arch-roof { width:70%; }
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .museum-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Modern gallery card (matches Library modal aesthetic) ────── */
  .museum-card {
    position:relative;
    display:flex; flex-direction:column; cursor:pointer;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.16s ease;
  }
  .museum-card:hover {
    background: rgba(255,255,255,0.045);
    border-color: rgba(56,189,248,0.35);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -8px rgba(0,0,0,0.6), 0 0 0 1px rgba(56,189,248,0.12);
  }

  /* preview canvas (no mat, edge-to-edge, rounded) */
  .museum-card iframe {
    width:100%; aspect-ratio: 1.5; border:0; display:block;
    background: #050608;
  }
  @media (max-width:640px){ .museum-card iframe { aspect-ratio: 1.5; } }

  /* body */
  .museum-card-body {
    display:flex; flex-direction:column; gap:10px;
    padding: 14px 16px 14px;
    flex: 1;
  }
  .museum-card-title-row {
    display:flex; align-items:center; justify-content:space-between; gap:8px;
  }
  .museum-card-title {
    font: 700 15px 'Outfit', var(--font-sans), sans-serif;
    color:#f8fafc; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .museum-card-plate {
    flex-shrink:0;
    font: 700 9px 'Outfit', sans-serif; letter-spacing:0.08em; color:#38bdf8;
    background: rgba(56,189,248,0.12); border:1px solid rgba(56,189,248,0.28);
    padding: 2px 7px; border-radius: 999px;
  }
  .museum-card-formula {
    font: 400 12px 'Courier New', monospace; color:#94a3b8; margin:0; line-height:1.5;
    background: rgba(255,255,255,0.03);
    border:1px solid rgba(255,255,255,0.05);
    border-left:2px solid rgba(56,189,248,0.4);
    padding: 6px 8px; border-radius: 4px;
  }
  .museum-card-footer {
    margin-top:auto;
    display:flex; align-items:center; justify-content:space-between; gap:8px;
    padding-top:10px; border-top:1px solid rgba(255,255,255,0.05);
  }
  .museum-card-meta {
    display:flex; align-items:center; gap:6px; font: 500 10px 'Outfit', sans-serif;
    color:#64748b; min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
  }
  .museum-card-source {
    flex-shrink:0; display:inline-flex; align-items:center; gap:4px;
    font: 600 10px 'Outfit', sans-serif; letter-spacing:0.02em;
    color:#7dd3fc; text-decoration:none;
    padding: 3px 8px; border-radius:999px;
    background: rgba(56,189,248,0.08); border:1px solid rgba(56,189,248,0.2);
    transition: all 0.15s ease;
  }
  .museum-card-source:hover {
    background: rgba(56,189,248,0.18); border-color: rgba(56,189,248,0.5); color:#e0f2fe;
  }
</style>

<script>
  import { MUSEUM_FRAMES } from '../world/museum-manager.js';
  const backdrop = document.getElementById('museum-modal-backdrop') as HTMLDivElement | null;
  const grid = document.getElementById('museum-grid') as HTMLDivElement | null;
  const closeBtn = document.getElementById('museum-modal-close') as HTMLButtonElement | null;

  // full 2D pool — shuffle to 12 random each open
  const POOL_2D = [
    ...MUSEUM_FRAMES,
    { id:'p13', gx:0, gy:0, slug:'sacred-lotus', title:'Sacred Lotus', category:'botany', formula:'petal = cubicBezier(base, ctrl1, tip)' },
    { id:'p14', gx:0, gy:0, slug:'chrysanthemum-bloom', title:'Chrysanthemum', category:'botany', formula:'r=5*(1+sin(11θ/5))' },
    { id:'p15', gx:0, gy:0, slug:'rhodonea-rose', title:'Rhodonea Rose', category:'botany', formula:'r=R*sin(kθ+φ)' },
    { id:'p16', gx:0, gy:0, slug:'penrose-subdivision', title:'Penrose Tiling', category:'geometry', formula:'p4=p1+(p2-p1)/φ' },
    { id:'p17', gx:0, gy:0, slug:'standing-wave-grid', title:'Standing Wave Grid', category:'waves', formula:'w=sin(nπx)sin(mπy)' },
    { id:'p18', gx:0, gy:0, slug:'circular-ripples', title:'Circular Ripples', category:'waves', formula:'w=Σ sin(dist*freq-2t)/sqrt(dist)' },
    { id:'p19', gx:0, gy:0, slug:'viscous-gyre', title:'Viscous Gyre', category:'fluid', formula:'u=2π sin(πx)cos(2πy)' },
    { id:'p20', gx:0, gy:0, slug:'curl-vector-field', title:'Curl Field', category:'fluid', formula:'vx=(N(x,y+ε)-N(x,y-ε))/2ε' },
    { id:'p21', gx:0, gy:0, slug:'smoke-lattice', title:'Smoke Lattice', category:'fluid', formula:'ρ^{t+1}=ρ^t*0.94+...' },
    { id:'p22', gx:0, gy:0, slug:'gerstner-ocean-waves', title:'Gerstner Waves', category:'fluid', formula:'x=x0-(dx/k)Q sin(phase)' },
  ];

  function shuffled12() {
    const a = [...POOL_2D];
    for (let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
    return a.slice(0,12);
  }

  function buildGrid() {
    if (!grid) return;
    grid.innerHTML = '';
    const picks = shuffled12();
    picks.forEach((f, idx) => {
      const card = document.createElement('div');
      card.className = 'museum-card';

      // Live canvas preview
      const iframe = document.createElement('iframe');
      iframe.loading = 'lazy';
      iframe.src = `https://art.fazleyrabbi.xyz/embed/${f.slug}`;
      iframe.title = f.title;

      // Body: title + plate pill + formula
      const body = document.createElement('div');
      body.className = 'museum-card-body';

      const titleRow = document.createElement('div');
      titleRow.className = 'museum-card-title-row';
      const t = document.createElement('div');
      t.className = 'museum-card-title';
      t.textContent = f.title;
      const plate = document.createElement('span');
      plate.className = 'museum-card-plate';
      plate.textContent = `PLATE ${String(idx + 1).padStart(2, '0')}`;
      titleRow.appendChild(t); titleRow.appendChild(plate);

      const fm = document.createElement('div');
      fm.className = 'museum-card-formula';
      fm.textContent = f.formula;

      body.appendChild(titleRow); body.appendChild(fm);

      // Footer: category meta + original source link
      const footer = document.createElement('div');
      footer.className = 'museum-card-footer';
      const meta = document.createElement('div');
      meta.className = 'museum-card-meta';
      meta.textContent = `ƒ(x) · ${f.category || '2D Canvas'}`;
      const src = document.createElement('a');
      src.className = 'museum-card-source';
      src.href = `https://art.fazleyrabbi.xyz/art/${f.slug}`;
      src.target = '_blank';
      src.rel = 'noopener';
      src.textContent = 'Open original ↗';
      footer.appendChild(meta); footer.appendChild(src);

      body.appendChild(footer);

      card.appendChild(iframe); card.appendChild(body);
      card.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).closest('.museum-card-source')) return; // link handles itself
        window.open(`https://art.fazleyrabbi.xyz/art/${f.slug}`, '_blank');
      });
      card.style.cursor = 'pointer';
      grid.appendChild(card);
    });
  }

  function openMuseumModal() {
    buildGrid();
    backdrop?.classList.add('open');
    backdrop?.setAttribute('aria-hidden','false');
  }
  function closeMuseumModal() {
    backdrop?.classList.remove('open');
    backdrop?.setAttribute('aria-hidden','true');
  }

  closeBtn?.addEventListener('click', closeMuseumModal);
  backdrop?.addEventListener('click', (e) => { if (e.target === backdrop) closeMuseumModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMuseumModal(); });

  (window as any).openMuseumModal = openMuseumModal;
  (window as any).closeMuseumModal = closeMuseumModal;
</script>
