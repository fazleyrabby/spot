---
/**
 * ArtMuseumModal — Simple grid modal for 2D math arts from art.fazleyrabbi.xyz
 * No walkable interior for now — just click door → modal with live iframes.
 */
---

<div class="museum-modal-backdrop modal-backdrop" id="museum-modal-backdrop" aria-hidden="true">
    <div class="museum-modal" role="dialog" aria-modal="true" aria-labelledby="museum-title">
      <div class="museum-header">
        <div class="museum-title-group">
          <span class="museum-mark" aria-hidden="true">ƒ(x)</span>
          <div>
            <h2 id="museum-title" class="museum-title">Math Art Museum</h2>
            <p class="museum-sub">12 curated Canvas 2D studies · live from art.fazleyrabbi.xyz</p>
          </div>
        </div>
        <button type="button" class="museum-close" id="museum-modal-close" aria-label="Exit gallery">✕</button>
      </div>
      <div class="museum-grid" id="museum-grid"></div>
    </div>
  </div>


<style is:global>
  .museum-modal-backdrop { position: fixed; inset:0; background:
      rgba(4,7,14,0.86);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); display:none; align-items:center; justify-content:center; z-index:360; padding: 14px; }
  .museum-modal-backdrop.open { display:flex; }

  /* ── Modal frame (clean, dark) ──────────────────────────────── */
  .museum-modal {
    width:100%; max-width: 1000px; max-height: 90vh;
    background: #0b1019;
    border-radius: 14px;
    padding: 0; display:flex; flex-direction:column;
    overflow:hidden;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 30px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(0,0,0,0.5);
  }

  /* ── Header (dark, neutral) ─────────────────────────────────── */
  .museum-header {
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: #0e141f;
  }
  .museum-title-group { display:flex; align-items:center; gap:12px; min-width:0; }
  .museum-mark {
    flex-shrink:0; font: 800 16px 'Georgia', serif; color:#e2e8f0;
    width:38px; height:38px; border-radius:10px;
    background: rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);
    display:flex; align-items:center; justify-content:center;
  }
  .museum-title {
    font: 700 19px var(--font-sans), 'Outfit', sans-serif;
    color:#f8fafc; letter-spacing:0.01em; margin:0; line-height:1.2;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .museum-sub {
    font: 400 11.5px var(--font-sans), 'Outfit', sans-serif; color:#7b8794; margin:0;
  }
  .museum-close {
    flex-shrink:0; width:32px; height:32px; border-radius:8px;
    background: rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);
    color:#94a3b8; cursor:pointer; font: 600 14px sans-serif; line-height:1;
    transition: all 0.15s ease;
  }
  .museum-close:hover { background: rgba(255,255,255,0.1); color:#f8fafc; }

  /* ── Grid (simple scrim, no wall textures) ───────────────────── */
  .museum-grid {
    display:grid; grid-template-columns: repeat(3, 1fr); gap:18px 14px;
    grid-auto-rows: max-content;
    align-items: start;
    align-content: start;
    overflow-y:auto; padding: 18px 20px 22px;
    background: #0b1019;
  }
  .museum-grid::-webkit-scrollbar { width:9px; }
  .museum-grid::-webkit-scrollbar-track { background:rgba(255,255,255,0.02); }
  .museum-grid::-webkit-scrollbar-thumb { background:rgba(148,163,184,0.35); border-radius:4px; }

  @media (max-width: 640px) {
    .museum-modal-backdrop { padding: 0; }
    .museum-modal { max-width: 100%; max-height: 100dvh; width: 100vw; height: 100dvh; border-radius: 0; border-left:0; border-right:0; }
    .museum-grid { grid-template-columns: 1fr; gap:16px; padding:14px 12px 18px; flex:1; }
    .museum-header { padding: 12px 14px; }
    .museum-mark { width:34px; height:34px; font-size:14px; }
    .museum-title { font-size:16px; }
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .museum-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Modern gallery card (matches Library modal aesthetic) ────── */
  .museum-card {
    position:relative;
    display:flex; flex-direction:column; cursor:pointer;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.16s ease;
  }
  .museum-card:hover {
    background: rgba(255,255,255,0.045);
    border-color: rgba(56,189,248,0.35);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -8px rgba(0,0,0,0.6), 0 0 0 1px rgba(56,189,248,0.12);
  }

  /* preview canvas (no mat, edge-to-edge, rounded) */
  .museum-card iframe {
    width:100%; aspect-ratio: 1.5; border:0; display:block;
    background: #050608;
  }
  @media (max-width:640px){ .museum-card iframe { aspect-ratio: 1.5; } }

  /* body */
  .museum-card-body {
    display:flex; flex-direction:column; gap:10px;
    padding: 14px 16px 14px;
    flex: 1;
  }
  .museum-card-title-row {
    display:flex; align-items:center; justify-content:space-between; gap:8px;
  }
  .museum-card-title {
    font: 700 15px 'Outfit', var(--font-sans), sans-serif;
    color:#f8fafc; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .museum-card-plate {
    flex-shrink:0;
    font: 700 9px 'Outfit', sans-serif; letter-spacing:0.08em; color:#38bdf8;
    background: rgba(56,189,248,0.12); border:1px solid rgba(56,189,248,0.28);
    padding: 2px 7px; border-radius: 999px;
  }
  .museum-card-formula {
    font: 400 12px 'JetBrains Mono', monospace; color:#9aa7bd; margin:0; line-height:1.5;
    background: rgba(255,255,255,0.02);
    padding: 6px 8px; border-radius: 6px;
  }
  .museum-card-footer {
    margin-top:auto;
    display:flex; align-items:center; justify-content:space-between; gap:8px;
    padding-top:10px; border-top:1px solid rgba(255,255,255,0.05);
  }
  .museum-card-meta {
    display:flex; align-items:center; gap:6px; font: 500 10px 'Outfit', sans-serif;
    color:#64748b; min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
  }
  .museum-card-source {
    flex-shrink:0; display:inline-flex; align-items:center; gap:4px;
    font: 600 10px 'Outfit', sans-serif; letter-spacing:0.02em;
    color:#7dd3fc; text-decoration:none;
    padding: 3px 8px; border-radius:999px;
    background: rgba(56,189,248,0.08); border:1px solid rgba(56,189,248,0.2);
    transition: all 0.15s ease;
  }
  .museum-card-source:hover {
    background: rgba(56,189,248,0.18); border-color: rgba(56,189,248,0.5); color:#e0f2fe;
  }
</style>

<script>
  import { MUSEUM_FRAMES } from '../world/museum-manager.js';
  const backdrop = document.getElementById('museum-modal-backdrop') as HTMLDivElement | null;
  const grid = document.getElementById('museum-grid') as HTMLDivElement | null;
  const closeBtn = document.getElementById('museum-modal-close') as HTMLButtonElement | null;

  // full 2D pool — shuffle to 12 random each open
  const POOL_2D = [
    ...MUSEUM_FRAMES,
    { id:'p13', gx:0, gy:0, slug:'sacred-lotus', title:'Sacred Lotus', category:'botany', formula:'petal = cubicBezier(base, ctrl1, tip)' },
    { id:'p14', gx:0, gy:0, slug:'chrysanthemum-bloom', title:'Chrysanthemum', category:'botany', formula:'r=5*(1+sin(11θ/5))' },
    { id:'p15', gx:0, gy:0, slug:'rhodonea-rose', title:'Rhodonea Rose', category:'botany', formula:'r=R*sin(kθ+φ)' },
    { id:'p16', gx:0, gy:0, slug:'penrose-subdivision', title:'Penrose Tiling', category:'geometry', formula:'p4=p1+(p2-p1)/φ' },
    { id:'p17', gx:0, gy:0, slug:'standing-wave-grid', title:'Standing Wave Grid', category:'waves', formula:'w=sin(nπx)sin(mπy)' },
    { id:'p18', gx:0, gy:0, slug:'circular-ripples', title:'Circular Ripples', category:'waves', formula:'w=Σ sin(dist*freq-2t)/sqrt(dist)' },
    { id:'p19', gx:0, gy:0, slug:'viscous-gyre', title:'Viscous Gyre', category:'fluid', formula:'u=2π sin(πx)cos(2πy)' },
    { id:'p20', gx:0, gy:0, slug:'curl-vector-field', title:'Curl Field', category:'fluid', formula:'vx=(N(x,y+ε)-N(x,y-ε))/2ε' },
    { id:'p21', gx:0, gy:0, slug:'smoke-lattice', title:'Smoke Lattice', category:'fluid', formula:'ρ^{t+1}=ρ^t*0.94+...' },
    { id:'p22', gx:0, gy:0, slug:'gerstner-ocean-waves', title:'Gerstner Waves', category:'fluid', formula:'x=x0-(dx/k)Q sin(phase)' },
  ];

  function shuffled12() {
    const a = [...POOL_2D];
    for (let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
    return a.slice(0,12);
  }

  function buildGrid() {
    if (!grid) return;
    grid.innerHTML = '';
    const picks = shuffled12();
    picks.forEach((f, idx) => {
      const card = document.createElement('div');
      card.className = 'museum-card';

      // Live canvas preview
      const iframe = document.createElement('iframe');
      iframe.loading = 'lazy';
      iframe.src = `https://art.fazleyrabbi.xyz/embed/${f.slug}`;
      iframe.title = f.title;

      // Body: title + plate pill + formula
      const body = document.createElement('div');
      body.className = 'museum-card-body';

      const titleRow = document.createElement('div');
      titleRow.className = 'museum-card-title-row';
      const t = document.createElement('div');
      t.className = 'museum-card-title';
      t.textContent = f.title;
      const plate = document.createElement('span');
      plate.className = 'museum-card-plate';
      plate.textContent = `PLATE ${String(idx + 1).padStart(2, '0')}`;
      titleRow.appendChild(t); titleRow.appendChild(plate);

      const fm = document.createElement('div');
      fm.className = 'museum-card-formula';
      fm.textContent = f.formula;

      body.appendChild(titleRow); body.appendChild(fm);

      // Footer: category meta + original source link
      const footer = document.createElement('div');
      footer.className = 'museum-card-footer';
      const meta = document.createElement('div');
      meta.className = 'museum-card-meta';
      meta.textContent = `ƒ(x) · ${f.category || '2D Canvas'}`;
      const src = document.createElement('a');
      src.className = 'museum-card-source';
      src.href = `https://art.fazleyrabbi.xyz/art/${f.slug}`;
      src.target = '_blank';
      src.rel = 'noopener';
      src.textContent = 'Open original ↗';
      footer.appendChild(meta); footer.appendChild(src);

      body.appendChild(footer);

      card.appendChild(iframe); card.appendChild(body);
      card.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).closest('.museum-card-source')) return; // link handles itself
        window.open(`https://art.fazleyrabbi.xyz/art/${f.slug}`, '_blank');
      });
      card.style.cursor = 'pointer';
      grid.appendChild(card);
    });
  }

  function openMuseumModal() {
    buildGrid();
    backdrop?.classList.add('open');
    backdrop?.setAttribute('aria-hidden','false');
  }
  function closeMuseumModal() {
    backdrop?.classList.remove('open');
    backdrop?.setAttribute('aria-hidden','true');
  }

  closeBtn?.addEventListener('click', closeMuseumModal);
  backdrop?.addEventListener('click', (e) => { if (e.target === backdrop) closeMuseumModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMuseumModal(); });

  (window as any).openMuseumModal = openMuseumModal;
  (window as any).closeMuseumModal = closeMuseumModal;
</script>
