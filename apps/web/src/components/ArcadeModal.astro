---
/**
 * ArcadeModal — Playable 1984 CRT Cyber Arcade Cabinet ("The Byte Cade").
 * Features 60fps "Byte Snake" mini-game, Web Audio procedural sound,
 * high score persistence, and "Arcade Legend" badge unlocks.
 */
---

<div class="arcade-modal-backdrop modal-backdrop" id="arcade-modal-backdrop" aria-hidden="true">
  <!-- Authentic 1984 Upright Arcade Cabinet Shell -->
  <div class="arcade-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="arcade-title">
    
    <!-- Top Cabinet Hood & Backlit Marquee -->
    <div class="arcade-cabinet-marquee">
      <!-- Left Speaker Grille -->
      <div class="marquee-speaker left">
        <span></span><span></span><span></span><span></span>
      </div>

      <!-- Center Illuminated Marquee Sign -->
      <div class="marquee-sign-box">
        <div class="marquee-sub-badge">★ VINTAGE 1984 COIN-OP ★</div>
        <h2 class="arcade-title marquee-glow-text" id="arcade-title">THE BYTE CADE</h2>
        <div class="marquee-fluorescent-tube"></div>
      </div>

      <!-- Right Speaker Grille -->
      <div class="marquee-speaker right">
        <span></span><span></span><span></span><span></span>
      </div>

      <!-- Service / Cabinet Tool Buttons -->
      <div class="arcade-header-actions">
        <button type="button" class="arcade-tool-btn" id="arcade-sound-btn" title="Toggle Cabinet Sound">
          <span id="arcade-sound-icon">🔊</span>
        </button>
        <button type="button" class="arcade-close-btn" id="arcade-modal-close" aria-label="Exit Cabinet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Game Selector Cartridge Strip -->
    <div class="arcade-game-tabs" id="arcade-game-tabs" role="tablist">
      <button type="button" class="arcade-game-tab active" id="tab-game-brawler" data-game="brawler" role="tab" aria-selected="true">
        <span class="game-tab-led"></span>
        <span class="game-tab-icon">🥊</span>
        <span class="game-tab-title">Fighter</span>
      </button>
      <button type="button" class="arcade-game-tab" id="tab-game-snake" data-game="snake" role="tab" aria-selected="false">
        <span class="game-tab-led"></span>
        <span class="game-tab-icon">🐍</span>
        <span class="game-tab-title">Snake</span>
      </button>
      <button type="button" class="arcade-game-tab" id="tab-game-hof" data-game="hof" role="tab" aria-selected="false">
        <span class="game-tab-led"></span>
        <span class="game-tab-icon">🏆</span>
        <span class="game-tab-title">Legends</span>
      </button>
      <button type="button" class="arcade-game-tab" id="tab-game-quests" data-game="quests" role="tab" aria-selected="false">
        <span class="game-tab-led"></span>
        <span class="game-tab-icon">📜</span>
        <span class="game-tab-title">Quests</span>
      </button>
    </div>

    <!-- Vacuum-Fluorescent / LED Score Strip -->
    <div class="arcade-score-bar">
      <div class="score-pill">
        <span class="score-label" id="arcade-score-label">WINS</span>
        <span class="score-val mono-num" id="arcade-current-score">000</span>
      </div>
      <div class="score-pill high-score">
        <span class="score-label" id="arcade-best-label">STREAK</span>
        <span class="score-val mono-num" id="arcade-best-score">000</span>
      </div>
      <div class="score-pill badge-pill" id="arcade-badge-status" title="Defeat Grand Ronin to unlock Arcade Champion badge">
        <span class="score-label">BADGE</span>
        <span class="score-badge-text" id="arcade-badge-text">Locked 🔒</span>
      </div>
    </div>

    <!-- Deep Molded CRT Screen Frame -->
    <div class="crt-screen-frame">
      <!-- Bezel Corner Rivets / Hex Bolts -->
      <div class="bezel-rivet top-left"></div>
      <div class="bezel-rivet top-right"></div>
      <div class="bezel-rivet bot-left"></div>
      <div class="bezel-rivet bot-right"></div>

      <canvas id="arcade-game-canvas" width="400" height="400" class="arcade-canvas"></canvas>
      <div class="crt-scanlines"></div>
      <div class="crt-glare"></div>

      <!-- Start / Game Over Overlay -->
      <div class="crt-overlay" id="arcade-overlay">
        <div class="crt-overlay-content">
          <div class="crt-title" id="overlay-title">SPOT FIGHTER II</div>
          <p class="crt-subtitle" id="overlay-subtitle">Cyber Brawl • 1v1 Retro Arena</p>

          <!-- Fighter Selection Matrix (Street Fighter Style) -->
          <div class="fighter-select-bar" id="overlay-fighter-select">
            <span class="fighter-select-label">SELECT YOUR FIGHTER</span>
            <div class="fighter-portraits-grid" id="fighter-pills-list"></div>
            <div class="fighter-inspect-bar" id="fighter-inspect-bar">
              <span id="fighter-inspect-name" class="fighter-inspect-name">CYBER RONIN</span>
              <span class="inspect-dot">•</span>
              <span id="fighter-inspect-move" class="fighter-inspect-move">SPECIAL: KATANA SURGE</span>
            </div>
          </div>

          <div class="crt-instructions" id="overlay-instructions">
            <span>Movement: <strong>A / D</strong> Move • <strong>W</strong> Jump • <strong>S</strong> Duck</span>
            <span>Attacks: <strong>J</strong> Punch • <strong>K</strong> Kick • <strong>L</strong> Hadouken</span>
          </div>
          <button type="button" class="crt-start-btn" id="overlay-action-btn">INSERT COIN (ROUND 1)</button>
        </div>
      </div>

      <!-- Hall of Fame CRT Overlay -->
      <div class="crt-overlay crt-hof-overlay" id="arcade-hof-overlay" style="display: none;">
        <div class="crt-overlay-content hof-content">
          <div class="crt-title hof-title">★ HALL OF FAME ★</div>
          <p class="crt-subtitle">1984 Cyber All-Time Legends</p>
          <div class="hof-tab-switch">
            <button type="button" class="hof-tab-btn active" id="hof-subtab-brawler">🥊 Spot Fighter</button>
            <button type="button" class="hof-tab-btn" id="hof-subtab-snake">🐍 Byte Snake</button>
          </div>
          <div class="hof-leaderboard-list" id="hof-leaderboard-list"></div>
          <button type="button" class="crt-start-btn hof-action-btn" id="hof-action-btn">INSERT COIN TO PLAY</button>
        </div>
      </div>

      <!-- Daily Quests CRT Overlay -->
      <div class="crt-overlay crt-quests-overlay" id="arcade-quests-overlay" style="display: none;">
        <div class="crt-overlay-content quests-content">
          <div class="crt-title quests-title">DAILY QUESTS</div>
          <p class="crt-subtitle" id="quests-reset-timer">Resetting at Midnight UTC</p>
          <div class="quests-cards-list" id="quests-cards-list"></div>
          <button type="button" class="crt-start-btn quests-claim-btn" id="quests-claim-btn" disabled>
            CLAIM BOUNTY (500 XP)
          </button>
        </div>
      </div>
    </div>

    <!-- Brawler Controller Deck (Active in Spot Fighter II mode) -->
    <div class="brawler-ctrl-deck" id="brawler-ctrl-deck">
      <!-- Left: Movement D-Pad -->
      <div class="brawler-dpad-wrapper">
        <div class="brawler-dpad-grid">
          <button type="button" class="brawler-dpad-btn btn-brawler-up" id="btn-fight-jump" aria-label="Jump">
            <span class="btn-dpad-icon">▲</span>
            <span class="btn-key-hint">W</span>
          </button>
          <div class="brawler-dpad-mid">
            <button type="button" class="brawler-dpad-btn btn-brawler-left" id="btn-fight-left" aria-label="Move Left">
              <span class="btn-dpad-icon">◀</span>
              <span class="btn-key-hint">A</span>
            </button>
            <div class="brawler-dpad-center"></div>
            <button type="button" class="brawler-dpad-btn btn-brawler-right" id="btn-fight-right" aria-label="Move Right">
              <span class="btn-dpad-icon">▶</span>
              <span class="btn-key-hint">D</span>
            </button>
          </div>
          <button type="button" class="brawler-dpad-btn btn-brawler-down" id="btn-fight-crouch" aria-label="Crouch / Duck">
            <span class="btn-dpad-icon">▼</span>
            <span class="btn-key-hint">S</span>
          </button>
        </div>
        <div class="ctrl-helper-label">WASD or D-Pad</div>
      </div>

      <!-- Right: Action Buttons (Punch, Kick, Hadouken Special) -->
      <div class="brawler-actions-wrapper">
        <button type="button" class="fight-action-btn btn-fight-punch" id="btn-fight-punch" aria-label="Punch">
          <span class="action-btn-key">J</span>
          <span class="action-btn-label">PUNCH</span>
        </button>
        <button type="button" class="fight-action-btn btn-fight-kick" id="btn-fight-kick" aria-label="Kick">
          <span class="action-btn-key">K</span>
          <span class="action-btn-label">KICK</span>
        </button>
        <button type="button" class="fight-action-btn btn-fight-special" id="btn-fight-special" aria-label="Hadouken Special">
          <span class="action-btn-key">L</span>
          <span class="action-btn-label">SURGE</span>
          <span class="action-btn-spark">⚡</span>
        </button>
      </div>
    </div>

    <!-- Snake Controller Deck (Active in Byte Snake mode) -->
    <div class="snake-ctrl-deck" id="snake-ctrl-deck" style="display: none;">
      <!-- Controller Mode Selector Tabs -->
      <div class="arcade-ctrl-tabs" id="arcade-ctrl-tabs" role="tablist" aria-label="Controller Selection">
        <button type="button" class="ctrl-tab-btn active" data-mode="joystick" role="tab" aria-selected="true">
          <span class="tab-icon">🕹️</span>
          <span class="tab-label">Joystick</span>
        </button>
        <button type="button" class="ctrl-tab-btn" data-mode="dpad" role="tab" aria-selected="false">
          <span class="tab-icon">🎮</span>
          <span class="tab-label">D-Pad</span>
        </button>
        <button type="button" class="ctrl-tab-btn" data-mode="swipe" role="tab" aria-selected="false">
          <span class="tab-icon">👆</span>
          <span class="tab-label">Swipe Pad</span>
        </button>
      </div>

      <!-- Mode 1: Virtual Touch Joystick -->
      <div class="arcade-ctrl-panel panel-joystick" id="ctrl-panel-joystick">
        <div class="joystick-base" id="joystick-base" role="region" aria-label="Virtual Joystick">
          <div class="joystick-ring-outer"></div>
          <div class="joystick-ring-inner"></div>
          <span class="joy-indicator joy-up" id="joy-dir-up">▲</span>
          <span class="joy-indicator joy-left" id="joy-dir-left">◀</span>
          <span class="joy-indicator joy-right" id="joy-dir-right">▶</span>
          <span class="joy-indicator joy-down" id="joy-dir-down">▼</span>
          <div class="joystick-thumb" id="joystick-thumb">
            <div class="thumb-inner"></div>
          </div>
        </div>
        <div class="ctrl-helper-label">Touch & slide joystick in 360° to steer</div>
      </div>

      <!-- Mode 2: Tactile 4-Way D-Pad -->
      <div class="arcade-ctrl-panel panel-dpad" id="ctrl-panel-dpad" style="display: none;">
        <div class="arcade-dpad-grid">
          <button type="button" class="dpad-btn dpad-up" data-dir="UP" aria-label="Steer Up">
            <span class="dpad-arrow">▲</span>
          </button>
          <div class="dpad-middle-row">
            <button type="button" class="dpad-btn dpad-left" data-dir="LEFT" aria-label="Steer Left">
              <span class="dpad-arrow">◀</span>
            </button>
            <button type="button" class="dpad-btn dpad-center" id="dpad-center-btn" aria-label="Start Game">
              <span class="dpad-dot">●</span>
            </button>
            <button type="button" class="dpad-btn dpad-right" data-dir="RIGHT" aria-label="Steer Right">
              <span class="dpad-arrow">▶</span>
            </button>
          </div>
          <button type="button" class="dpad-btn dpad-down" data-dir="DOWN" aria-label="Steer Down">
            <span class="dpad-arrow">▼</span>
          </button>
        </div>
        <div class="ctrl-helper-label">Tap arrow keys to turn instantly</div>
      </div>

      <!-- Mode 3: Screen Swipe & Gesture Pad -->
      <div class="arcade-ctrl-panel panel-swipe" id="ctrl-panel-swipe" style="display: none;">
        <div class="swipe-touchpad" id="swipe-touchpad" role="region" aria-label="Swipe Touchpad">
          <div class="swipe-guide-arrow guide-up" id="swipe-arrow-up">▲</div>
          <div class="swipe-guide-mid">
            <span class="swipe-guide-arrow guide-left" id="swipe-arrow-left">◀</span>
            <div class="swipe-guide-core">
              <span class="swipe-icon">👆</span>
              <span class="swipe-hint">Swipe anywhere</span>
            </div>
            <span class="swipe-guide-arrow guide-right" id="swipe-arrow-right">▶</span>
          </div>
          <div class="swipe-guide-arrow guide-down" id="swipe-arrow-down">▼</div>
        </div>
        <div class="ctrl-helper-label">Flick or swipe anywhere on the pad or game screen</div>
      </div>
    </div>



  </div>
</div>

<style>
  .arcade-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(5, 8, 15, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 300;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  .arcade-modal-backdrop.open {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .arcade-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: #0d121c;
    border-radius: 20px;
    padding: 16px;
    /* Vintage heavy arcade cabinet chassis with T-molding trim */
    border: 3px solid #1e293b;
    box-shadow:
      0 0 0 1px #0f172a,
      0 0 0 4px #090d16,
      0 0 0 6px #334155,
      0 24px 60px -10px rgba(0, 0, 0, 0.95),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: #f8fafc;
    box-sizing: border-box;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
  }

  /* Cabinet Top Hood & Illuminated Marquee */
  .arcade-cabinet-marquee {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: linear-gradient(180deg, #111827 0%, #080c14 100%);
    border: 2px solid #1f293d;
    border-radius: 12px;
    padding: 8px 12px;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.15),
      inset 0 -2px 6px rgba(0, 0, 0, 0.8),
      0 4px 12px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }

  /* Marquee Stereo Speaker Grilles */
  .marquee-speaker {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 22px;
    flex-shrink: 0;
  }

  .marquee-speaker span {
    display: block;
    height: 3px;
    width: 100%;
    background: #05080e;
    border-radius: 2px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.9);
  }

  /* Center Backlit Marquee Plexiglass Sign */
  .marquee-sign-box {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at 50% 50%, #0d1e38 0%, #070b14 100%);
    border: 1.5px solid rgba(56, 189, 248, 0.35);
    border-radius: 8px;
    padding: 6px 12px;
    box-shadow:
      0 0 16px rgba(56, 189, 248, 0.25),
      inset 0 0 14px rgba(56, 189, 248, 0.2);
  }

  .marquee-sub-badge {
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #facc15;
    text-shadow: 0 0 8px rgba(250, 204, 21, 0.7);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 3px;
  }

  .marquee-glow-text {
    font-family: var(--font-display, monospace);
    font-size: 1.25rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.1em;
    margin: 0;
    line-height: 1.1;
    white-space: nowrap;
    text-shadow:
      0 0 4px #ffffff,
      0 0 10px #38bdf8,
      0 0 20px #0284c7,
      0 0 35px #0369a1;
  }

  .marquee-fluorescent-tube {
    position: absolute;
    bottom: 2px;
    left: 15%;
    right: 15%;
    height: 1.5px;
    background: #e0f2fe;
    box-shadow: 0 0 8px 1px #38bdf8;
    border-radius: 2px;
    opacity: 0.8;
  }

  /* Service / Cabinet Tool Buttons */
  .arcade-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .arcade-tool-btn,
  .arcade-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    background: #111827;
    border: 1.5px solid #374151;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.12s ease;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .arcade-tool-btn:hover,
  .arcade-close-btn:hover {
    background: #1e293b;
    color: #ffffff;
    border-color: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
  }

  .arcade-tool-btn:active,
  .arcade-close-btn:active {
    transform: scale(0.92);
  }

  /* Game Switcher Tabs */
  .arcade-game-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    background: rgba(0, 0, 0, 0.45);
    padding: 4px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .arcade-game-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 9px;
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s ease;
    white-space: nowrap;
    min-width: 0;
  }

  .game-tab-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arcade-game-tab:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.05);
  }

  .arcade-game-tab.active {
    background: rgba(239, 68, 68, 0.18);
    border-color: rgba(239, 68, 68, 0.45);
    color: #fca5a5;
    box-shadow: 0 0 14px rgba(239, 68, 68, 0.25);
  }

  .arcade-game-tab#tab-game-snake.active {
    background: rgba(34, 197, 94, 0.18);
    border-color: rgba(34, 197, 94, 0.45);
    color: #86efac;
    box-shadow: 0 0 14px rgba(34, 197, 94, 0.25);
  }

  .arcade-game-tab#tab-game-hof.active {
    background: rgba(245, 158, 11, 0.18);
    border-color: rgba(245, 158, 11, 0.45);
    color: #fde047;
    box-shadow: 0 0 14px rgba(245, 158, 11, 0.25);
  }

  .arcade-game-tab#tab-game-quests.active {
    background: rgba(168, 85, 247, 0.18);
    border-color: rgba(168, 85, 247, 0.45);
    color: #d8b4fe;
    box-shadow: 0 0 14px rgba(168, 85, 247, 0.25);
  }

  .game-tab-icon {
    font-size: 0.95rem;
  }

  /* Score Bar */
  .arcade-score-bar {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    flex-shrink: 0;
  }

  .score-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gap: 2px;
    min-width: 0;
  }

  .score-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .score-val {
    font-size: 1rem;
    font-weight: 800;
    color: #38bdf8;
    line-height: 1;
  }

  .score-pill.high-score .score-val {
    color: #fbbf24;
  }

  .score-badge-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .score-pill.badge-unlocked .score-badge-text {
    color: #34d399;
  }

  /* CRT Molded Bezel Frame */
  .crt-screen-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 380px;
    background: #060910;
    border-radius: 14px;
    border: 5px solid #161e2e;
    overflow: hidden;
    box-shadow:
      inset 0 0 45px rgba(0, 0, 0, 0.95),
      0 0 0 2px #0a0e17,
      0 8px 24px rgba(0, 0, 0, 0.7);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Bezel Corner Hex Bolts / Rivets */
  .bezel-rivet {
    position: absolute;
    width: 9px;
    height: 9px;
    background: radial-gradient(circle at 35% 35%, #94a3b8 0%, #475569 60%, #1e293b 100%);
    border-radius: 50%;
    border: 1px solid #64748b;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6), 0 1px 3px rgba(0, 0, 0, 0.8);
    z-index: 5;
    pointer-events: none;
  }
  .bezel-rivet::after {
    content: '';
    position: absolute;
    inset: 2.5px;
    background: #0b0f19;
    border-radius: 50%;
  }
  .bezel-rivet.top-left { top: 5px; left: 5px; }
  .bezel-rivet.top-right { top: 5px; right: 5px; }
  .bezel-rivet.bot-left { bottom: 5px; left: 5px; }
  .bezel-rivet.bot-right { bottom: 5px; right: 5px; }

  .arcade-canvas {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }

  .crt-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.02) 0px,
      rgba(255, 255, 255, 0.02) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
  }

  .crt-glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.06) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Overlay */
  .crt-overlay {
    position: absolute;
    inset: 0;
    background: rgba(6, 9, 16, 0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    transition: opacity 0.2s ease;
  }

  .crt-overlay.hidden {
    display: none !important;
    pointer-events: none !important;
    opacity: 0 !important;
  }

  .crt-overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .crt-title {
    font-family: var(--font-display, monospace);
    font-size: 1.6rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.08em;
    text-shadow: 0 0 16px rgba(56, 189, 248, 0.6);
  }

  .crt-subtitle {
    margin: 0;
    font-size: 0.82rem;
    color: #cbd5e1;
  }

  .crt-instructions {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 0.7rem;
    color: #64748b;
  }

  .crt-instructions strong {
    color: #e2e8f0;
  }

  .crt-start-btn {
    margin-top: 4px;
    padding: 10px 22px;
    border-radius: 8px;
    background: #ffffff;
    color: #090d16;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.2);
    transition: all 0.15s ease;
  }

  .crt-start-btn:hover {
    background: #f1f5f9;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.35);
  }

  .crt-start-btn:active {
    transform: scale(0.97);
  }

  /* Hall of Fame & Daily Quests CRT Overlays */
  .hof-content, .quests-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-height: 360px;
  }

  .hof-title {
    color: #f59e0b;
    text-shadow: 0 0 12px rgba(245, 158, 11, 0.6);
    font-size: 1.35rem;
    margin: 0;
  }

  .quests-title {
    color: #c084fc;
    text-shadow: 0 0 12px rgba(192, 132, 252, 0.6);
    font-size: 1.35rem;
    margin: 0;
  }

  .hof-tab-switch {
    display: flex;
    gap: 6px;
    background: rgba(0, 0, 0, 0.5);
    padding: 3px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hof-tab-btn {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #94a3b8;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hof-tab-btn:hover {
    color: #f8fafc;
  }

  .hof-tab-btn.active {
    background: rgba(245, 158, 11, 0.25);
    color: #fef08a;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.35);
  }

  .hof-leaderboard-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px;
    max-height: 180px;
    overflow-y: auto;
  }

  .hof-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.75rem;
  }

  .hof-row.is-current-user {
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.5);
    color: #6ee7b7;
  }

  .hof-rank {
    font-weight: 800;
    width: 24px;
    text-align: left;
  }

  .hof-name {
    font-weight: 700;
    color: #f1f5f9;
    flex: 1;
    text-align: left;
    padding: 0 8px;
  }

  .hof-score {
    font-family: monospace;
    font-weight: 800;
    color: #38bdf8;
  }

  /* Quests Styles */
  .quests-cards-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .quest-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 10px;
    text-align: left;
  }

  .quest-card.completed {
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.1);
  }

  .quest-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quest-title-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .quest-desc-text {
    font-size: 0.65rem;
    color: #94a3b8;
  }

  .quest-status-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
  }

  .quest-status-badge.done {
    background: rgba(34, 197, 94, 0.25);
    color: #4ade80;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.35);
  }

  .quests-claim-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: #334155;
    color: #94a3b8;
    box-shadow: none;
  }

  .quests-claim-btn:not(:disabled) {
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: #ffffff;
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.6);
    animation: pulseGlow 1.5s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }

  /* Street Fighter II Style Character Selection Matrix */
  .fighter-select-bar {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 4px 0;
    width: 100%;
    align-items: center;
  }

  .fighter-select-label {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .fighter-portraits-grid {
    display: flex;
    gap: 6px;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    max-width: 380px;
    padding: 2px;
  }

  .fighter-portrait-tile {
    position: relative;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 6px;
    background: #0d131f;
    border: 2px solid #293548;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.8), 0 2px 5px rgba(0, 0, 0, 0.5);
    padding: 0;
  }

  .fighter-portrait-tile:hover {
    border-color: #38bdf8;
    transform: translateY(-2px) scale(1.06);
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
  }

  .fighter-portrait-tile.active {
    border-color: #f59e0b;
    background: #1e1b10;
    transform: translateY(-2px) scale(1.1);
    box-shadow:
      0 0 14px rgba(245, 158, 11, 0.6),
      inset 0 0 8px rgba(245, 158, 11, 0.3);
  }

  .fighter-portrait-tile canvas {
    width: 24px;
    height: 24px;
    image-rendering: pixelated;
    display: block;
  }

  /* 1P Indicator Tag */
  .fighter-portrait-tile .p1-tag {
    position: absolute;
    top: -5px;
    left: -3px;
    background: #f59e0b;
    color: #000000;
    font-size: 0.52rem;
    font-weight: 900;
    padding: 1px 3px;
    border-radius: 3px;
    line-height: 1;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    display: none;
    animation: p1Blink 0.9s infinite alternate;
  }

  .fighter-portrait-tile.active .p1-tag {
    display: block;
  }

  @keyframes p1Blink {
    0% { opacity: 1; transform: scale(1); }
    100% { opacity: 0.75; transform: scale(1.08); }
  }

  /* Dedicated Fighter Readout Bar */
  .fighter-inspect-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 6px;
    margin-top: 2px;
    max-width: 360px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .fighter-inspect-name {
    font-size: 0.74rem;
    font-weight: 900;
    color: #facc15;
    letter-spacing: 0.08em;
    text-shadow: 0 0 8px rgba(250, 204, 21, 0.5);
    text-transform: uppercase;
  }

  .inspect-dot {
    color: #475569;
    font-size: 0.7rem;
  }

  .fighter-inspect-move {
    font-size: 0.65rem;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 0.04em;
  }

  /* Brawler Controller Deck (Arcade CPO Metal Deck) */
  .brawler-ctrl-deck {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    background: linear-gradient(180deg, #161f2e 0%, #0b0f19 100%);
    border: 2px solid #222e42;
    border-radius: 14px;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.12),
      inset 0 -2px 6px rgba(0, 0, 0, 0.8),
      0 6px 16px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    touch-action: manipulation;
  }

  /* CPO Retro Racing Stripes (Cyan / Magenta / Gold vinyl overlay) */
  .brawler-ctrl-deck::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #06b6d4 0%, #06b6d4 33%, #ec4899 33%, #ec4899 66%, #f59e0b 66%, #f59e0b 100%);
    box-shadow: 0 0 6px rgba(6, 182, 212, 0.5);
  }

  .brawler-dpad-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .brawler-dpad-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .brawler-dpad-mid {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .brawler-dpad-center {
    width: 34px;
    height: 34px;
    background: #0b0f19;
    border-radius: 4px;
    border: 1px solid #1e293b;
  }

  .brawler-dpad-btn {
    width: 38px;
    height: 38px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 6px;
    color: #cbd5e1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.1s ease;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1), 0 3px 6px rgba(0, 0, 0, 0.7);
  }

  .brawler-dpad-btn:hover,
  .brawler-dpad-btn:active,
  .brawler-dpad-btn.pressed {
    background: #334155;
    border-color: #38bdf8;
    color: #38bdf8;
    transform: translateY(2px) scale(0.95);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .btn-dpad-icon {
    font-size: 0.7rem;
    line-height: 1;
  }

  .btn-key-hint {
    font-size: 0.55rem;
    font-weight: 700;
    opacity: 0.6;
    line-height: 1;
  }

  .brawler-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Authentic Convex 3D Arcade Pushbuttons */
  .fight-action-btn {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    border: 2px solid;
    transition: all 0.08s ease;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    /* Deep 3D button collar & shadow */
    box-shadow:
      0 0 0 3px #0f172a,
      0 6px 12px rgba(0, 0, 0, 0.8),
      inset 0 4px 6px rgba(255, 255, 255, 0.4),
      inset 0 -4px 6px rgba(0, 0, 0, 0.6);
  }

  .fight-action-btn:hover {
    transform: translateY(-2px);
  }

  .fight-action-btn:active,
  .fight-action-btn.pressed {
    transform: translateY(4px);
    box-shadow:
      0 0 0 3px #0f172a,
      0 1px 3px rgba(0, 0, 0, 0.9),
      inset 0 2px 3px rgba(255, 255, 255, 0.2),
      inset 0 -1px 3px rgba(0, 0, 0, 0.8);
  }

  .btn-fight-punch {
    background: radial-gradient(circle at 35% 30%, #f87171 0%, #dc2626 50%, #7f1d1d 100%);
    border-color: #fca5a5;
    color: #ffffff;
  }

  .btn-fight-kick {
    background: radial-gradient(circle at 35% 30%, #fde047 0%, #d97706 50%, #78350f 100%);
    border-color: #fef08a;
    color: #ffffff;
  }

  .btn-fight-special {
    background: radial-gradient(circle at 35% 30%, #67e8f9 0%, #0284c7 50%, #0c4a6e 100%);
    border-color: #a5f3fc;
    color: #ffffff;
    box-shadow:
      0 0 0 3px #0f172a,
      0 6px 14px rgba(6, 182, 212, 0.4),
      inset 0 4px 6px rgba(255, 255, 255, 0.5),
      inset 0 -4px 6px rgba(0, 0, 0, 0.6);
  }

  .action-btn-key {
    font-size: 0.68rem;
    font-weight: 900;
    opacity: 0.9;
    line-height: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }

  .action-btn-label {
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
    margin-top: 2px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .action-btn-spark {
    position: absolute;
    top: 4px;
    right: 6px;
    font-size: 0.65rem;
  }

  /* Controller Selection Tabs */
  .arcade-ctrl-tabs {
    display: flex;
    gap: 6px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 4px;
    user-select: none;
  }

  .ctrl-tab-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 7px;
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
    touch-action: manipulation;
  }

  .ctrl-tab-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.04);
  }

  .ctrl-tab-btn.active {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.32);
    color: #38bdf8;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .tab-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  .tab-label {
    letter-spacing: 0.02em;
  }

  /* Controller Panels Shared */
  .arcade-ctrl-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-height: 148px;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
  }

  .ctrl-helper-label {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
  }

  /* Mode 1: Virtual Touch Joystick */
  .joystick-base {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.95) 0%, rgba(8, 12, 22, 0.98) 100%);
    border: 1.5px solid rgba(56, 189, 248, 0.28);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.8),
      0 12px 28px -4px rgba(0, 0, 0, 0.7),
      inset 0 0 20px rgba(56, 189, 248, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    cursor: grab;
  }

  .joystick-base:active {
    cursor: grabbing;
  }

  .joystick-ring-outer {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    border: 1px dashed rgba(56, 189, 248, 0.16);
    pointer-events: none;
  }

  .joystick-ring-inner {
    position: absolute;
    inset: 26px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }

  .joy-indicator {
    position: absolute;
    font-size: 0.7rem;
    color: rgba(148, 163, 184, 0.35);
    pointer-events: none;
    transition: color 0.12s, transform 0.12s, text-shadow 0.12s;
    line-height: 1;
  }

  .joy-up { top: 8px; left: 50%; transform: translateX(-50%); }
  .joy-down { bottom: 8px; left: 50%; transform: translateX(-50%); }
  .joy-left { left: 8px; top: 50%; transform: translateY(-50%); }
  .joy-right { right: 8px; top: 50%; transform: translateY(-50%); }

  .joy-indicator.active {
    color: #38bdf8;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.9);
    transform: translateX(-50%) scale(1.3);
  }
  .joy-left.active, .joy-right.active {
    transform: translateY(-50%) scale(1.3);
  }

  .joystick-thumb {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #38bdf8 0%, #0284c7 60%, #0369a1 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    box-shadow:
      0 6px 16px rgba(0, 0, 0, 0.6),
      0 0 16px rgba(56, 189, 248, 0.45),
      inset 0 2px 4px rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .joystick-thumb.dragging {
    transition: none;
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.7),
      0 0 22px rgba(56, 189, 248, 0.65),
      inset 0 2px 5px rgba(255, 255, 255, 0.55);
  }

  .thumb-inner {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.45);
  }

  /* Mode 2: Tactile 4-Way D-Pad */
  .arcade-dpad-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .dpad-middle-row {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .dpad-btn {
    width: 52px;
    height: 42px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
    touch-action: none;
    transition: all 0.1s ease;
  }

  .dpad-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .dpad-btn:active,
  .dpad-btn.active {
    background: rgba(56, 189, 248, 0.25);
    border-color: #38bdf8;
    color: #38bdf8;
    transform: scale(0.93);
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.5);
  }

  .dpad-center {
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.25);
    color: #38bdf8;
  }

  .dpad-arrow {
    line-height: 1;
    pointer-events: none;
  }

  .dpad-dot {
    font-size: 0.8rem;
    line-height: 1;
    pointer-events: none;
  }

  /* Mode 3: Screen Swipe Gesture Pad */
  .swipe-touchpad {
    width: 100%;
    max-width: 280px;
    height: 116px;
    border-radius: 12px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.9) 0%, rgba(8, 12, 22, 0.95) 100%);
    border: 1px dashed rgba(56, 189, 248, 0.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    touch-action: none;
    cursor: grab;
    user-select: none;
