---
/**
 * BannerModal — Interactive Sponsorship & Billboard Information Modal for Spot World.
 */
---

<div class="banner-modal-backdrop modal-backdrop" id="banner-modal-backdrop" aria-hidden="true">
  <div class="banner-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="banner-modal-title">
    <button class="modal-close-btn" id="banner-modal-close" aria-label="Close billboard modal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="banner-modal-header">
      <div class="banner-icon-badge" id="banner-modal-icon-badge">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      </div>

      <div class="banner-header-text">
        <div class="banner-district-tag" id="banner-modal-district">Grand Central Plaza</div>
        <h2 class="banner-modal-title" id="banner-modal-title">Sponsor Billboard</h2>
        <div class="banner-coords mono-num" id="banner-modal-coords">Grid: (48, 47)</div>
      </div>
    </div>

    <!-- Holographic Display Preview Box -->
    <div class="banner-preview-screen" id="banner-modal-preview">
      <div class="screen-scanlines"></div>
      
      <div class="screen-top-bar">
        <div class="screen-tag" id="banner-modal-tag">FEATURED SPONSOR</div>
      </div>

      <!-- Prominent Billboard Cover Banner (When custom / OG image exists) -->
      <div class="screen-cover-wrap" id="banner-preview-logo-wrap" style="display: none;">
        <img id="banner-preview-logo-img" class="screen-cover-image" alt="Sponsor Banner Cover" />
        <div class="screen-cover-overlay"></div>
      </div>

      <div class="screen-headline" id="banner-modal-headline">COMING SOON...</div>
      <div class="screen-subtext" id="banner-modal-subtext">Featured Project / Brand Space</div>
      <div class="screen-status-bar" id="banner-modal-status-bar">
        <span class="screen-led-pip" id="banner-preview-led"></span>
        <span id="banner-modal-status">Reservation Available</span>
        <span class="screen-expiry-badge" id="banner-modal-expiry" style="display: none;">
          <span class="expiry-icon">⏳</span>
          <span id="banner-modal-expiry-text">--</span>
        </span>
      </div>
    </div>

    <div class="banner-modal-body">
      <!-- Live Ad Customizer Form (Shown when booking) -->
      <div class="banner-customizer-card" id="banner-customizer-card">
        <div class="customizer-title-row">
          <span class="customizer-badge">⚡ DESIGN YOUR AD</span>
          <span class="customizer-hint">Live preview reflects above</span>
        </div>

        <div class="banner-inputs-grid">
          <div class="banner-field">
            <label for="banner-input-name" class="banner-field-label">Brand / Sponsor Name *</label>
            <input
              type="text"
              id="banner-input-name"
              class="banner-text-input"
              placeholder="E.g. Acme Cloud Corp"
              maxlength="30"
              autocomplete="off"
            />
          </div>

          <div class="banner-field">
            <label for="banner-input-url" class="banner-field-label">Destination Website URL *</label>
            <input
              type="url"
              id="banner-input-url"
              class="banner-text-input mono-font"
              placeholder="https://yourproduct.com"
              autocomplete="off"
            />
          </div>

          <div class="banner-field">
            <label for="banner-input-headline" class="banner-field-label">Headline / Marquee Text (Optional)</label>
            <input
              type="text"
              id="banner-input-headline"
              class="banner-text-input mono-font"
              placeholder="E.g. DEPLOY WITH ACME"
              maxlength="24"
              autocomplete="off"
            />
          </div>

          <div class="banner-field">
            <label for="banner-input-subtext" class="banner-field-label">Tagline / Subtext (Optional)</label>
            <input
              type="text"
              id="banner-input-subtext"
              class="banner-text-input"
              placeholder="E.g. Instant cloud hosting for builders"
              maxlength="45"
              autocomplete="off"
            />
          </div>

          <div class="banner-field">
            <label for="banner-input-image" class="banner-field-label">Logo or Banner Image Link (Optional)</label>
            <input
              type="url"
              id="banner-input-image"
              class="banner-text-input mono-font"
              placeholder="https://yourproduct.com/logo.png"
              autocomplete="off"
            />
          </div>

          <div class="banner-field">
            <label class="banner-field-label">Neon Accent Theme</label>
            <div class="banner-color-pips" id="banner-color-pips">
              <button type="button" class="color-pip active" data-color="#00f0ff" style="--pip-color: #00f0ff;" title="Cyber Cyan"></button>
              <button type="button" class="color-pip" data-color="#ec4899" style="--pip-color: #ec4899;" title="Neon Magenta"></button>
              <button type="button" class="color-pip" data-color="#a3e635" style="--pip-color: #a3e635;" title="Electric Lime"></button>
              <button type="button" class="color-pip" data-color="#f59e0b" style="--pip-color: #f59e0b;" title="Solar Amber"></button>
              <button type="button" class="color-pip" data-color="#c084fc" style="--pip-color: #c084fc;" title="Cosmic Violet"></button>
            </div>
          </div>

          <div class="banner-policy-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="policy-icon">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span><strong>Guidelines:</strong> Tech tools, SaaS, startups, portfolios & creator products only. Crypto/tokens, gambling, alcohol/drinks, and adult/NSFW content are strictly prohibited.</span>
          </div>
        </div>
      </div>

      <!-- Citizen Sponsor Card (Shown only when sponsor is a registered citizen) -->
      <div class="banner-citizen-card" id="banner-citizen-card" style="display: none;">
        <div class="citizen-card-avatar-wrap">
          <canvas id="banner-citizen-avatar-canvas" width="36" height="36" class="citizen-avatar-canvas"></canvas>
        </div>
        <div class="citizen-card-meta">
          <div class="citizen-card-header">
            <span class="citizen-name" id="banner-citizen-name">Citizen Sponsor</span>
            <span class="citizen-verified-pip" id="banner-citizen-verified" title="Verified Citizen">✓</span>
          </div>
          <div class="citizen-card-sub">
            <button type="button" class="citizen-plot-btn" id="banner-citizen-plot-btn">
              <span>📍 Plot</span>
              <strong id="banner-citizen-plot-coords">(??, ??)</strong>
            </button>
            <span class="citizen-role-pill">Verified Citizen</span>
          </div>
        </div>
      </div>

      <!-- Guest Sponsor Card (Shown only when sponsor is a guest) -->
      <div class="banner-guest-card" id="banner-guest-card" style="display: none;">
        <div class="guest-card-icon">🌐</div>
        <div class="guest-card-meta">
          <div class="guest-card-title" id="banner-guest-title">Verified Brand Partner</div>
          <div class="guest-card-sub" id="banner-guest-sub">Digital Space Sponsorship</div>
        </div>
      </div>

      <p class="banner-modal-desc" id="banner-modal-desc">
        Spot World features spatial project & brand placements. Promote your developer tool, SaaS, startup, or open-source community directly in front of thousands of active digital citizens.
      </p>
    </div>

    <div class="banner-modal-footer">
      <!-- Full-Width Primary Action when active: Visit Website -->
      <a href="#" target="_blank" rel="noopener noreferrer" class="btn-banner-visit" id="btn-banner-visit" style="display: none;">
        <span>Visit Sponsor Website</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>

      <!-- Secondary Action Row -->
      <div class="banner-footer-row">
        <button type="button" class="btn-banner-notify" id="btn-banner-notify">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span id="btn-banner-action-text">Book Billboard ($10 – $35) ⚡</span>
        </button>

        <button type="button" class="btn-banner-dismiss" id="btn-banner-dismiss">
          Close Preview
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .banner-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(8, 11, 18, 0.84);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 295;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  .banner-modal-backdrop.open {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .banner-card {
    position: relative;
    width: min(92vw, 490px);
    background: rgba(13, 18, 28, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    padding: 22px 20px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.7),
      0 32px 64px -12px rgba(0, 0, 0, 0.85),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
    animation: modalPop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }

  .banner-card::-webkit-scrollbar {
    width: 5px;
  }

  .banner-card::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.2);
  }

  .banner-card::-webkit-scrollbar-thumb {
    background: rgba(245, 158, 11, 0.3);
    border-radius: 4px;
  }

  .banner-card::-webkit-scrollbar-thumb:hover {
    background: rgba(245, 158, 11, 0.5);
  }

  @keyframes modalPop {
    from { transform: scale(0.94) translateY(8px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .modal-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    z-index: 2;
  }

  .modal-close-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .banner-modal-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 36px;
    flex-shrink: 0;
  }

  .banner-icon-badge {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--accent-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .banner-header-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .banner-district-tag {
    font-family: var(--font-tech);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-amber);
  }

  .banner-modal-title {
    font-family: var(--font-tech);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: 0.02em;
    word-break: break-word;
  }

  .banner-coords {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* ── Holographic Screen Preview ────────────────────────────────────────── */
  .banner-preview-screen {
    position: relative;
    flex-shrink: 0;
    min-height: 124px;
    width: 100%;
    box-sizing: border-box;
    background: #080c14;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px 14px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 8px 24px rgba(0, 0, 0, 0.55);
  }

  .screen-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
  }

  .screen-top-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
  }

  .screen-tag {
    font-family: var(--font-tech);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 2px 10px;
    border-radius: 4px;
  }

  .screen-cover-wrap {
    position: relative;
    width: 100%;
    max-height: 130px;
    margin: 4px 0 10px 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #05080f;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), 0 0 16px rgba(0, 240, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen-cover-image {
    width: 100%;
    height: 130px;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.25s ease;
  }

  .screen-cover-wrap:hover .screen-cover-image {
    transform: scale(1.02);
  }

  .screen-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(8, 12, 20, 0.05) 0%, rgba(8, 12, 20, 0.35) 100%);
    pointer-events: none;
  }

  .screen-headline {
    font-family: var(--font-tech);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #f8fafc;
    text-shadow: 0 0 14px rgba(245, 158, 11, 0.6);
    line-height: 1.25;
    margin: 2px 0 4px 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .screen-subtext {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 0 0 10px 0;
    line-height: 1.35;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .screen-status-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-tech);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 4px 12px;
    border-radius: 20px;
    flex-wrap: wrap;
    max-width: 100%;
    word-break: break-word;
  }

  .screen-led-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.35);
    flex-shrink: 0;
  }

  .screen-expiry-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 12px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.2);
    border: 1px solid rgba(56, 189, 248, 0.4);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .screen-expiry-badge.urgent {
    color: #f87171;
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.5);
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.3);
  }

  /* ── Modal Body & Customizer Form ─────────────────────────────────────── */
  .banner-modal-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .banner-customizer-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }

  .customizer-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
    gap: 4px;
  }

  .customizer-badge {
    font-family: var(--font-tech);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-cyan, #00f0ff);
  }

  .customizer-hint {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .banner-inputs-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .banner-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .banner-field-label {
    font-family: var(--font-tech);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .banner-text-input {
    width: 100%;
    padding: 8px 10px;
    min-height: 36px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 0.78rem;
    outline: none;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .banner-text-input:focus {
    border-color: #00f0ff;
    box-shadow: 0 0 0 2px rgba(0, 240, 255, 0.2);
    background: rgba(15, 23, 42, 0.95);
  }

  .banner-text-input::placeholder {
    color: rgba(148, 163, 184, 0.45);
  }

  .mono-font {
    font-family: var(--font-mono);
  }

  .banner-color-pips {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }

  .color-pip {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    border-radius: 50%;
    background: var(--pip-color);
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .color-pip:hover {
    transform: scale(1.15);
  }

  .color-pip.active {
    border-color: #ffffff;
    box-shadow: 0 0 10px var(--pip-color);
    transform: scale(1.18);
  }

  .banner-policy-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 12px;
    margin-top: 4px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .banner-policy-note strong {
    color: #f1f5f9;
  }

  .policy-icon {
    color: #94a3b8;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── Citizen & Guest Sponsor Cards ───────────────────────────────────── */
  .banner-citizen-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
  }

  .citizen-card-avatar-wrap {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .citizen-avatar-canvas {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
  }

  .citizen-card-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }

  .citizen-card-header {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .citizen-name {
    font-family: var(--font-tech);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .citizen-verified-pip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #38bdf8;
    color: #0b0f17;
    font-size: 0.6rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .citizen-card-sub {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

