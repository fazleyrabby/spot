---
/**
 * SecretModal — Interactive landmark and easter egg discovery modal in Spot World.
 */
---

<div class="secret-modal-backdrop modal-backdrop" id="secret-modal-backdrop" aria-hidden="true">
  <div class="secret-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="secret-title">
    <button class="modal-close-btn" id="secret-modal-close" aria-label="Close discovery">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="secret-header">
      <div class="secret-icon-frame" id="secret-icon-frame">
        <span class="secret-icon" id="secret-icon">🌟</span>
      </div>

      <div class="secret-meta">
        <div class="secret-district-badge" id="secret-district">Central Park</div>
        <h2 class="secret-title" id="secret-title">The Genesis Monolith</h2>
        <p class="secret-subtitle" id="secret-subtitle">Spot #0 Historical Artifact</p>
      </div>
    </div>

    <div class="secret-body">
      <div class="secret-quote-box" id="secret-quote-box" style="display: none;">
        <p class="secret-quote" id="secret-quote"></p>
      </div>

      <p class="secret-desc" id="secret-desc">
        Discover historical lore, easter eggs, and secret treasures across Spot World.
      </p>

      <div class="secret-reward-badge" id="secret-reward-badge" style="display: none;">
        <span class="reward-icon">🏆</span>
        <span id="secret-reward-text">Badge Unlocked!</span>
      </div>
    </div>

    <div class="secret-footer">
      <a href="#" target="_blank" rel="noopener noreferrer" class="secret-action-btn" id="secret-action-btn" style="display: none;">
        <span>Open Resource</span>
      </a>
      <button type="button" class="secret-dismiss-btn" id="secret-dismiss-btn">
        Close Discovery
      </button>
    </div>
  </div>
</div>

<style>
  .secret-card {
    position: relative;
    width: 90vw;
    max-width: 480px;
    background: rgba(15, 23, 42, 0.94);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(245, 158, 11, 0.15);
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop {
    from { transform: scale(0.92) translateY(12px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .secret-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .secret-icon-frame {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(56, 189, 248, 0.2));
    border: 1.5px solid rgba(245, 158, 11, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.2);
    flex-shrink: 0;
  }

  .secret-icon {
    font-size: 2rem;
  }

  .secret-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .secret-district-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fbbf24;
    font-family: var(--font-mono, monospace);
  }

  .secret-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .secret-subtitle {
    margin: 0;
    font-size: 0.82rem;
    color: #94a3b8;
  }

  .secret-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .secret-quote-box {
    background: rgba(30, 41, 59, 0.7);
    border-left: 3px solid #fbbf24;
    border-radius: 6px;
    padding: 10px 14px;
  }

  .secret-quote {
    margin: 0;
    font-size: 0.85rem;
    font-style: italic;
    color: #fef08a;
    line-height: 1.45;
  }

  .secret-desc {
    margin: 0;
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .secret-reward-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 9999px;
    padding: 6px 14px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #34d399;
    align-self: flex-start;
  }

  .secret-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .secret-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 18px;
    border-radius: 10px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
  }

  .secret-action-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
  }

  .secret-dismiss-btn {
    padding: 9px 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .secret-dismiss-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #f8fafc;
  }
</style>
