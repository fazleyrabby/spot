---
/**
 * CitizenSearchModal — Quick search & GPS navigation modal for Spot World.
 */
---

<div class="search-modal-backdrop modal-backdrop" id="search-modal-backdrop" aria-hidden="true">
  <div class="search-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
    <!-- Header with Search Input -->
    <div class="search-header">
      <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="citizen-search-input"
        class="search-input"
        placeholder="Search citizens by name, bio, or spot (e.g. 52, 60)…"
        autocomplete="off"
      />
      <button class="search-close-btn" id="search-modal-close" aria-label="Close search">
        <kbd class="search-esc-kbd">ESC</kbd>
      </button>
    </div>

    <!-- Live Results Container -->
    <div class="search-results" id="search-results-list">
      <p class="search-empty-state">Type a citizen name or coordinates to search.</p>
    </div>

    <!-- Footer with Tips -->
    <div class="search-footer">
      <span>💡 Pro-tip: Press <kbd>Cmd</kbd>+<kbd>K</kbd> anytime to search & navigate</span>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 18, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 250;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  .search-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-card {
    position: relative;
    width: 92vw;
    max-width: 560px;
    background: rgba(15, 23, 42, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85), 0 0 40px rgba(56, 189, 248, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: searchPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes searchPop {
    from { transform: scale(0.95) translateY(8px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(30, 41, 59, 0.4);
  }

  .search-input-icon {
    color: #38bdf8;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: #f8fafc;
    font-size: 0.98rem;
    font-weight: 600;
    font-family: inherit;
    outline: none;
  }

  .search-input::placeholder {
    color: #64748b;
    font-weight: 400;
  }

  .search-close-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .search-esc-kbd {
    display: inline-block;
    padding: 3px 7px;
    font-size: 0.70rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
  }

  .search-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .search-empty-state {
    text-align: center;
    color: #64748b;
    font-size: 0.86rem;
    padding: 36px 12px;
    margin: 0;
  }

  .search-result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .search-result-item:hover {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.35);
    transform: translateY(-1px);
  }

  .search-result-left {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    overflow: hidden;
  }

  .search-result-avatar {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }

  .search-result-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }

  .search-result-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .search-result-name {
    font-size: 0.90rem;
    font-weight: 700;
    color: #f8fafc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-result-coords-chip {
    font-size: 0.70rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.15);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid rgba(56, 189, 248, 0.25);
    flex-shrink: 0;
  }

  .search-result-tagline {
    font-size: 0.76rem;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-result-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-search-gps, .btn-search-fly {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    border: none;
    white-space: nowrap;
  }

  .btn-search-gps {
    background: rgba(245, 158, 11, 0.18);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .btn-search-gps:hover {
    background: #f59e0b;
    color: #0f172a;
    transform: scale(1.04);
  }

  .btn-search-fly {
    background: rgba(56, 189, 248, 0.18);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.4);
  }

  .btn-search-fly:hover {
    background: #38bdf8;
    color: #0f172a;
    transform: scale(1.04);
  }

  .search-footer {
    padding: 10px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.74rem;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(15, 23, 42, 0.6);
  }

  .search-footer kbd {
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 4px;
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: #94a3b8;
  }
</style>
