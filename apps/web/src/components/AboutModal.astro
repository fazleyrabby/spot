---
// About Modal Component
---

<div class="modal-backdrop" id="about-modal-backdrop" aria-hidden="true">
  <div class="about-modal-box" id="about-modal" role="dialog" aria-modal="true" aria-labelledby="about-modal-title">
    <!-- Header -->
    <div class="about-header">
      <div class="about-header-left">
        <div class="about-icon-circle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </div>
        <div class="about-title-group">
          <div class="about-badge">INTERNET EXPERIMENT</div>
          <h2 class="about-title" id="about-modal-title">About SPOT</h2>
        </div>
      </div>
      <button type="button" class="about-close-btn" id="about-modal-close" aria-label="Close modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Body Content -->
    <div class="about-body">
      <!-- Overview Card -->
      <div class="about-overview-card">
        <h3 class="about-tagline">Your permanent place on the Internet</h3>
        <p class="about-desc">
          SPOT is a shared Internet canvas with <strong>10,000 places</strong>. Pick an avatar, choose your spot, and leave your mark among makers, coders, and internet wanderers.
        </p>
      </div>

      <!-- How it Works Steps -->
      <div class="about-section-label">HOW IT WORKS</div>
      <div class="about-steps-grid">
        <div class="about-step-card">
          <div class="step-num-badge">1</div>
          <div class="step-content">
            <h4 class="step-title">Pick an Avatar</h4>
            <p class="step-desc">Choose from our pixel sprite catalog or upload a custom image avatar.</p>
          </div>
        </div>

        <div class="about-step-card">
          <div class="step-num-badge">2</div>
          <div class="step-content">
            <h4 class="step-title">Claim Any Spot</h4>
            <p class="step-desc">Browse the 100×100 grid and pick an available coordinate anywhere in the city.</p>
          </div>
        </div>

        <div class="about-step-card">
          <div class="step-num-badge">3</div>
          <div class="step-content">
            <h4 class="step-title">Leave Your Mark</h4>
            <p class="step-desc">Add your name, bio, and a link to your portfolio, blog, or project.</p>
          </div>
        </div>
      </div>

      <!-- Key Highlights -->
      <div class="about-highlights-grid">
        <div class="highlight-item">
          <span class="highlight-icon">🗺️</span>
          <div class="highlight-text">
            <strong>10,000 Unique Spots</strong>
            <span>One spot per human on a persistent map</span>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">✨</span>
          <div class="highlight-text">
            <strong>100% Free Forever</strong>
            <span>No subscription or paywalls required</span>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">🛡️</span>
          <div class="highlight-text">
            <strong>GitHub Verified</strong>
            <span>Link GitHub to get your verified citizen badge</span>
          </div>
        </div>
        <div class="highlight-item">
          <span class="highlight-icon">🎮</span>
          <div class="highlight-text">
            <strong>Living Spot World</strong>
            <span>Explore in full top-down isometric view</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="about-modal-footer">
      <span class="about-footer-note">Free to join • Built for the open web</span>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  .modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .about-modal-box {
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    background: #141720;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 30px 70px -10px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transform: scale(0.95) translateY(10px);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    color: #f8fafc;
    font-family: inherit;
    box-sizing: border-box;
    overflow-y: auto;
  }

  .about-modal-box * {
    box-sizing: border-box;
  }

  .modal-backdrop.open .about-modal-box {
    transform: scale(1) translateY(0);
  }

  /* Header */
  .about-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 18px;
    flex-shrink: 0;
  }

  .about-header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .about-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #1e2430;
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-amber, #f59e0b);
    flex-shrink: 0;
  }

  .about-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about-badge {
    font-family: var(--font-tech, sans-serif);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-amber, #f59e0b);
    text-transform: uppercase;
  }

  .about-title {
    font-family: var(--font-tech, sans-serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: 0.03em;
    margin: 0;
  }

  .about-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .about-close-btn:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Body */
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-overview-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .about-tagline {
    margin: 0 0 6px 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .about-desc {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #94a3b8;
  }

  .about-desc strong {
    color: #f1f5f9;
  }

  .about-section-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #64748b;
    margin-top: 2px;
  }

  .about-steps-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .about-step-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #171b24;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 10px 14px;
  }

  .step-num-badge {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: var(--accent-amber, #f59e0b);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .step-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .step-desc {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: #94a3b8;
  }

  .about-highlights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 8px 10px;
  }

  .highlight-icon {
    font-size: 1rem;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .highlight-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .highlight-text strong {
    font-size: 0.76rem;
    color: #e2e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .highlight-text span {
    font-size: 0.68rem;
    color: #64748b;
    line-height: 1.3;
  }

  /* Footer */
  .about-modal-footer {
    margin-top: 18px;
    text-align: center;
    flex-shrink: 0;
  }

  .about-footer-note {
    font-size: 0.76rem;
    color: #64748b;
    font-family: var(--font-tech, sans-serif);
    letter-spacing: 0.03em;
  }

  @media (max-width: 520px) {
    .about-modal-box {
      padding: 18px 14px;
    }
    .about-highlights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
