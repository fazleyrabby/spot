---
// Support Modal Component matching portfolio design
---

<div class="modal-backdrop" id="support-modal-backdrop" aria-hidden="true">
  <div class="support-modal-box" id="support-modal">
    <!-- Header -->
    <div class="support-header">
      <div class="support-header-left">
        <div class="support-icon-circle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
        </div>
        <div class="support-title-group">
          <h2 class="support-title">Support the Project</h2>
          <p class="support-subtitle">Keep open source work & creative coding alive</p>
        </div>
      </div>
      <button type="button" class="support-close-btn" id="support-modal-close" aria-label="Close modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="1" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Cards Container -->
    <div class="support-cards-list">
      <!-- 1. SupportKori (Bangladesh) -->
      <a href="https://supportkori.com/fazleyrabbi" target="_blank" rel="noopener noreferrer" class="support-tier-card card-kori">
        <div class="tier-card-left">
          <div class="tier-icon-badge kori-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <div class="tier-info">
            <span class="tier-title">SupportKori</span>
            <div class="tier-tag-pill kori-tag">
              <span>🇧🇩 BD USERS / BKASH • NAGAD</span>
            </div>
            <span class="tier-desc">For Bangladesh users (BDT ৳)</span>
          </div>
        </div>
        <div class="tier-action-btn kori-btn">
          <span>Support ৳</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>

      <!-- 2. Buy Me a Coffee (Global) -->
      <a href="https://buymeacoffee.com/fazleyrabbi" target="_blank" rel="noopener noreferrer" class="support-tier-card card-bmc">
        <div class="tier-card-left">
          <div class="tier-icon-badge bmc-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
              <line x1="6" y1="1" x2="6" y2="4"></line>
              <line x1="10" y1="1" x2="10" y2="4"></line>
              <line x1="14" y1="1" x2="14" y2="4"></line>
            </svg>
          </div>
          <div class="tier-info">
            <span class="tier-title">Buy Me a Coffee</span>
            <div class="tier-tag-pill bmc-tag">
              <span>GLOBAL / INTERNATIONAL</span>
            </div>
            <span class="tier-desc">Card, Apple Pay, Google Pay ($)</span>
          </div>
        </div>
        <div class="tier-action-btn bmc-btn">
          <span>Donate $3</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>

    <!-- Section Divider -->
    <div class="support-divider">
      <div class="divider-line"></div>
      <span class="divider-text">OR VIA DIRECT PAYONEER ($0 FEE)</span>
      <div class="divider-line"></div>
    </div>

    <!-- Payoneer Box -->
    <div class="payoneer-box" id="btn-copy-payoneer">
      <div class="payoneer-top-row">
        <span class="payoneer-label">Payoneer Customer ID:</span>
        <span class="payoneer-fee-tag">$0 Fee Direct</span>
      </div>

      <div class="payoneer-id-display">
        <span class="payoneer-id-value" id="payoneer-id-number">24076084</span>
        <button type="button" class="payoneer-copy-btn" id="btn-payoneer-copy-action" title="Copy Payoneer ID">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="payoneer-copy-label">Copy ID</span>
        </button>
      </div>

      <div class="payoneer-tip">
        <span class="tip-bulb">💡</span>
        <span class="tip-text">Payoneer app: Go to <strong>Pay → Pay to recipient</strong> → Enter ID <strong class="gold-id">24076084</strong> or <strong class="gold-id">fazley111@gmail.com</strong>.</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="support-modal-footer">
      <span class="footer-thankyou">Thank you for your support! ✨</span>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  .modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .support-modal-box {
    width: 100%;
    max-width: 490px;
    background: #141720;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 26px 24px 22px 24px;
    box-shadow: 0 30px 70px -10px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transform: scale(0.95) translateY(10px);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    color: #f8fafc;
    font-family: inherit;
    box-sizing: border-box;
  }

  .support-modal-box * {
    box-sizing: border-box;
  }

  .modal-backdrop.open .support-modal-box {
    transform: scale(1) translateY(0);
  }

  /* Header */
  .support-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .support-header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .support-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #1e2430;
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e2e8f0;
    flex-shrink: 0;
  }

  .support-title-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .support-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #f8fafc;
    font-family: Georgia, serif;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .support-subtitle {
    font-size: 0.82rem;
    color: #94a3b8;
    margin: 0;
  }

  .support-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .support-close-btn:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Cards List */
  .support-cards-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .support-tier-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  /* SupportKori Styling */
  .card-kori {
    background: #0d1a18;
    border: 1px solid #144738;
  }

  .card-kori:hover {
    border-color: #00df89;
    box-shadow: 0 0 25px -5px rgba(0, 223, 137, 0.25);
    transform: translateY(-1px);
  }

  .kori-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #00df89;
    color: #081610;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .kori-tag {
    background: rgba(0, 223, 137, 0.12);
    border: 1px solid rgba(0, 223, 137, 0.3);
    color: #00df89;
  }

  .kori-btn {
    background: #00df89;
    color: #081610;
    font-weight: 700;
  }

  .kori-btn:hover {
    background: #1aff9d;
    transform: scale(1.02);
  }

  /* Buy Me a Coffee Styling */
  .card-bmc {
    background: #1b190f;
    border: 1px solid #473a11;
  }

  .card-bmc:hover {
    border-color: #ffdd00;
    box-shadow: 0 0 25px -5px rgba(255, 221, 0, 0.25);
    transform: translateY(-1px);
  }

  .bmc-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #ffdd00;
    color: #141002;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bmc-tag {
    background: rgba(255, 221, 0, 0.12);
    border: 1px solid rgba(255, 221, 0, 0.3);
    color: #ffdd00;
  }

  .bmc-btn {
    background: #ffdd00;
    color: #141002;
    font-weight: 700;
  }

  .bmc-btn:hover {
    background: #ffe433;
    transform: scale(1.02);
  }

  /* Card Interior */
  .tier-card-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .tier-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tier-title {
    font-size: 1.02rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .tier-tag-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 5px;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .tier-desc {
    font-size: 0.76rem;
    color: #94a3b8;
  }

  .tier-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 15px;
    border-radius: 9px;
    font-size: 0.85rem;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  /* Divider */
  .support-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 16px 0;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .divider-text {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: #64748b;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* Payoneer Box */
  .payoneer-box {
    background: #171b24;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    cursor: pointer;
  }

  .payoneer-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .payoneer-label {
    font-size: 0.85rem;
    color: #94a3b8;
    font-family: var(--font-mono);
  }

  .payoneer-fee-tag {
    font-size: 0.85rem;
    color: #00df89;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .payoneer-id-display {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0b0d13;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px 8px 16px;
  }

  .payoneer-id-value {
    font-size: 1.18rem;
    font-weight: 700;
    color: #ffdd00;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .payoneer-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #1e2430;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f1f5f9;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .payoneer-copy-btn:hover {
    background: #2a3344;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .payoneer-tip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 0.74rem;
    color: #94a3b8;
  }

  .tip-bulb {
    font-size: 0.85rem;
  }

  .gold-id {
    color: #ffdd00;
  }

  /* Footer */
  .support-modal-footer {
    margin-top: 18px;
    text-align: center;
  }

  .footer-thankyou {
    font-size: 0.8rem;
    color: #64748b;
  }

  @media (max-width: 520px) {
    .support-modal-box {
      padding: 20px 16px;
    }
    .support-tier-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .tier-action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
