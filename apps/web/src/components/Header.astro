---
interface Props {
  totalSpots?: number;
  claimedCount?: number;
  onlineCount?: number;
}

const {
  totalSpots = 10000,
  claimedCount = 0,
  onlineCount = 0,
} = Astro.props;

const pct = Math.round((claimedCount / totalSpots) * 100);
---

<header class="header-hud glass-panel" id="header-hud">
  <div class="hud-left">
    <a href="/" class="brand-badge" title="SPOT — Internet Canvas">
      <span class="brand-glyph" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <rect x="2" y="2" width="9" height="9" rx="2"></rect>
          <rect x="13" y="2" width="9" height="9" rx="2" opacity="0.4"></rect>
          <rect x="2" y="13" width="9" height="9" rx="2" opacity="0.4"></rect>
          <rect x="13" y="13" width="9" height="9" rx="2" fill="var(--accent-amber)"></rect>
        </svg>
      </span>
      <span class="brand-title">SPOT</span>
    </a>
  </div>

  <div class="hud-center">
    <!-- 1. Claimed Count -->
    <div class="stat-pill claimed-pill" title="Total citizens / spots claimed">
      <svg class="stat-icon icon-amber" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="stat-num mono-num highlight-amber" id="hud-claimed-count">{claimedCount.toLocaleString()}</span>
      <span class="stat-slash">/</span>
      <span class="stat-total mono-num">{totalSpots.toLocaleString()}</span>
      <span class="stat-text">claimed</span>
      <div class="mini-bar" aria-hidden="true">
        <div class="mini-bar-fill" style={`width: ${pct}%`}></div>
      </div>
    </div>

    <div class="stat-divider"></div>

    <!-- 2. Unique Visitors -->
    <div class="stat-pill visitors-pill" title="Unique visitors in the last 24 hours">
      <svg class="stat-icon icon-muted" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <span class="stat-num mono-num" id="hud-visitors-count">1</span>
      <span class="stat-text">visitors</span>
    </div>

    <div class="stat-divider"></div>

    <!-- 3. Realtime Online -->
    <div class="stat-pill online-pill" title="Active real-time visitors">
      <span class="online-pip" aria-hidden="true"></span>
      <span class="stat-num mono-num highlight-jade" id="hud-online-count">{onlineCount}</span>
      <span class="stat-text">online</span>
    </div>
  </div>

  <div class="hud-right">
    <a class="hud-world-btn" href="/world" id="header-world-btn" title="Open Spot World — 2D Cyber City">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
      <span class="world-btn-label">World</span>
    </a>

    <a class="hud-library-btn" href="/world?modal=library" id="header-library-btn" title="Open The Grand Codex Developer Vault">
      <span class="library-btn-icon">📚</span>
      <span class="library-btn-label">Library</span>
    </a>

    <button class="hud-search-btn" id="header-search-btn" type="button" title="Search citizens (Cmd+K)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="search-label">Find</span>
      <kbd class="search-shortcut">⌘K</kbd>
    </button>

    <button class="cta-claim-btn" id="header-claim-btn" type="button">
      <svg class="claim-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>Choose a Spot</span>
    </button>
  </div>
</header>

<div class="activity-ticker glass-panel" id="activity-ticker" aria-live="polite">
  <span class="activity-tag">LIVE</span>
  <span class="activity-text" id="activity-text">Watching the city...</span>
</div>

<style>
  .header-hud {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    height: 44px;
    padding: 0 10px 0 8px;
    background: rgba(11, 15, 23, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.75), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
    z-index: 40;
    pointer-events: auto;
    width: max-content;
    max-width: calc(100vw - 24px);
    white-space: nowrap;
  }

  .activity-ticker {
    position: fixed;
    top: 66px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 39;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: min(420px, calc(100vw - 28px));
    padding: 4px 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    background: rgba(10, 14, 22, 0.88);
    box-shadow: 0 8px 20px -2px rgba(0, 0, 0, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
  }

  .activity-tag {
    display: inline-block;
    padding: 1px 5px;
    font-size: 0.62rem;
    font-weight: 700;
    font-family: var(--font-tech);
    letter-spacing: 0.08em;
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 4px;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .activity-text {
    overflow: hidden;
    text-overflow: ellipsis;
    color: #94a3b8;
    font-size: 0.72rem;
  }

  .hud-left {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-badge {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 7px;
    padding: 4px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .brand-badge:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .brand-glyph {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
  }

  .brand-title {
    font-family: var(--font-tech);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--text-primary);
    line-height: 1;
  }

  .hud-center {
    display: inline-flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .stat-pill {
    display: inline-flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 5px;
    font-size: 0.80rem;
    white-space: nowrap;
    line-height: 1;
    flex-shrink: 0;
  }

  .stat-num {
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .icon-amber {
    color: var(--accent-amber);
  }

  .icon-muted {
    color: var(--text-secondary);
  }

  .highlight-amber {
    color: var(--accent-amber);
  }

  .highlight-jade {
    color: var(--accent-jade);
  }

  .stat-slash {
    color: var(--text-muted);
    font-size: 0.75rem;
    opacity: 0.5;
  }

  .stat-total {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .stat-text {
    font-size: 0.74rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .mini-bar {
    width: 32px;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
    margin-left: 2px;
  }

  .mini-bar-fill {
    height: 100%;
    background: var(--accent-amber);
    border-radius: 2px;
  }

  .stat-divider {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.09);
  }

  /* Engineered Hardware LED Pip (No Cheesy Pulse Animation) */
  .online-pip {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.35);
    flex-shrink: 0;
  }

  .hud-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  /* Architectural Tool Buttons */
  .hud-world-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 0 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .hud-world-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--text-primary);
  }

  .hud-library-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 0 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .hud-library-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--text-primary);
  }

  .hud-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 0 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hud-search-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .search-shortcut {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.4);
    padding: 1px 4px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Tactile Command Button */
  .cta-claim-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    box-sizing: border-box;
    background: #f59e0b;
    color: #0c0f17;
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0 11px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.3), 0 2px 8px rgba(245, 158, 11, 0.25);
    transition: all 0.12s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .cta-claim-btn:hover {
    background: #fbbf24;
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.4), 0 3px 12px rgba(245, 158, 11, 0.35);
  }

  .cta-claim-btn:active {
    transform: translateY(1px);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  /* Responsive Media Queries */
  @media (max-width: 768px) {
    .header-hud {
      top: 8px;
      width: calc(100% - 16px);
      padding: 0 8px;
      gap: 6px;
      height: 40px;
    }

    .mini-bar {
      display: none;
    }

    .search-shortcut {
      display: none;
    }

    .activity-ticker {
      top: 54px;
    }
  }

  @media (max-width: 520px) {
    .header-hud {
      gap: 5px;
      padding: 0 6px;
    }

    .hud-center {
      gap: 6px;
    }

    .stat-text {
      display: none;
    }

    .stat-total {
      display: none;
    }

    .stat-slash {
      display: none;
    }

    .search-label {
      display: none;
    }

    .world-btn-label {
      display: none;
    }

    .hud-search-btn {
      padding: 5px 6px;
    }

    .hud-world-btn {
      padding: 5px 6px;
    }

    .cta-claim-btn {
      padding: 5px 9px;
      font-size: 0.72rem;
    }
  }
</style>
