---
---

<div class="search-backdrop" id="search-modal-backdrop" aria-hidden="true">
  <div class="search-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="search-input">
    <div class="search-header">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Find citizen by name, handle, or spot (e.g. 42,42)..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-kbd">ESC</kbd>
    </div>

    <div class="search-body">
      <div class="search-status" id="search-status">
        Type to search across citizens and spots...
      </div>
      <div class="search-results-list" id="search-results-list"></div>
    </div>
  </div>
</div>

<style>
  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 18, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
    z-index: 250;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease-out-expo);
  }

  .search-backdrop.open {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .search-card {
    width: 100%;
    max-width: 520px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevated);
    transform: scale(0.96) translateY(-8px);
    transition: transform 0.25s var(--ease-out-expo);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .search-backdrop.open .search-card {
    transform: scale(1) translateY(0);
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1rem;
    color: var(--text-primary);
    font-family: inherit;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.08);
    padding: 3px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .search-body {
    max-height: 380px;
    overflow-y: auto;
    padding: 8px;
  }

  .search-status {
    padding: 24px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .search-results-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.search-result-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.active) {
    background: rgba(255, 255, 255, 0.07);
  }

  :global(.search-result-left) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  :global(.search-result-avatar) {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
    border-radius: var(--radius-sm);
    background: #141722;
    border: 1px solid var(--border-subtle);
  }

  :global(.search-result-meta) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.search-result-name) {
    font-family: var(--font-tech);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  :global(.search-result-tagline) {
    font-size: 0.75rem;
    color: var(--text-secondary);
    max-width: 280px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-result-spot) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-amber);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }
</style>
