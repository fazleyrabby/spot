    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-delete-account:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.5);
    color: #fca5a5;
  }

  @media (max-width: 540px) {
    .modal-card {
      padding: 20px 16px;
      max-height: calc(100dvh - 24px);
    }

    .form-row {
      flex-direction: column;
      gap: 12px;
    }

    .edit-avatar-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }

    :global(.avatar-option) {
      padding: 5px 3px;
    }

    :global(.avatar-option span) {
      font-size: 0.65rem;
    }

    .custom-avatar-preview-box {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
</style>

<script>
  // ── 3D Holographic Citizen Card Interactive Tilt & Glare ──
  function setupHoloCard() {
    const stage = document.getElementById('profile-holo-stage');
    const card = document.getElementById('profile-holo-card');
    const glare = document.getElementById('profile-holo-glare');
    const spinBtn = document.getElementById('profile-holo-spin-btn');
    if (!stage || !card || !glare) return;

    let isHovered = false;
    let isTouching = false;
    let currentRotX = 0;
    let currentRotY = 0;
    let targetRotX = 0;
    let targetRotY = 0;
    let animId: number | null = null;

    function updateTilt(clientX: number, clientY: number) {
      const rect = card.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      const cardX = rect.left + rect.width / 2;
      const cardY = rect.top + rect.height / 2;

      const normX = Math.max(-1, Math.min(1, (clientX - cardX) / (rect.width / 2)));
      const normY = Math.max(-1, Math.min(1, (clientY - cardY) / (rect.height / 2)));

      // 3D Rotation angles (degrees)
      targetRotY = normX * 24;
      targetRotX = -normY * 24;

      // Glare reflection position (percentage)
      const glareX = (normX * 0.5 + 0.5) * 100;
      const glareY = (normY * 0.5 + 0.5) * 100;
      glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.8) 0%, rgba(56, 189, 248, 0.45) 25%, rgba(245, 158, 11, 0.35) 50%, transparent 75%)`;
      glare.style.opacity = '0.75';
    }

    function renderTiltLoop() {
      // Smooth lerp
      currentRotX += (targetRotX - currentRotX) * 0.18;
      currentRotY += (targetRotY - currentRotY) * 0.18;

      if (!card.classList.contains('is-spinning')) {
        card.style.transform = `perspective(750px) rotateX(${currentRotX.toFixed(2)}deg) rotateY(${currentRotY.toFixed(2)}deg) scale3d(1.05, 1.05, 1.05)`;
      }

      if (isHovered || isTouching || Math.abs(currentRotX) > 0.1 || Math.abs(currentRotY) > 0.1) {
        animId = requestAnimationFrame(renderTiltLoop);
      } else {
        if (!card.classList.contains('is-spinning')) {
          card.style.transform = '';
        }
        animId = null;
      }
    }

    function startTiltLoop() {
      if (!animId) {
        animId = requestAnimationFrame(renderTiltLoop);
      }
    }

    stage.addEventListener('mousemove', (e) => {
      isHovered = true;
      updateTilt(e.clientX, e.clientY);
      startTiltLoop();
    });

    stage.addEventListener('mouseleave', () => {
      isHovered = false;
      targetRotX = 0;
      targetRotY = 0;
      glare.style.opacity = '0';
      startTiltLoop();
    });

    stage.addEventListener('touchstart', (e) => {
      isTouching = true;
      if (e.touches[0]) {
        updateTilt(e.touches[0].clientX, e.touches[0].clientY);
        startTiltLoop();
      }
    }, { passive: true });

    stage.addEventListener('touchmove', (e) => {
      if (e.touches[0]) {
        updateTilt(e.touches[0].clientX, e.touches[0].clientY);
        startTiltLoop();
      }
    }, { passive: true });

    stage.addEventListener('touchend', () => {
      isTouching = false;
      targetRotX = 0;
      targetRotY = 0;
      glare.style.opacity = '0';
      startTiltLoop();
    });

    // 360 Spin Showcase
    function triggerSpin() {
      if (card.classList.contains('is-spinning')) return;
      card.classList.add('is-spinning');
      glare.style.opacity = '0.9';
      setTimeout(() => {
        card.classList.remove('is-spinning');
        glare.style.opacity = '0';
      }, 950);
    }

    card.addEventListener('click', triggerSpin);
    spinBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      triggerSpin();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHoloCard);
  } else {
    setupHoloCard();
  }
</script>

