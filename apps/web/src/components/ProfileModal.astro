  /* ── 3D Holographic Citizen Card ── */
  .holo-card-stage {
    perspective: 750px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    user-select: none;
    cursor: grab;
    flex-shrink: 0;
  }

  .holo-card-stage:active {
    cursor: grabbing;
  }

  .holo-card {
    position: relative;
    width: 80px;
    height: 94px;
    background: linear-gradient(140deg, rgba(16, 22, 34, 0.96), rgba(8, 11, 18, 0.98));
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    box-shadow:
      0 10px 24px -4px rgba(0, 0, 0, 0.7),
      0 0 16px rgba(56, 189, 248, 0.15),
      inset 0 1px 1px rgba(255, 255, 255, 0.15);
    transition: transform 0.15s ease-out, box-shadow 0.25s ease;
    overflow: visible;
  }

  .holo-card.is-spinning {
    animation: holoCard360Spin 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes holoCard360Spin {
    0% { transform: perspective(750px) rotateY(0deg) scale3d(1, 1, 1); }
    50% { transform: perspective(750px) rotateY(180deg) scale3d(1.1, 1.1, 1.1); }
    100% { transform: perspective(750px) rotateY(360deg) scale3d(1, 1, 1); }
  }

  .holo-glare {
    position: absolute;
    inset: 0;
    border-radius: 11px;
    pointer-events: none;
    mix-blend-mode: color-dodge;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 10;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.8) 0%, rgba(56, 189, 248, 0.45) 25%, rgba(245, 158, 11, 0.35) 50%, transparent 75%);
  }

  .holo-cyber-grid {
    position: absolute;
    inset: 2px;
    border-radius: 10px;
    background-image: 
      linear-gradient(to right, rgba(56, 189, 248, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(56, 189, 248, 0.08) 1px, transparent 1px);
    background-size: 8px 8px;
    pointer-events: none;
    transform: translateZ(2px);
  }

  .holo-scanline {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.75), transparent);
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.9);
    pointer-events: none;
    opacity: 0.7;
    animation: holoScanAnim 2.8s linear infinite;
    transform: translateZ(8px);
  }

  @keyframes holoScanAnim {
    0% { top: 0%; opacity: 0; }
    15% { opacity: 0.8; }
    85% { opacity: 0.8; }
    100% { top: 94%; opacity: 0; }
  }

  .holo-pedestal {
    position: absolute;
    bottom: 18px;
    width: 46px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(56, 189, 248, 0.5) 0%, rgba(56, 189, 248, 0.1) 60%, transparent 80%);
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
    border: 1px solid rgba(56, 189, 248, 0.4);
    transform: translateZ(12px) rotateX(60deg);
    pointer-events: none;
  }

  .holo-avatar {
    position: relative;
    width: 54px;
    height: 54px;
    image-rendering: pixelated;
    transform: translateZ(26px);
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.65));
    transition: transform 0.2s ease;
    z-index: 5;
  }

  .holo-archetype-tag {
    position: absolute;
    bottom: 4px;
    transform: translateZ(34px);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #38bdf8;
    background: rgba(6, 10, 18, 0.85);
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid rgba(56, 189, 248, 0.4);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
    z-index: 6;
  }

  .holo-corner {
    position: absolute;
    width: 5px;
    height: 5px;
    border-color: #38bdf8;
    pointer-events: none;
    transform: translateZ(18px);
  }
  .holo-corner.tl { top: 3px; left: 3px; border-top: 1.5px solid #38bdf8; border-left: 1.5px solid #38bdf8; }
  .holo-corner.tr { top: 3px; right: 3px; border-top: 1.5px solid #38bdf8; border-right: 1.5px solid #38bdf8; }
  .holo-corner.bl { bottom: 3px; left: 3px; border-bottom: 1.5px solid #38bdf8; border-left: 1.5px solid #38bdf8; }
  .holo-corner.br { bottom: 3px; right: 3px; border-bottom: 1.5px solid #38bdf8; border-right: 1.5px solid #38bdf8; }

  .holo-tilt-btn {
