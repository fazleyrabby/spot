---
---

<div class="modal-backdrop" id="profile-modal-backdrop" aria-hidden="true">
  <div class="modal-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="profile-name">
    <button class="modal-close-btn" id="profile-modal-close" aria-label="Close profile">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- VIEW MODE -->
    <div id="profile-view-section">
      <div class="profile-header">
        <div class="avatar-frame">
          <canvas id="profile-avatar-canvas" width="64" height="64" class="avatar-canvas"></canvas>
        </div>

        <div class="profile-meta">
          <div class="spot-tag mono-num" id="profile-spot-id">Spot (42, 42)</div>
          <h2 class="profile-name" id="profile-name">Fazley Rabbi</h2>
          <div class="presence-badge" id="profile-presence">
            <span class="presence-dot"></span>
            <span class="presence-text">Permanent Citizen</span>
          </div>
        </div>
      </div>

      <div class="profile-body">
        <p class="profile-tagline" id="profile-tagline">
          Creator of Spot. Crafting tiny internet places.
        </p>

        <div class="profile-links" id="profile-links">
          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-website" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span id="link-website-text">Website</span>
          </a>

          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-twitter" style="display: none;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
            <span>𝕏 (Twitter)</span>
          </a>

          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-facebook" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
            </svg>
            <span>Facebook</span>
          </a>

          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-instagram" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>

          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-linkedin" style="display: none;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.65 1.65 0 0 0-1.66 1.66 1.66 1.66 0 0 0 1.66 1.66 1.66 1.66 0 0 0 1.66-1.66c0-.92-.74-1.66-1.66-1.66Z"></path>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-youtube" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
            </svg>
            <span>YouTube</span>
          </a>

          <a href="#" target="_blank" rel="noopener noreferrer nofollow" class="profile-link-btn" id="link-github" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <span>GitHub</span>
          </a>

          <button type="button" class="profile-link-btn support-pill-btn" id="link-support" style="display: none;">
            <svg class="coffee-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
              <line x1="6" y1="1" x2="6" y2="4"></line>
              <line x1="10" y1="1" x2="10" y2="4"></line>
              <line x1="14" y1="1" x2="14" y2="4"></line>
            </svg>
            <span>Support Creator</span>
          </button>
        </div>

        <div class="profile-owner-actions" id="profile-owner-actions" style="display: none;">
          <button type="button" class="edit-profile-btn" id="btn-open-edit-profile">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            <span>Edit Profile</span>
          </button>

          <button type="button" class="sync-phone-btn" id="btn-open-transfer" title="Sync owner access with phone or another device">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
            <span>Sync Phone</span>
          </button>

          <button type="button" class="profile-link-btn" id="btn-copy-spot-link" title="Copy link to this spot">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span id="btn-copy-spot-link-text">Share Spot</span>
          </button>
        </div>
      </div>
    </div>

    <!-- EDIT MODE FORM -->
    <div id="profile-edit-section" style="display: none;">
      <h3 class="edit-modal-title">Edit Your Profile</h3>
      <form id="edit-profile-form" class="edit-form" onsubmit="return false;">
        <div class="form-group">
          <label class="form-label">AVATAR</label>
          <div class="edit-avatar-grid" id="edit-avatar-grid"></div>

          <!-- Custom Photo to Pixel Art Converter -->
          <div class="custom-avatar-uploader">
            <div class="custom-upload-row">
              <label class="custom-upload-btn" id="lbl-edit-upload-btn" for="edit-custom-avatar-file">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="icon-edit-upload">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span id="txt-edit-upload-label">Upload Photo → Pixel Avatar</span>
                <span id="spinner-edit-upload" class="upload-spinner" style="display: none;"></span>
                <input type="file" id="edit-custom-avatar-file" accept="image/*" style="display: none;" />
              </label>
            </div>

            <div class="custom-avatar-preview-box" id="edit-custom-preview-box" style="display: none;">
              <div class="preview-canvas-wrapper">
                <canvas id="edit-custom-preview-canvas" width="64" height="64" class="custom-preview-canvas"></canvas>
              </div>
              <div class="custom-preview-meta">
                <div class="custom-preview-title" id="txt-edit-preview-title">Custom Pixel Avatar Ready! ✨</div>
                <div class="custom-preview-controls">
                  <button type="button" class="btn-res-toggle active" id="btn-edit-res-32" data-res="32">32×32 Ultra HD</button>
                  <button type="button" class="btn-res-toggle" id="btn-edit-res-16" data-res="16">16×16 HD</button>
                  <button type="button" class="btn-res-toggle" id="btn-edit-res-8" data-res="8">8×8 Retro</button>
                  <button type="button" class="btn-remove-custom" id="btn-edit-remove-custom">Remove</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="edit-display-name" class="form-label">DISPLAY NAME <span class="required">*</span></label>
          <input type="text" id="edit-display-name" class="form-input" maxlength="32" required />
        </div>

        <div class="form-group">
          <label for="edit-tagline" class="form-label">TAGLINE</label>
          <input type="text" id="edit-tagline" class="form-input" maxlength="80" placeholder="What are you building or exploring?" />
        </div>

        <div class="form-group">
          <label for="edit-website" class="form-label">WEBSITE / PORTFOLIO</label>
          <input type="text" id="edit-website" class="form-input" maxlength="256" placeholder="yoursite.com or linktree" />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="edit-twitter" class="form-label">𝕏 (TWITTER)</label>
            <input type="text" id="edit-twitter" class="form-input" maxlength="128" placeholder="@username" />
          </div>

          <div class="form-group">
            <label for="edit-facebook" class="form-label">FACEBOOK</label>
            <input type="text" id="edit-facebook" class="form-input" maxlength="128" placeholder="facebook.com/username" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="edit-instagram" class="form-label">INSTAGRAM</label>
            <input type="text" id="edit-instagram" class="form-input" maxlength="128" placeholder="@username" />
          </div>

          <div class="form-group">
            <label for="edit-linkedin" class="form-label">LINKEDIN</label>
            <input type="text" id="edit-linkedin" class="form-input" maxlength="128" placeholder="linkedin.com/in/..." />
          </div>
        </div>

        <div class="form-group">
          <label for="edit-youtube" class="form-label">YOUTUBE</label>
          <input type="text" id="edit-youtube" class="form-input" maxlength="128" placeholder="@channel" />
        </div>

        <div class="form-group">
          <label for="edit-github" class="form-label">GITHUB</label>
          <input type="text" id="edit-github" class="form-input" maxlength="128" placeholder="username" />
        </div>

        <div class="edit-btn-row">
          <button type="button" class="btn-cancel-edit" id="btn-cancel-edit">Cancel</button>
          <button type="submit" class="btn-save-edit" id="btn-save-edit">Save Changes</button>
        </div>

        <div class="danger-zone">
          <button type="button" class="btn-delete-account" id="btn-delete-account">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Release Spot & Delete Profile</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 18, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out-expo);
    padding: 16px;
  }

  .modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-elevated);
    transform: scale(0.94) translateY(12px);
    transition: transform 0.3s var(--ease-out-expo);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .modal-backdrop.open .modal-card {
    transform: scale(1) translateY(0);
  }

  .modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .modal-close-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .avatar-frame {
    width: 68px;
    height: 68px;
    background: #141722;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
    image-rendering: pixelated;
  }

  .avatar-canvas {
    width: 56px;
    height: 56px;
    image-rendering: pixelated;
  }

  .profile-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spot-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-amber);
    letter-spacing: 0.04em;
  }

  .profile-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .presence-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 3px 8px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--accent-jade);
    font-weight: 600;
  }

  .presence-badge.founder-badge {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: var(--accent-amber);
  }

  .presence-badge.founder-badge .presence-dot {
    background: var(--accent-amber);
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.8);
  }

  .presence-badge.verified-badge {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.4);
    color: var(--accent-sky);
  }

  .presence-badge.verified-badge .presence-dot {
    background: var(--accent-sky);
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.8);
  }

  .presence-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-jade);
    border-radius: var(--radius-full);
  }

  .profile-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .profile-tagline {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .profile-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    padding: 7px 14px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .profile-link-btn:hover {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.4);
    color: var(--accent-amber);
    transform: translateY(-1px);
  }

  .profile-link-btn.support-pill-btn {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    color: #f59e0b;
  }

  .profile-link-btn.support-pill-btn:hover {
    background: rgba(245, 158, 11, 0.22);
    border-color: rgba(245, 158, 11, 0.55);
    color: #fbbf24;
  }

  .profile-owner-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
  }

  .edit-profile-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--accent-amber);
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .edit-profile-btn:hover {
    background: rgba(245, 158, 11, 0.22);
    transform: translateY(-1px);
  }

  .sync-phone-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-jade);
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .sync-phone-btn:hover {
    background: rgba(16, 185, 129, 0.22);
    border-color: var(--accent-jade);
    transform: translateY(-1px);
  }

  /* EDIT MODE STYLES */
  .edit-modal-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .edit-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  .form-row {
    display: flex;
    gap: 12px;
    width: 100%;
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .form-input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    font-size: 0.9rem;
    color: var(--text-primary);
    transition: border-color 0.15s ease;
  }

  .form-input:focus {
    border-color: var(--accent-amber);
    outline: none;
  }

  .edit-avatar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .custom-avatar-uploader {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .custom-upload-row {
    display: flex;
  }

  .custom-upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 8px 12px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px dashed rgba(56, 189, 248, 0.4);
    border-radius: var(--radius-md);
    color: #38bdf8;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .custom-upload-btn:hover {
    background: rgba(56, 189, 248, 0.16);
    border-color: #38bdf8;
    transform: translateY(-1px);
  }

  .upload-spinner {
    width: 14px;
    height: 14px;
