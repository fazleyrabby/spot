---
/**
 * WorldHUD — minimal heads-up display overlay for Spot World.
 *
 * Intentionally lean: back button, coordinate display, zoom indicator.
 * No minimap, no stats bar — those are cut from v1 scope.
 */
---

<div class="world-hud glass-panel" id="world-hud">
  <!-- Back to grid -->
  <a class="hud-back-btn" href="/" id="world-back-btn" title="Back to Grid View">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
    <span>Grid View</span>
  </a>

  <div class="hud-divider"></div>

  <!-- Brand -->
  <div class="hud-brand">
    <span class="hud-brand-glyph" aria-hidden="true">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17" fill="none" stroke="currentColor" stroke-width="2"></polyline>
      </svg>
    </span>
    <span class="hud-brand-label">WORLD</span>
  </div>

  <div class="hud-divider"></div>

  <!-- Coordinate display (updated by JS) -->
  <div class="hud-coord" id="world-coord-display" title="Hovered grid coordinate">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span id="world-coord-text">—</span>
  </div>

  <div class="hud-divider"></div>

  <!-- Citizen Identity / Quick Sign-In Pill -->
  <button type="button" class="hud-citizen-btn" id="world-citizen-btn" title="Citizen Identity">
    <span class="hud-citizen-icon" id="world-citizen-icon">⚡</span>
    <span class="hud-citizen-name" id="world-citizen-name">Sign In</span>
    <span class="hud-citizen-badge" id="world-citizen-badge" style="display: none;">✓</span>
  </button>

  <div class="hud-divider"></div>

  <!-- Discoveries & Easter Eggs Journal Button -->
  <button type="button" class="hud-secrets" id="hud-secrets-btn" title="Open Explorer Journal (Landmarks & Mystery Riddles)">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor"></polygon>
    </svg>
    <span id="hud-secrets-count">0/11</span>
  </button>

  <!-- Active Turbo Speed Boost Pill -->
  <div class="hud-turbo-pill" id="hud-turbo-pill" style="display: none;" title="Turbo Speed Boost Active">
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor"></polygon>
    </svg>
    <span id="hud-turbo-timer">20s</span>
  </div>

  <div class="hud-divider"></div>

  <!-- Search / Find Citizen Button -->
  <button class="hud-search-btn" id="world-search-btn" title="Search Citizens & Plots (Cmd+K)">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>Find</span>
    <kbd class="hud-kbd">⌘K</kbd>
  </button>

  <div class="hud-divider"></div>

  <!-- Audio Ambient Sound Toggle -->
  <button class="hud-tool-btn" id="world-audio-btn" title="Toggle Environmental Sounds">
    <span id="world-audio-icon">🔇</span>
  </button>

  <div class="hud-divider"></div>

  <!-- Time of Day Switcher (Day / Dusk / Night) -->
  <button class="hud-tool-btn" id="world-tod-btn" title="Cycle Lighting (Night / Day / Sunset)">
    <span id="world-tod-icon">🌙</span>
  </button>

  <div class="hud-divider hud-divider-right"></div>

  <!-- Zoom controls -->
  <div class="hud-zoom-group">
    <button class="hud-zoom-btn" id="world-zoom-in" title="Zoom in">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
    <span class="hud-zoom-level mono-num" id="world-zoom-level">55%</span>
    <button class="hud-zoom-btn" id="world-zoom-out" title="Zoom out">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
    <button class="hud-zoom-btn hud-recenter-btn" id="world-recenter" title="Re-centre">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .world-hud {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 10px;
    background: rgba(11, 15, 23, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.75), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
    z-index: 40;
    white-space: nowrap;
    pointer-events: auto;
    max-width: calc(100vw - 24px);
  }

  .hud-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.15s ease;
  }

  .hud-back-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .hud-divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.09);
    flex-shrink: 0;
  }

  .hud-brand {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 6px;
    border-radius: 5px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .hud-brand-glyph {
    display: inline-flex;
    align-items: center;
    color: var(--accent-jade);
  }

  .hud-brand-label {
    font-family: var(--font-tech);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent-jade);
  }

  .hud-coord {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.74rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    min-width: 65px;
  }

  .hud-coord svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  #world-coord-text {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .hud-citizen-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.76rem;
    font-weight: 700;
    font-family: var(--font-tech);
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.09);
    border: 1px solid rgba(56, 189, 248, 0.28);
    padding: 3px 9px;
    border-radius: 6px;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }

  .hud-citizen-btn:hover {
    background: rgba(56, 189, 248, 0.20);
    border-color: rgba(56, 189, 248, 0.5);
    color: #f0f9ff;
    transform: translateY(-1px);
  }

  .hud-citizen-btn.is-authenticated {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .hud-citizen-btn.is-authenticated:hover {
    background: rgba(245, 158, 11, 0.2);
    border-color: rgba(245, 158, 11, 0.55);
    color: #fef3c7;
  }

  .hud-citizen-badge {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 1px 4px;
    border-radius: 999px;
    line-height: 1.1;
  }

  .hud-secrets {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.74rem;
    font-weight: 700;
    font-family: var(--font-tech);
    letter-spacing: 0.04em;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 3px 8px;
    border-radius: 6px;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }

  .hud-secrets:hover {
    background: rgba(245, 158, 11, 0.2);
    border-color: rgba(245, 158, 11, 0.45);
    color: #fef08a;
  }

  .hud-secrets:active {
    transform: translateY(1px);
  }

  .hud-turbo-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-tech);
    letter-spacing: 0.04em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 3px 7px;
    border-radius: 6px;
  }

  .hud-search-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hud-search-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--text-primary);
  }

  .hud-tool-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hud-tool-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .hud-tool-btn:active {
    transform: translateY(1px);
  }

  .hud-kbd {
    font-size: 0.62rem;
    font-family: var(--font-mono, monospace);
    background: rgba(0, 0, 0, 0.4);
    padding: 1px 4px;
    border-radius: 3px;
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hud-zoom-group {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background: rgba(0, 0, 0, 0.25);
    padding: 2px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hud-zoom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: var(--text-secondary);
    transition: all 0.12s ease;
    cursor: pointer;
  }

  .hud-zoom-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
  }

  .hud-zoom-btn:active {
    transform: translateY(1px);
  }

  .hud-recenter-btn {
    margin-left: 1px;
  }

  .hud-zoom-level {
    font-size: 0.70rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    min-width: 30px;
    text-align: center;
  }

  /* ── Responsive Mobile Collapse ────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hud-brand {
      display: none;
    }
    .hud-coord {
      display: none;
    }
    .hud-zoom-group {
      display: none;
    }
    .hud-divider-right {
      display: none;
    }
    .hud-kbd {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .world-hud {
      top: 8px;
      gap: 4px;
      padding: 0 6px;
      height: 38px;
      max-width: calc(100vw - 16px);
    }

    .hud-back-btn span {
      display: none;
    }

    .hud-back-btn {
      padding: 4px 6px;
    }

    .hud-search-btn span {
      display: none;
    }

    .hud-search-btn {
      padding: 4px 6px;
    }

    .hud-secrets {
      padding: 2px 6px;
      font-size: 0.70rem;
    }

    .hud-tool-btn {
      width: 26px;
      height: 26px;
      font-size: 0.75rem;
    }

    .hud-divider {
      margin: 0;
    }
  }
</style>
