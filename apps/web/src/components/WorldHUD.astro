---
/**
 * WorldHUD — Quiet Luxury heads-up display overlay for Spot World.
 *
 * Designed as a single, ultra-sleek, responsive horizontal floating island pill:
 * 1. Left Cluster: Back to Grid, World Brand Globe, Coordinates
 * 2. Center Cluster: Live Island Telemetry (Online, Claimed, Billboards, Secrets, Turbo)
 * 3. Right Cluster: Citizen Identity, Library, Find, Audio, TOD, Weather, Zoom/Recenter
 */
---

<div class="world-hud glass-panel" id="world-hud">
  <!-- Cluster 1: Navigation -->
  <div class="hud-group hud-group-nav">
    <!-- Back to grid -->
    <a class="hud-back-btn" href="/" id="world-back-btn" title="Back to Grid View">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span class="hud-back-text">Grid View</span>
    </a>

    <!-- World Brand with Globe Icon -->
    <div class="hud-brand" title="Spot Cyber World">
      <span class="hud-brand-glyph" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </span>
      <span class="hud-brand-label">WORLD</span>
    </div>

    <!-- Coordinate display (updated by JS) -->
    <div class="hud-coord" id="world-coord-display" title="Hovered grid coordinate">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="world-coord-text">—</span>
    </div>
  </div>

  <div class="hud-divider" aria-hidden="true"></div>

  <!-- Cluster 2: Citizen Identity -->
  <button type="button" class="hud-citizen-btn" id="world-citizen-btn" title="Citizen Identity">
    <span class="hud-citizen-icon" id="world-citizen-icon">👤</span>
    <span class="hud-citizen-name" id="world-citizen-name">Sign In</span>
    <span class="hud-citizen-badge" id="world-citizen-badge" style="display: none;">✓</span>
  </button>

  <div class="hud-divider" aria-hidden="true"></div>

  <!-- Cluster 3: Live Island Stats & Scarcity -->
  <div class="hud-group hud-group-stats">
    <!-- Live Online Multiplayer Pill -->
    <div class="hud-stat-pill hud-online-pill" id="hud-online-pill" title="Live players connected in real time">
      <span class="hud-online-dot"></span>
      <span id="hud-online-count" class="mono-num">1</span>
      <span class="hud-stat-label">Online</span>
    </div>

    <!-- Claimed Spots Scarcity Pill -->
    <a href="/" class="hud-stat-pill hud-spots-pill" id="hud-spots-pill" title="Total plots claimed on SPOT (Click to view full grid)">
      <span class="hud-stat-icon">🏙️</span>
      <span id="hud-claimed-count" class="mono-num">19</span>
      <span class="hud-stat-sublabel">/10k</span>
    </a>

    <!-- Billboard Sponsorship Scarcity Pill -->
    <button type="button" class="hud-stat-pill hud-sponsor-pill" id="hud-sponsor-pill" title="Sponsored Billboards vs Open Landmarks (Click to jump to an open billboard!)">
      <span class="hud-stat-icon">📡</span>
      <span id="hud-sponsor-ratio" class="mono-num">1/11</span>
      <span class="hud-stat-badge">Sponsored</span>
    </button>

    <!-- Discoveries & Easter Eggs Journal Button -->
    <button type="button" class="hud-stat-pill hud-secrets" id="hud-secrets-btn" title="Open Explorer Journal (Landmarks & Mystery Riddles)">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor"></polygon>
      </svg>
      <span id="hud-secrets-count" class="mono-num">0/11</span>
    </button>

    <!-- Active Turbo Speed Boost Pill -->
    <div class="hud-turbo-pill" id="hud-turbo-pill" style="display: none;" title="Turbo Speed Boost Active">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor"></polygon>
      </svg>
      <span id="hud-turbo-timer" class="mono-num">20s</span>
    </div>
  </div>

  <div class="hud-divider hud-divider-right" aria-hidden="true"></div>

  <!-- Cluster 4: Interaction & Camera Controls -->
  <div class="hud-group hud-group-controls">
    <!-- Grand Codex Library Quick Button -->
    <button class="hud-tool-btn hud-library-btn" id="world-library-btn" title="Open The Grand Codex Developer Vault">
      <span class="hud-tool-icon">📚</span>
      <span class="hud-btn-text">Library</span>
    </button>

    <!-- Voxel World Quick Link -->
    <a class="hud-tool-btn hud-voxel-btn" id="world-voxel-btn" href="/voxel" title="Open Spot Voxel World — 3D island">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2 3 7v10l9 5 9-5V7l-9-5z"></path>
        <path d="M3 7l9 5 9-5"></path>
        <path d="M12 12v10"></path>
      </svg>
      <span class="hud-btn-text">Voxel</span>
    </a>


    <!-- Search / Find Citizen Button -->
    <button class="hud-tool-btn hud-search-btn" id="world-search-btn" title="Search Citizens & Plots (Cmd+K)">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="hud-btn-text">Find</span>
      <kbd class="hud-kbd">⌘K</kbd>
    </button>


    <!-- Audio Ambient Sound Toggle -->
    <button class="hud-tool-btn" id="world-audio-btn" title="Toggle Environmental Sounds">
      <span id="world-audio-icon">🔇</span>
    </button>

    <!-- Time of Day Switcher (Day / Dusk / Night) -->
    <button class="hud-tool-btn" id="world-tod-btn" title="Cycle Lighting (Night / Day / Sunset)">
      <span id="world-tod-icon">🌙</span>
    </button>

    <!-- Dynamic Weather Toggle (Clear / Neon Rain / Cyber Motes) -->
    <button class="hud-tool-btn" id="world-weather-btn" title="Cycle Weather (Clear / Neon Rain / Cyber Motes)">
      <span id="world-weather-icon">✨</span>
    </button>

    <!-- Cyberpunk Lo-Fi Radio Tuner -->
    <div class="hud-pop-container">
      <button class="hud-tool-btn hud-radio-btn" id="world-radio-btn" title="Open Lo-Fi Chiptune FM Radio Tuner">
        <span class="hud-radio-icon">📻</span>
        <span class="hud-radio-bars" id="world-radio-bars" aria-hidden="true">
          <span class="hud-bar bar-1"></span>
          <span class="hud-bar bar-2"></span>
          <span class="hud-bar bar-3"></span>
        </span>
      </button>

      <!-- Floating Mini Radio Tuner Card -->
      <div class="hud-pop-card glass-panel" id="world-radio-popup" style="display: none;">
        <div class="pop-header">
          <div class="radio-meta">
            <span class="radio-live-dot" id="radio-live-dot"></span>
            <span class="radio-freq-badge" id="radio-freq-display">FM 88.4</span>
            <span class="radio-title-text" id="radio-title-display">Neon Rain</span>
          </div>
          <button type="button" class="pop-close-btn" id="radio-pop-close">✕</button>
        </div>
        <div class="radio-station-list">
          <button type="button" class="radio-station-btn is-active" data-station="neon_rain">
            <span class="st-glyph">🌧️</span>
            <span class="st-info">
              <span class="st-name">Neon Rain</span>
              <span class="st-sub">Downtempo Lo-Fi</span>
            </span>
          </button>
          <button type="button" class="radio-station-btn" data-station="cyber_cafe">
            <span class="st-glyph">☕</span>
            <span class="st-info">
              <span class="st-name">Cyber Cafe</span>
              <span class="st-sub">Cozy Chiptune</span>
            </span>
          </button>
          <button type="button" class="radio-station-btn" data-station="midnight_transit">
            <span class="st-glyph">🌌</span>
            <span class="st-info">
              <span class="st-name">Midnight Transit</span>
              <span class="st-sub">Ambient Synth</span>
            </span>
          </button>
        </div>
        <div class="radio-deck">
          <button type="button" class="radio-master-btn" id="radio-play-btn">
            <span id="radio-play-icon">▶</span>
            <span id="radio-play-label">Play Radio</span>
          </button>
          <div class="radio-slider-box">
            <span class="slider-icon">🔉</span>
            <input type="range" min="0" max="1" step="0.05" value="0.5" id="radio-volume-slider" class="hud-range-slider" title="Radio Volume" />
          </div>
        </div>
      </div>
    </div>

    <!-- Follower Pet Companion -->
    <div class="hud-pop-container">
      <button class="hud-tool-btn hud-pet-btn" id="world-pet-btn" title="Choose Follower Pet Companion">
        <span id="world-pet-icon">🐕</span>
      </button>

      <!-- Pet Companion Picker Popup -->
      <div class="hud-pop-card glass-panel" id="world-pet-popup" style="display: none;">
        <div class="pop-header">
          <span class="pop-title">PET COMPANION</span>
          <button type="button" class="pet-toggle-status" id="pet-toggle-status">Active</button>
        </div>
        <div class="pet-grid">
          <button type="button" class="pet-choice-btn is-active" data-pet="cyber_shibe" title="Cyber Shiba Inu">
            <span class="pet-glyph">🐕</span>
            <span class="pet-name">Shibe-01</span>
          </button>
          <button type="button" class="pet-choice-btn" data-pet="pixel_cat" title="Midnight Pixel Cat">
            <span class="pet-glyph">🐱</span>
            <span class="pet-name">Kuro Cat</span>
          </button>
          <button type="button" class="pet-choice-btn" data-pet="droid_bob" title="Floating Recon Droid">
            <span class="pet-glyph">🤖</span>
            <span class="pet-name">Droid Bob</span>
          </button>
          <button type="button" class="pet-choice-btn" data-pet="red_panda" title="Panda Adventurer">
            <span class="pet-glyph">🦊</span>
            <span class="pet-name">Red Panda</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Cinematic Autopilot Tour Mode -->
    <button class="hud-tool-btn hud-tour-btn" id="world-tour-btn" title="Cinematic Island Autopilot Tour">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="23 7 16 12 23 17 23 7"></polygon>
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
      </svg>
      <span class="hud-btn-text">Tour</span>
    </button>

    <!-- Zoom controls -->
    <div class="hud-zoom-group">
      <button class="hud-zoom-btn" id="world-zoom-in" title="Zoom in">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
      <span class="hud-zoom-level mono-num" id="world-zoom-level">55%</span>
      <button class="hud-zoom-btn" id="world-zoom-out" title="Zoom out">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
      <button class="hud-zoom-btn hud-recenter-btn" id="world-recenter" title="Re-centre camera">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- Cinematic Tour Letterbox Banner Overlay -->
<div class="tour-overlay" id="world-tour-overlay" style="display: none;">
  <div class="tour-letterbox top"></div>
  <div class="tour-banner">
    <div class="tour-badge">
      <span class="tour-rec-dot"></span>
      <span class="tour-mode-text">ISLAND TOUR</span>
      <span class="tour-index" id="tour-index-display">1 / 7</span>
    </div>
    <div class="tour-title" id="tour-title-display">Grand Central Plaza</div>
    <div class="tour-subtitle" id="tour-subtitle-display">Luminous granite fountain, civic clocktower & central origin</div>
    <div class="tour-hint"><kbd>WASD</kbd>, click canvas, or press <kbd>ESC</kbd> to return control</div>
  </div>
  <button type="button" class="tour-exit-btn" id="tour-exit-btn">✕ Exit Tour</button>
  <div class="tour-letterbox bottom"></div>
</div>

<style>
  /* ── Master World HUD Pill (Strict Single-Row Capsule) ─────────────────── */
  .world-hud {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    height: 40px;
    min-height: 40px;
    padding: 0 8px;
    background: rgba(11, 15, 23, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 12px 32px -6px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.09);
    z-index: 40;
    pointer-events: auto;
    width: max-content;
    max-width: calc(100vw - 16px);
    box-sizing: border-box;
    white-space: nowrap;
    user-select: none;
    overflow-x: auto;
    overflow-y: hidden;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .world-hud::-webkit-scrollbar {
    display: none;
  }

  /* ── Groups ───────────────────────────────────────────────────────────── */
  .hud-group {
    display: inline-flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  /* ── Hairline Dividers ─────────────────────────────────────────────────── */
  .hud-divider {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.09);
    flex-shrink: 0;
    margin: 0 1px;
  }

  /* ── Back Button ───────────────────────────────────────────────────────── */
  .hud-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .hud-back-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-1px);
  }

  /* ── World Brand ───────────────────────────────────────────────────────── */
  .hud-brand {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  .hud-brand-glyph {
    display: inline-flex;
    align-items: center;
    color: #10b981;
  }

  .hud-brand-label {
    font-family: var(--font-display);
    font-size: 0.70rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #f1f5f9;
  }

  /* ── Coordinates ───────────────────────────────────────────────────────── */
  .hud-coord {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    min-width: 54px;
    padding: 3px 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    flex-shrink: 0;
  }

  .hud-coord svg {
    flex-shrink: 0;
    opacity: 0.5;
  }

  #world-coord-text {
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* ── Citizen Profile ───────────────────────────────────────────────────── */
  .hud-citizen-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.76rem;
    font-weight: 700;
    font-family: var(--font-tech);
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3px 8px;
    border-radius: 6px;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .hud-citizen-btn:hover {
    background: rgba(255, 255, 255, 0.11);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .hud-citizen-btn.is-authenticated {
    color: #ffffff;
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.28);
  }

  .hud-citizen-btn.is-authenticated:hover {
    background: rgba(245, 158, 11, 0.22);
    border-color: rgba(245, 158, 11, 0.45);
    color: #fef3c7;
  }

  .hud-citizen-badge {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.60rem;
    font-weight: 800;
    padding: 1px 4px;
    border-radius: 999px;
    line-height: 1.1;
  }

  /* ── Island Telemetry Pills ────────────────────────────────────────────── */
  .hud-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.74rem;
    font-weight: 600;
    font-family: var(--font-tech);
    padding: 3px 7px;
    border-radius: 6px;
    user-select: none;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .hud-stat-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .hud-online-pill {
    color: #f1f5f9;
  }

  .hud-online-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10b981;
    animation: hudDotPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes hudDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .hud-spots-pill {
    cursor: pointer;
  }

  .hud-stat-sublabel {
    font-size: 0.64rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .hud-sponsor-pill {
    cursor: pointer;
  }

  .hud-stat-badge {
    background: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 0.56rem;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hud-secrets {
    cursor: pointer;
  }

  .hud-secrets svg {
    color: #fbbf24;
    flex-shrink: 0;
  }

  .hud-turbo-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 800;
    font-family: var(--font-tech);
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.45);
    padding: 2px 6px;
    border-radius: 6px;
    flex-shrink: 0;
    animation: turboGlow 1.2s ease-in-out infinite alternate;
  }

  @keyframes turboGlow {
    from {
      box-shadow: 0 0 4px rgba(245, 158, 11, 0.2);
      border-color: rgba(245, 158, 11, 0.4);
    }
    to {
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.55);
      border-color: rgba(251, 191, 36, 0.8);
    }
  }

  /* ── Interaction Buttons ───────────────────────────────────────────────── */
  .hud-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 28px;
    min-width: 28px;
    padding: 0 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-family: var(--font-tech);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

