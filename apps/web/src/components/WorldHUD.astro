---
/**
 * WorldHUD — minimal heads-up display overlay for Spot World.
 *
 * Intentionally lean: back button, coordinate display, zoom indicator.
 * No minimap, no stats bar — those are cut from v1 scope.
 */
---

<div class="world-hud" id="world-hud">
  <!-- Back to grid -->
  <a class="hud-back-btn" href="/" id="world-back-btn" title="Back to Grid View">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
    <span>Grid View</span>
  </a>

  <div class="hud-divider"></div>

  <!-- Brand -->
  <div class="hud-brand">
    <span class="hud-brand-dot"></span>
    <span class="hud-brand-label">SPOT WORLD</span>
  </div>

  <div class="hud-divider"></div>

  <!-- Coordinate display (updated by JS) -->
  <div class="hud-coord" id="world-coord-display" title="Hovered grid coordinate">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span id="world-coord-text">—</span>
  </div>

  <!-- Discoveries & Easter Eggs Counter -->
  <div class="hud-secrets" id="hud-secrets-pill" title="World Discoveries & Secrets Found">
    <span class="hud-secrets-icon">✨</span>
    <span id="hud-secrets-count">0/6</span>
  </div>

  <div class="hud-divider"></div>

  <!-- Search / Find Citizen Button -->
  <button class="hud-search-btn" id="world-search-btn" title="Search Citizens & Plots (Cmd+K)">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>Find</span>
    <kbd class="hud-kbd">⌘K</kbd>
  </button>

  <div class="hud-divider hud-divider-right"></div>

  <!-- Zoom controls -->
  <div class="hud-zoom-group">
    <button class="hud-zoom-btn" id="world-zoom-in" title="Zoom in">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
    <span class="hud-zoom-level" id="world-zoom-level">55%</span>
    <button class="hud-zoom-btn" id="world-zoom-out" title="Zoom out">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
    <button class="hud-zoom-btn hud-recenter-btn" id="world-recenter" title="Re-centre">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .world-hud {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 12px;
    background: rgba(14, 17, 26, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
    z-index: 40;
    white-space: nowrap;
    pointer-events: auto;
    max-width: calc(100vw - 24px);
  }

  .hud-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: all 0.18s ease;
  }

  .hud-back-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .hud-divider {
    width: 1px;
    height: 18px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .hud-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 8px;
  }

  .hud-brand-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-jade);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hud-brand-label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-jade);
  }

  .hud-coord {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    min-width: 70px;
  }

  .hud-coord:hover {
    color: #f8fafc;
  }

  .hud-secrets {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.76rem;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 3px 8px;
    border-radius: 9999px;
    cursor: default;
    user-select: none;
  }

  .hud-secrets-icon {
    font-size: 0.85rem;
  }

  .hud-search-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hud-search-btn:hover {
    background: rgba(56, 189, 248, 0.22);
    border-color: #38bdf8;
    color: #f8fafc;
  }

  .hud-kbd {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    background: rgba(0, 0, 0, 0.35);
    padding: 1px 4px;
    border-radius: 3px;
    color: #94a3b8;
  }

  .hud-coord svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  #world-coord-text {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .hud-zoom-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .hud-zoom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    border-radius: 7px;
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .hud-zoom-btn:hover {
    background: rgba(255, 255, 255, 0.13);
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .hud-recenter-btn {
    margin-left: 2px;
  }

  .hud-zoom-level {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    min-width: 32px;
    text-align: center;
  }

  /* Mobile: collapse to essentials */
  @media (max-width: 540px) {
    .world-hud {
      gap: 6px;
      padding: 0 8px;
      top: 8px;
    }

    .hud-brand-label { display: none; }
    .hud-coord { min-width: unset; }
    #world-coord-text { display: none; }
  }
</style>
