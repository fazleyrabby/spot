---
/**
 * JournalModal — Explorer Journal displaying discovered landmarks and mystery riddles for undiscovered ones.
 */
---

<div class="journal-modal-backdrop modal-backdrop" id="journal-modal-backdrop" aria-hidden="true">
  <div class="journal-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="journal-title">
    <button class="modal-close-btn" id="journal-modal-close" aria-label="Close journal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Header -->
    <div class="journal-header">
      <div class="journal-badge">EXPLORER COMPASS</div>
      <h2 class="journal-title" id="journal-title">Spot Discovery Journal</h2>
      <p class="journal-subtitle">Explore the 10,000-tile grid to uncover digital landmarks, easter eggs, and cyber relics.</p>

      <!-- Progress bar -->
      <div class="journal-progress-box">
        <div class="progress-labels">
          <span class="progress-title">Metropolis Mapped</span>
          <span class="progress-count" id="journal-progress-text">0 / 11 Discovered</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" id="journal-progress-fill" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    <!-- Scrollable Landmark Cards -->
    <div class="journal-list" id="journal-list">
      <!-- Populated dynamically via client-side script -->
    </div>
  </div>
</div>

<style>
  .journal-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 12, 18, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    z-index: 260;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease-out;
  }

  .journal-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .journal-card {
    position: relative;
    max-width: 580px;
    width: 100%;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    background: rgba(15, 23, 42, 0.96);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75), 0 0 30px rgba(56, 189, 248, 0.12);
    animation: modalScaleIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalScaleIn {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .modal-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
    z-index: 2;
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #f8fafc;
  }

  .journal-header {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .journal-badge {
    display: inline-block;
    padding: 2px 8px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #f59e0b;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .journal-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 4px 0;
    letter-spacing: -0.02em;
  }

  .journal-subtitle {
    font-size: 0.82rem;
    color: #94a3b8;
    margin: 0 0 1rem 0;
  }

  .journal-progress-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 8px 12px;
  }

  .progress-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: #cbd5e1;
  }

  .progress-count {
    color: #00f0ff;
    font-family: ui-monospace, monospace;
  }

  .progress-track {
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #0284c7, #00f0ff);
    transition: width 0.4s ease-out;
  }

  /* List */
  .journal-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 4px;
  }

  .journal-list::-webkit-scrollbar {
    width: 5px;
  }

  .journal-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }

  /* Dynamic Landmark Card (Styles applied by script) */
  :global(.journal-item) {
    display: flex;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.15s;
  }

  :global(.journal-item.discovered) {
    border-color: rgba(0, 240, 255, 0.2);
    background: rgba(0, 240, 255, 0.03);
  }

  :global(.journal-item-icon) {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  :global(.journal-item.discovered .journal-item-icon) {
    background: rgba(0, 240, 255, 0.08);
    border-color: rgba(0, 240, 255, 0.3);
  }

  :global(.journal-item-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.journal-item-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
  }

  :global(.journal-item-name) {
    font-size: 0.88rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0;
  }

  :global(.journal-item-coords) {
    font-size: 0.7rem;
    color: #00f0ff;
    font-family: ui-monospace, monospace;
  }

  :global(.journal-item-district) {
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 4px;
  }

  :global(.journal-item-clue) {
    font-size: 0.78rem;
    line-height: 1.45;
    color: #94a3b8;
    font-style: italic;
    margin: 0;
  }

  :global(.journal-item.discovered .journal-item-clue) {
    color: #cbd5e1;
    font-style: normal;
  }
</style>
