---
---

<div class="canvas-container" id="canvas-container">
  <canvas id="spot-canvas" class="spot-canvas"></canvas>

  <div class="world-loader" id="world-loader" role="status" aria-live="polite">
    <span class="world-loader-mark" aria-hidden="true"></span>
    <span>Mapping the city…</span>
  </div>

  <!-- Bottom-Left Hover/Coordinate Pill & Support Button -->
  <div class="hud-bottom-left" id="hud-bottom-left">
    <div class="coord-pill glass-panel" id="coord-pill">
      <span class="coord-icon" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="22" y1="12" x2="18" y2="12"></line>
          <line x1="6" y1="12" x2="2" y2="12"></line>
          <line x1="12" y1="6" x2="12" y2="2"></line>
          <line x1="12" y1="22" x2="12" y2="18"></line>
        </svg>
      </span>
      <span class="coord-text mono-num" id="coord-text">Spot: (52, 60)</span>
      <span class="coord-badge empty" id="coord-status">Available</span>
      <span class="district-text" id="coord-district">Sector 5-5</span>
      <span class="prime-badge" id="coord-prime" style="display: none;">PRIME</span>
      <span class="verified-badge-mini" id="coord-verified-badge" style="display: none;" title="Verified GitHub Citizen">
        <svg class="verified-badge-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="9.5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.5"/>
          <path d="M7.7 12.2l2.8 2.8 5.9-5.9" stroke="#07111f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>

    <div class="hud-actions">
      <a
        href="https://fazleyrabbi.xyz"
        target="_blank"
        rel="noopener noreferrer"
        class="creator-badge glass-panel"
        aria-label="Made by fazleyrabbi"
        id="creator-badge-link"
      >
        <span class="creator-badge__icon" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </span>
        <span class="creator-badge__text">
          <span class="creator-badge__label">made by</span>
          <span class="creator-badge__name">fazleyrabbi</span>
        </span>
      </a>

      <button type="button" class="support-btn glass-panel" id="btn-open-support" title="Support creator & development of Spot">
        <svg class="coffee-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
          <line x1="6" y1="1" x2="6" y2="4"></line>
          <line x1="10" y1="1" x2="10" y2="4"></line>
          <line x1="14" y1="1" x2="14" y2="4"></line>
        </svg>
        <span>Support</span>
      </button>

      <button type="button" class="about-btn glass-panel" id="btn-open-about" title="About SPOT & How It Works">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>About</span>
      </button>
    </div>
  </div>

  <!-- Bottom-Right Navigation HUD Controls -->
  <div class="hud-bottom-right" id="hud-bottom-right">
    <div class="nav-controls glass-panel">
      <button class="nav-btn" id="btn-zoom-in" title="Zoom in (+)" aria-label="Zoom in">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="nav-divider"></div>

      <button class="nav-btn" id="btn-zoom-out" title="Zoom out (-)" aria-label="Zoom out">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="nav-divider"></div>

      <button class="nav-btn" id="btn-recenter" title="Recenter world" aria-label="Recenter world">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    touch-action: none;
  }

  .spot-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }

  .world-loader {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: var(--radius-full);
    background: rgba(13, 17, 28, 0.94);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }

  .world-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .world-loader-mark {
    width: 13px;
    height: 13px;
    border: 2px solid rgba(16, 185, 129, 0.28);
    border-top-color: #10b981;
    border-radius: 50%;
    animation: world-loader-spin 0.8s linear infinite;
  }

  @keyframes world-loader-spin {
    to { transform: rotate(360deg); }
  }

  .hud-bottom-left {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 20px));
    left: max(16px, calc(env(safe-area-inset-left, 0px) + 16px));
    z-index: 35;
    /* Keep the whole control cluster in the touch hit-testing layer. Some
       mobile browsers do not reliably retarget taps through a pointer-events
       none parent to an interactive child. */
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hud-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .support-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    box-sizing: border-box;
    border-radius: 6px;
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--text-secondary);
    background: rgba(11, 15, 23, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    text-decoration: none;
    pointer-events: auto;
    transition: all 0.15s ease;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), inset 0 1px 0 0 rgba(255, 255, 255, 0.04);
  }

  .support-btn:hover {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .support-btn:active {
    transform: translateY(1px);
  }

  .coffee-icon {
    color: #f59e0b;
    flex-shrink: 0;
  }

  .about-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 10px;
    box-sizing: border-box;
    border-radius: 6px;
    font-family: var(--font-tech);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--text-secondary);
    background: rgba(11, 15, 23, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), inset 0 1px 0 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
    white-space: nowrap;
  }

  .about-btn:hover {
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(18, 24, 38, 0.92);
  }

  .about-btn:active {
    transform: translateY(1px);
  }

  .coord-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    box-sizing: border-box;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1;
    background: rgba(11, 15, 23, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 24px -2px rgba(0, 0, 0, 0.65), inset 0 1px 0 0 rgba(255, 255, 255, 0.06);
    pointer-events: auto;
    overflow: visible;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .coord-icon {
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .coord-text {
    color: var(--text-primary);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1;
  }

  .district-text {
    color: rgba(148, 163, 184, 0.7);
    font-family: var(--font-tech);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  .prime-badge {
    color: #fbbf24;
    font-family: var(--font-tech);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 2px 5px;
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-radius: 4px;
    background: rgba(120, 53, 15, 0.3);
    line-height: 1;
  }

  .coord-badge {
    font-family: var(--font-tech);
    font-size: 0.66rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
  }

  .coord-badge.empty {
    background: rgba(245, 158, 11, 0.12);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .coord-badge.occupied {
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent-jade);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .verified-badge-mini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    overflow: visible;
  }

  .verified-badge-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 1px 3px rgba(56, 189, 248, 0.4));
  }

  .hud-bottom-right {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 20px));
    right: max(16px, calc(env(safe-area-inset-right, 0px) + 16px));
    z-index: 35;
    pointer-events: auto;
  }

  .nav-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: 8px;
    padding: 3px;
    gap: 1px;
    background: rgba(11, 15, 23, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 24px -2px rgba(0, 0, 0, 0.65), inset 0 1px 0 0 rgba(255, 255, 255, 0.06);
  }

  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--text-secondary);
    border-radius: 5px;
    transition: all 0.12s ease;
    cursor: pointer;
  }

  .nav-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-btn:active {
    transform: translateY(1px);
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-divider {
    width: 18px;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-btn:active {
    transform: scale(0.94);
  }

  .nav-divider {
    width: 20px;
    height: 1px;
    background: var(--border-subtle);
  }

  @media (max-width: 640px) {
    .hud-bottom-left {
      bottom: max(18px, calc(env(safe-area-inset-bottom, 0px) + 16px));
      left: max(12px, calc(env(safe-area-inset-left, 0px) + 12px));
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      /* Reserve room for the right-side nav controls (~60px wide + 12px margin) */
      max-width: calc(100vw - 88px);
    }

    .hud-actions {
      flex-direction: row;
      align-items: center;
    }

    .coord-pill {
      padding: 6px 10px;
      font-size: 0.76rem;
      gap: 5px;
      overflow: hidden;
      max-width: 100%;
    }

    /* Hide decorative elements that expand the pill width on mobile */
    .coord-icon {
      display: none;
    }

    .district-text {
      display: none;
    }

    /* Shrink the creator badge — hide the "made by" label, keep the name */
    .creator-badge__label {
      display: none;
    }

    .support-btn,
    .about-btn {
      min-height: 44px;
      padding: 8px 12px;
      font-size: 0.74rem;
    }

    .hud-bottom-right {
      bottom: max(18px, calc(env(safe-area-inset-bottom, 0px) + 16px));
      right: max(12px, calc(env(safe-area-inset-right, 0px) + 12px));
    }

    .nav-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 380px) {
    .coord-badge {
      display: none;
    }

    .prime-badge {
      display: none !important;
    }

    /* Also hide creator name on very narrow screens, keep only the icon */
    .creator-badge__name {
      display: none;
    }

    .creator-badge__text {
      display: none;
    }
  }
</style>
