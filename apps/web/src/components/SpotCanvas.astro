---
---

<div class="canvas-container" id="canvas-container">
  <canvas id="spot-canvas" class="spot-canvas"></canvas>

  <div class="world-loader" id="world-loader" role="status" aria-live="polite">
    <span class="world-loader-mark" aria-hidden="true"></span>
    <span>Mapping the city…</span>
  </div>

  <!-- Bottom-Left Hover/Coordinate Pill & Support Button -->
  <div class="hud-bottom-left" id="hud-bottom-left">
    <div class="coord-pill glass-panel" id="coord-pill">
      <span class="coord-icon">🎯</span>
      <span class="coord-text mono-num" id="coord-text">Spot: (52, 60)</span>
      <span class="coord-badge empty" id="coord-status">Available</span>
      <span class="district-text" id="coord-district">Sector 5-5</span>
      <span class="prime-badge" id="coord-prime" style="display: none;">PRIME</span>
      <span class="verified-badge-mini" id="coord-verified-badge" style="display: none;" title="Verified GitHub Citizen">
        <svg class="verified-badge-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="9.5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.5"/>
          <path d="M7.7 12.2l2.8 2.8 5.9-5.9" stroke="#07111f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>

    <button type="button" class="support-btn glass-panel" id="btn-open-support" title="Support creator & development of Spot">
      <svg class="coffee-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
        <line x1="6" y1="1" x2="6" y2="4"></line>
        <line x1="10" y1="1" x2="10" y2="4"></line>
        <line x1="14" y1="1" x2="14" y2="4"></line>
      </svg>
      <span>Support</span>
    </button>
  </div>

  <!-- Bottom-Right Navigation HUD Controls -->
  <div class="hud-bottom-right" id="hud-bottom-right">
    <div class="nav-controls glass-panel">
      <button class="nav-btn" id="btn-zoom-in" title="Zoom in (+)" aria-label="Zoom in">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="nav-divider"></div>

      <button class="nav-btn" id="btn-zoom-out" title="Zoom out (-)" aria-label="Zoom out">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="nav-divider"></div>

      <button class="nav-btn" id="btn-recenter" title="Recenter world" aria-label="Recenter world">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="22" y1="12" x2="18" y2="12"></line>
          <line x1="6" y1="12" x2="2" y2="12"></line>
          <line x1="12" y1="6" x2="12" y2="2"></line>
          <line x1="12" y1="22" x2="12" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    touch-action: none;
  }

  .spot-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }

  .world-loader {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: var(--radius-full);
    background: rgba(13, 17, 28, 0.94);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }

  .world-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .world-loader-mark {
    width: 13px;
    height: 13px;
    border: 2px solid rgba(16, 185, 129, 0.28);
    border-top-color: #10b981;
    border-radius: 50%;
    animation: world-loader-spin 0.8s linear infinite;
  }

  @keyframes world-loader-spin {
    to { transform: rotate(360deg); }
  }

  .hud-bottom-left {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 20px));
    left: max(16px, calc(env(safe-area-inset-left, 0px) + 16px));
    z-index: 35;
    /* Keep the whole control cluster in the touch hit-testing layer. Some
       mobile browsers do not reliably retarget taps through a pointer-events
       none parent to an interactive child. */
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .support-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    pointer-events: auto;
    transition: all 0.2s var(--ease-out-expo);
    border: 1px solid var(--border-subtle);
  }

  .support-btn:hover {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    transform: translateY(-1px);
  }

  .coffee-icon {
    color: #f59e0b;
  }

  .coord-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 14px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    pointer-events: auto;
    overflow: visible;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .coord-icon {
    font-size: 0.9rem;
  }

  .coord-text {
    color: var(--text-primary);
  }

  .district-text {
    color: rgba(148, 163, 184, 0.8);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .prime-badge {
    color: #fbbf24;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 3px 6px;
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: var(--radius-sm);
    background: rgba(120, 53, 15, 0.35);
  }

  .coord-badge {
    font-size: 0.72rem; /* 11.5px */
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .coord-badge.empty {
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .coord-badge.occupied {
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent-jade);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .verified-badge-mini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    overflow: visible;
    margin-right: -1px;
  }

  .verified-badge-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 2px 4px rgba(56, 189, 248, 0.4));
  }

  .hud-bottom-right {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 20px));
    right: max(16px, calc(env(safe-area-inset-right, 0px) + 16px));
    z-index: 35;
    pointer-events: auto;
  }

  .nav-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: var(--radius-md);
    padding: 4px;
    gap: 2px;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .nav-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-btn:active {
    transform: scale(0.94);
  }

  .nav-divider {
    width: 20px;
    height: 1px;
    background: var(--border-subtle);
  }

  @media (max-width: 640px) {
    .hud-bottom-left {
      bottom: max(18px, calc(env(safe-area-inset-bottom, 0px) + 16px));
      left: max(12px, calc(env(safe-area-inset-left, 0px) + 12px));
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      max-width: calc(100vw - 80px);
    }

    .coord-pill {
      padding: 6px 12px 6px 10px;
      font-size: 0.76rem;
      gap: 6px;
      overflow: visible;
    }

    .support-btn {
      min-height: 44px;
      padding: 8px 12px;
      font-size: 0.74rem;
    }

    .hud-bottom-right {
      bottom: max(18px, calc(env(safe-area-inset-bottom, 0px) + 16px));
      right: max(12px, calc(env(safe-area-inset-right, 0px) + 12px));
    }

    .nav-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 380px) {
    .coord-badge {
      display: none;
    }

    .district-text {
      display: none;
    }

    .prime-badge {
      display: none !important;
    }
  }
</style>
