---
---

<div class="canvas-container" id="canvas-container">
  <canvas id="spot-canvas" class="spot-canvas"></canvas>

  <!-- Bottom-Left Hover/Coordinate Pill & Support Button -->
  <div class="hud-bottom-left" id="hud-bottom-left">
    <div class="coord-pill glass-panel" id="coord-pill">
      <span class="coord-icon">🎯</span>
      <span class="coord-text mono-num" id="coord-text">Spot: (52, 60)</span>
      <span class="coord-badge empty" id="coord-status">Available</span>
      <span class="verified-badge-mini" id="coord-verified-badge" style="display: none;" title="Verified GitHub Citizen">
        <svg class="verified-badge-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.8l1.3 1.8 2.2-.2.9 2 2.1.7.3 2.2 1.8 1.3-.4 2.2 1.3 1.8-1.3 1.8.4 2.2-1.8 1.3-.3 2.2-2.1.7-.9 2-2.2-.2L12 23.2l-1.3-1.8-2.2.2-.9-2-2.1-.7-.3-2.2-1.8-1.3.4-2.2L2.5 13.6l1.3-1.8-.4-2.2 1.8-1.3.3-2.2 2.1-.7.9-2 2.2.2L12 2.8z" fill="#090d16"/>
          <path d="M12 1.6l1.3 1.8 2.2-.2.9 2 2.1.7.3 2.2 1.8 1.3-.4 2.2 1.3 1.8-1.3 1.8.4 2.2-1.8 1.3-.3 2.2-2.1.7-.9 2-2.2-.2L12 22l-1.3-1.8-2.2.2-.9-2-2.1-.7-.3-2.2-1.8-1.3.4-2.2L2.5 12.4l1.3-1.8-.4-2.2 1.8-1.3.3-2.2 2.1-.7.9-2 2.2.2L12 1.6z" fill="url(#scallopGradMini)" stroke="#ffffff" stroke-width="1.3" stroke-linejoin="round"/>
          <path d="M7.8 12.6l3.1 3.1 6.1-6.1" stroke="#090d16" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
          <path d="M7.5 12l3.1 3.1 6.1-6.1" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <defs>
            <linearGradient id="scallopGradMini" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
              <stop stop-color="#38bdf8"/>
              <stop offset="0.55" stop-color="#6366f1"/>
              <stop offset="1" stop-color="#a855f7"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
    </div>

    <button type="button" class="support-btn glass-panel" id="btn-open-support" title="Support creator & development of Spot">
      <svg class="coffee-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
        <line x1="6" y1="1" x2="6" y2="4"></line>
        <line x1="10" y1="1" x2="10" y2="4"></line>
        <line x1="14" y1="1" x2="14" y2="4"></line>
      </svg>
      <span>Support</span>
    </button>
  </div>

  <!-- Bottom-Right Navigation HUD Controls -->
  <div class="hud-bottom-right" id="hud-bottom-right">
    <div class="nav-controls glass-panel">
      <button class="nav-btn" id="btn-zoom-in" title="Zoom in (+)" aria-label="Zoom in">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="nav-divider"></div>

      <button class="nav-btn" id="btn-zoom-out" title="Zoom out (-)" aria-label="Zoom out">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="nav-divider"></div>

      <button class="nav-btn" id="btn-recenter" title="Recenter world" aria-label="Recenter world">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="22" y1="12" x2="18" y2="12"></line>
          <line x1="6" y1="12" x2="2" y2="12"></line>
          <line x1="12" y1="6" x2="12" y2="2"></line>
          <line x1="12" y1="22" x2="12" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    touch-action: none;
  }

  .spot-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }

  .hud-bottom-left {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 20px));
    left: max(16px, calc(env(safe-area-inset-left, 0px) + 16px));
    z-index: 30;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .support-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    pointer-events: auto;
    transition: all 0.2s var(--ease-out-expo);
    border: 1px solid var(--border-subtle);
  }

  .support-btn:hover {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    transform: translateY(-1px);
  }

  .coffee-icon {
    color: #f59e0b;
  }

  .coord-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 14px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    pointer-events: auto;
    overflow: visible;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .coord-icon {
    font-size: 0.9rem;
  }

  .coord-text {
    color: var(--text-primary);
  }

  .coord-badge {
    font-size: 0.72rem; /* 11.5px */
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .coord-badge.empty {
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .coord-badge.occupied {
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent-jade);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .verified-badge-mini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    overflow: visible;
    margin-right: -1px;
  }

  .verified-badge-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 2px 4px rgba(56, 189, 248, 0.4));
  }

  .hud-bottom-right {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 20px));
    right: max(16px, calc(env(safe-area-inset-right, 0px) + 16px));
    z-index: 30;
    pointer-events: auto;
  }

  .nav-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: var(--radius-md);
    padding: 4px;
    gap: 2px;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .nav-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-btn:active {
    transform: scale(0.94);
  }

  .nav-divider {
    width: 20px;
    height: 1px;
    background: var(--border-subtle);
  }

  @media (max-width: 640px) {
    .hud-bottom-left {
      bottom: max(18px, calc(env(safe-area-inset-bottom, 0px) + 16px));
      left: max(12px, calc(env(safe-area-inset-left, 0px) + 12px));
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      max-width: calc(100vw - 80px);
    }

    .coord-pill {
      padding: 6px 12px 6px 10px;
      font-size: 0.76rem;
      gap: 6px;
      overflow: visible;
    }

    .support-btn {
      padding: 5px 9px;
      font-size: 0.74rem;
    }

    .hud-bottom-right {
      bottom: max(18px, calc(env(safe-area-inset-bottom, 0px) + 16px));
      right: max(12px, calc(env(safe-area-inset-right, 0px) + 12px));
    }
  }

  @media (max-width: 380px) {
    .coord-badge {
      display: none;
    }
  }
</style>
