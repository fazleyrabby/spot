---
/**
 * MarinaPortalModal — Fullscreen portal to the Apex Marina speedboat game
 * (https://apex-marina.vercel.app/).
 *
 * Mirrors VillagePortalModal: immersive iframe viewer with glassmorphism
 * chrome, 'Open in New Tab ↗' quick link, Fullscreen toggle, and
 * audio/resource pausing upon close.
 */
---

<div
  class="marina-portal-backdrop"
  id="marina-portal-backdrop"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Apex Marina Speedboat World Portal"
>
  <div class="marina-portal-stage">
    <iframe
      id="marina-portal-iframe"
      class="marina-portal-iframe"
      src="about:blank"
      loading="eager"
      allow="autoplay; fullscreen; accelerometer; gyroscope; gamepad"
      referrerpolicy="no-referrer"
      title="Apex Marina — Top-Down Speedboat Racing & Exploration"
    ></iframe>

    <!-- Top floating chrome -->
    <div class="marina-portal-chrome">
      <div class="marina-portal-badge">
        <span class="marina-emblem">🚤</span>
        <div class="marina-title-group">
          <div class="marina-title-main">
            <span class="marina-name">APEX MARINA</span>
            <span class="marina-tag">SPEEDBOAT RACING & EXPLORATION</span>
          </div>
          <p class="marina-subtitle">Race Sunset Bay or sail free across a living archipelago</p>
        </div>
      </div>

      <div class="marina-portal-actions">
        <a
          href="https://apex-marina.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="marina-action-btn open-tab-btn"
          title="Open standalone game in a new browser tab"
        >
          <span>Open in New Tab</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>

        <button
          type="button"
          class="marina-action-btn fullscreen-btn"
          id="marina-fullscreen-btn"
          title="Toggle Fullscreen"
          aria-label="Toggle Fullscreen"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>

        <button
          type="button"
          class="marina-action-btn close-btn"
          id="marina-portal-close"
          aria-label="Return to Spot World"
          title="Return to Spot World (ESC)"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span class="close-label">Return to City</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .marina-portal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: #040810;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.32s ease;
  }

  .marina-portal-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .marina-portal-stage {
    position: relative;
    width: 100%;
    height: 100%;
    background: #020408;
    overflow: hidden;
  }

  .marina-portal-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #020408;
  }

  .marina-portal-chrome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(2, 6, 14, 0.88) 0%,
      rgba(2, 6, 14, 0.6) 45%,
      transparent 100%
    );
    z-index: 10;
  }

  .marina-portal-badge {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(10, 15, 26, 0.72);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 12px;
    padding: 8px 16px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.15);
  }

  .marina-emblem {
    font-size: 1.4rem;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgba(56, 189, 248, 0.4));
  }

  .marina-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .marina-title-main {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.2;
  }

  .marina-name {
    font-family: 'Cinzel', 'Chakra Petch', ui-monospace, sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #f8fafc;
  }

  .marina-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 1px 6px;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.4);
    text-transform: uppercase;
  }

  .marina-subtitle {
    margin: 0;
    font-size: 0.72rem;
    color: #94a3b8;
    letter-spacing: 0.02em;
  }

  .marina-portal-actions {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .marina-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.18s ease;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    user-select: none;
  }

  .open-tab-btn {
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(15, 23, 42, 0.75);
    color: #e2e8f0;
  }

  .open-tab-btn:hover {
    background: rgba(30, 41, 59, 0.95);
    border-color: rgba(56, 189, 248, 0.4);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .fullscreen-btn {
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(15, 23, 42, 0.75);
    color: #e2e8f0;
    padding: 8px 10px;
  }

  .fullscreen-btn:hover {
    background: rgba(30, 41, 59, 0.95);
    color: #fff;
    transform: translateY(-1px);
  }

  .close-btn {
    border: 1px solid rgba(56, 189, 248, 0.45);
    background: rgba(2, 132, 199, 0.82);
    color: #fff;
    box-shadow: 0 4px 16px rgba(2, 132, 199, 0.3);
  }

  .close-btn:hover {
    background: rgba(56, 189, 248, 0.95);
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 6px 20px rgba(56, 189, 248, 0.45);
  }

  @media (max-width: 640px) {
    .marina-portal-chrome {
      padding: 10px 12px;
    }
    .marina-subtitle,
    .marina-tag,
    .close-label {
      display: none;
    }
    .marina-action-btn {
      padding: 7px 10px;
    }
  }
</style>

<script>
  const backdrop = document.getElementById('marina-portal-backdrop') as HTMLDivElement | null;
  const iframe = document.getElementById('marina-portal-iframe') as HTMLIFrameElement | null;
  const fsBtn = document.getElementById('marina-fullscreen-btn') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('marina-portal-close') as HTMLButtonElement | null;

  const openTabBtn = document.querySelector('.marina-portal-actions .open-tab-btn');

  const MARINA_URL = 'https://apex-marina.vercel.app/';

  function trackClick(source = '2d') {
    try {
      const payload = JSON.stringify({
        targetType: 'monument',
        targetId: 'apex_marina',
        source,
      });
      const blob = new Blob([payload], { type: 'application/json' });
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/analytics/click', blob);
      } else {
        fetch('/api/analytics/click', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true,
        }).catch(() => {});
      }
    } catch (_) {}
  }

  function openMarinaModal(source = '2d') {
    if (!backdrop || !iframe) return;
    trackClick(source);
    if (iframe.src !== MARINA_URL) {
      iframe.src = MARINA_URL;
    }
    backdrop.classList.add('open');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    iframe.focus();
  }

  function closeMarinaModal() {
    if (!backdrop || !iframe) return;
    backdrop.classList.remove('open');
    backdrop.setAttribute('aria-hidden', 'true');
    // Unload iframe to stop audio and rAF cycles in background
    iframe.src = 'about:blank';
    document.body.style.overflow = '';
  }

  function toggleFullscreen() {
    if (!backdrop) return;
    if (!document.fullscreenElement) {
      backdrop.requestFullscreen?.().catch(() => {});
    } else {
      document.exitFullscreen?.().catch(() => {});
    }
  }

  closeBtn?.addEventListener('click', closeMarinaModal);
  fsBtn?.addEventListener('click', toggleFullscreen);
  openTabBtn?.addEventListener('click', () => trackClick('new_tab'));

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && backdrop?.classList.contains('open')) {
      closeMarinaModal();
    }
  });

  (window as any).openMarinaModal = openMarinaModal;
  (window as any).closeMarinaModal = closeMarinaModal;
  (window as any).loadMarinaWorld = openMarinaModal;
</script>
