# Web app env (Astro/Vite reads this from apps/web/.env)

# Where writes go (the authoritative API):
#   Local dev (server on :5050)   -> http://localhost:5050
#   Vercel (same-domain function) -> /api   <-- use this in production
PUBLIC_API_BASE=http://localhost:5050

