{
  "framework": "astro",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "routes": [
    { "src": "^/assets/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/_astro/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/(.*)\\.html$", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "src": "^/$", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "src": "^/world/?$", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "^/api/(.*)$", "dest": "/api/[...path]?...path=$1", "check": true },
    { "handle": "error" },
    { "status": 404, "src": "^(?!/api).*$", "dest": "/404.html" },
    { "handle": "miss" }
  ]
}
