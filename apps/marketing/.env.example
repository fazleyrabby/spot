# ── Spot Marketing Worker ─────────────────────────────────────────────
# Bluesky (free): create an App Password at bsky.app → Settings → Privacy and Security → App Passwords
BSKY_HANDLE=you.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BSKY_SERVICE_URL=https://bsky.social

# Twitter/X (PAID developer plan required; leave blank to disable)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Database (same Postgres as the app)
DATABASE_URL=postgresql://spot_user:password@localhost:55432/spot_db

# Behaviour
MARKETING_APP_URL=https://claimyourspot.lol
MARKETING_INTERVAL_MINUTES=1440
MARKETING_ALWAYS_POST=false
MARKETING_MAX_CLAIMS=5
