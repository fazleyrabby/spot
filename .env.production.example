# ==============================================================================
# SPOT Production Environment Configuration (Homelab VPS)
# Copy to .env.production on the server: cp .env.production.example .env.production
# ==============================================================================

DOMAIN_NAME="claimyourspot.lol"
CORS_ORIGIN="https://claimyourspot.lol"

# WebAuthn / Passkeys Configuration
RP_ID="claimyourspot.lol"
RP_ORIGIN="https://claimyourspot.lol"

# Local PostgreSQL in Docker
POSTGRES_DB="spot_db"
POSTGRES_USER="spot_user"
POSTGRES_PASSWORD="generate-a-strong-random-password-here"

# Security Secrets
COOKIE_SECRET="generate-a-random-32-char-string-for-session-cookies"

# Discord Webhook Notification for Claims (Optional)
DISCORD_WEBHOOK_URL=""
