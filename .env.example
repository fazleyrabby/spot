# SPOT Environment Configuration

# Runtime environment: local uses Docker PostgreSQL; production requires the
# production DATABASE_URL supplied by the hosting provider.
APP_ENV="local"

# Database Connection (Supabase or Local Postgres)
# Local Docker Compose database:
DATABASE_URL="postgresql://spot_user:spot_secret_password@localhost:55432/spot_db"
# Production example (set this in the deployment environment, not in Git):
# APP_ENV="production"
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# Supabase API (From Project Settings -> API)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server Settings
PORT=4323
NODE_ENV=development
COOKIE_SECRET="super-secret-random-key-at-least-32-chars-long"
CORS_ORIGIN="http://localhost:4322"

# Discord webhook for spot-claim notifications (optional)
DISCORD_WEBHOOK_URL=""
