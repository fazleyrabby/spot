# SPOT Environment Configuration

# Database Connection (Supabase or Local Postgres)
# In Supabase: Project Settings -> Database -> Connection string -> URI (Transaction mode 6543 or Session mode 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spot_db"

# Supabase API (From Project Settings -> API)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server Settings
PORT=4323
NODE_ENV=development
COOKIE_SECRET="super-secret-random-key-at-least-32-chars-long"
CORS_ORIGIN="http://localhost:4322"
